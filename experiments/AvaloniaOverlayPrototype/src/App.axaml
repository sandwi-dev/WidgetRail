<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameBarAlternative.AvaloniaPrototype.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="#E8324154" />
      <Setter Property="BorderBrush" Value="#668FB2DB" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F1415570" />
    </Style>
    <Style Selector="Button:focus /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#FFD7EBFF" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.selected">
      <Setter Property="Background" Value="#F14A6689" />
      <Setter Property="BorderBrush" Value="#FFD7EBFF" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Button.prototype-action">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Margin" Value="0,0,10,10" />
    </Style>
    <Style Selector="Button.tray-button">
      <Setter Property="Width" Value="132" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style Selector="TextBlock.controller-help">
      <Setter Property="Foreground" Value="#D7DFEA" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="MinWidth" Value="180" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="MinHeight" Value="8" />
    </Style>
    <Style Selector="ListBox#ApplicationList ListBoxItem">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="4" />
    </Style>
  </Application.Styles>
</Application>
