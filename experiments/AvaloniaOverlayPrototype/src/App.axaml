<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameBarAlternative.AvaloniaPrototype.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#EB172230" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F1263548" />
    <SolidColorBrush x:Key="SurfaceInteractiveBrush" Color="#EE31435A" />
    <SolidColorBrush x:Key="SurfaceInteractiveHoverBrush" Color="#F5415875" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#F14A6689" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#E8233245" />
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="#F02E435C" />
    <SolidColorBrush x:Key="BorderBrush" Color="#708FB2DB" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#A19FC3ED" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FFD7EBFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF4F8FC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB9C7D8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7BB8F4" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource SurfaceInteractiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceInteractiveHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
    <Style Selector="Button:focus /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Opacity" Value="0.86" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
    </Style>
    <Style Selector="Button.semantic-button">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="Button.tray-button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.semantic-action-surface">
      <Setter Property="MinHeight" Value="60" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.semantic-action-surface:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
    </Style>
    <Style Selector="Button.setting-row">
      <Setter Property="MinHeight" Value="58" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.primary-button, Button.primary-action">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.secondary-button, Button.secondary-action">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
    <Style Selector="Button.danger-button">
      <Setter Property="Background" Value="#B65E2935" />
      <Setter Property="BorderBrush" Value="#FFD98A96" />
    </Style>
    <Style Selector="Button.transport-action">
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.semantic-text">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style Selector="TextBlock.page-heading">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="32" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.section-heading">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="24" />
      <Setter Property="Margin" Value="0,8,0,2" />
    </Style>
    <Style Selector="TextBlock.page-help, TextBlock.diagnostic-line, TextBlock.loading-detail">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style Selector="TextBlock.loading-detail">
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="MaxWidth" Value="620" />
    </Style>
    <Style Selector="TextBlock.gbar-section-header__title">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.gbar-section-header__description">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.gbar-tile__title">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.gbar-tile__subtitle, TextBlock.gbar-tile__metadata, TextBlock.gbar-settings-row__description">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="MinWidth" Value="160" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="MinHeight" Value="8" />
    </Style>
    <Style Selector="ProgressBar.semantic-loading">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12" />
    </Style>
    <Style Selector="StackPanel.is-loading, StackPanel.is-empty">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MaxWidth" Value="680" />
      <Setter Property="MinWidth" Value="320" />
    </Style>
    <Style Selector="Image.semantic-image">
      <Setter Property="MaxHeight" Value="320" />
    </Style>
    <Style Selector="Border.shell-page-host">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
  </Application.Styles>
</Application>
