<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameBarAlternative.AvaloniaPrototype.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#EB172230" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F1263548" />
    <SolidColorBrush x:Key="SurfaceInteractiveBrush" Color="#EE31435A" />
    <SolidColorBrush x:Key="SurfaceInteractiveHoverBrush" Color="#F5415875" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#F14A6689" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#E8233245" />
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="#F02E435C" />
    <SolidColorBrush x:Key="BorderBrush" Color="#708FB2DB" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#A19FC3ED" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FFD7EBFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF4F8FC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB9C7D8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7BB8F4" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#FF9ED0FF" />
    <SolidColorBrush x:Key="StatusSurfaceBrush" Color="#E91E2E41" />
    <ControlTheme x:Key="ControllerTileTheme"
                  TargetType="Button"
                  BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="Padding" Value="16,11" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{DynamicResource SurfaceInteractiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </ControlTheme>
    <ControlTheme x:Key="ControllerCardTheme"
                  TargetType="Button"
                  BasedOn="{StaticResource ControllerTileTheme}">
      <Setter Property="MinHeight" Value="68" />
      <Setter Property="Padding" Value="18,14" />
      <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </ControlTheme>
    <ControlTheme x:Key="ControllerTextEntryTheme"
                  TargetType="Button"
                  BasedOn="{StaticResource ControllerTileTheme}">
      <Setter Property="MinHeight" Value="50" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    </ControlTheme>
    <ControlTheme x:Key="ControllerTrayButtonTheme"
                  TargetType="Button"
                  BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="56" />
      <Setter Property="MinWidth" Value="118" />
      <Setter Property="MaxWidth" Value="190" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource SurfaceInteractiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </ControlTheme>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource SurfaceInteractiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceInteractiveHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>
    <Style Selector="Button:focus /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Opacity" Value="0.86" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
    </Style>
    <Style Selector="Button.semantic-button">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="Button.tray-button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.semantic-action-surface">
      <Setter Property="MinHeight" Value="60" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.semantic-action-surface:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
    </Style>
    <Style Selector="TextBlock.semantic-text">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="TextBlock.component-bodytext">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="LineHeight" Value="23" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="TextBlock.shell-eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>
    <Style Selector="TextBlock.shell-widget-title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="26" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.component-section">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.component-advancedslotsurface">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.component-status">
      <Setter Property="MinHeight" Value="72" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource StatusSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.component-actionrow">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.component-collection">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="MinWidth" Value="160" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="MinHeight" Value="8" />
    </Style>
    <Style Selector="ProgressBar.semantic-loading">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12" />
    </Style>
    <Style Selector="Image.semantic-image">
      <Setter Property="MaxHeight" Value="320" />
    </Style>
    <Style Selector="Border.shell-page-host">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
  </Application.Styles>
</Application>
