<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameBarAlternative.AvaloniaPrototype.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    </Style>
    <Style Selector="Button.prototype-action">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Margin" Value="0,0,10,10" />
    </Style>
    <Style Selector="Button.tray-button">
      <Setter Property="Width" Value="132" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style Selector="TextBlock.controller-help">
      <Setter Property="Foreground" Value="#D7DFEA" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="MinWidth" Value="180" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="ListBox#ApplicationList ListBoxItem">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="4" />
    </Style>
  </Application.Styles>
</Application>
