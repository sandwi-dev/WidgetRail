<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameBarAlternative.AvaloniaPrototype.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#EB172230" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F1263548" />
    <SolidColorBrush x:Key="SurfaceInteractiveBrush" Color="#EE31435A" />
    <SolidColorBrush x:Key="SurfaceInteractiveHoverBrush" Color="#F5415875" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#F14A6689" />
    <SolidColorBrush x:Key="BorderBrush" Color="#708FB2DB" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FFD7EBFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF4F8FC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB9C7D8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7BB8F4" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource SurfaceInteractiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceInteractiveHoverBrush}" />
    </Style>
    <Style Selector="Button:focus /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Button.semantic-button">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="Button.tray-button">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.semantic-action-surface">
      <Setter Property="MinHeight" Value="58" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.semantic-text">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style Selector="TextBlock.gbar-section-header__title">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.gbar-section-header__description">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.gbar-tile__title">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.gbar-tile__subtitle, TextBlock.gbar-tile__metadata, TextBlock.gbar-settings-row__description">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="MinWidth" Value="160" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="MinHeight" Value="8" />
    </Style>
    <Style Selector="Image.semantic-image">
      <Setter Property="MaxHeight" Value="320" />
    </Style>
    <Style Selector="Border.shell-page-host">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
  </Application.Styles>
</Application>
