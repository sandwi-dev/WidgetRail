<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameBarAlternative.AvaloniaPrototype.ViewModels"
             x:Class="GameBarAlternative.AvaloniaPrototype.Views.SettingsPage"
             x:DataType="vm:SettingsPageViewModel"
             XYFocus.NavigationModes="Enabled"
             AutomationProperties.AutomationId="page.settings"
             AutomationProperties.Name="Settings page">
  <Grid RowDefinitions="Auto,*,Auto">
    <TextBlock x:Name="PageTitle"
               Grid.Row="0"
               Classes="page-title"
               Text="{Binding State.Title}"
               AutomationProperties.AutomationId="settings.title"
               AutomationProperties.Name="Settings" />
    <ScrollViewer x:Name="SettingsScroll"
                  Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="settings.scroll"
                  AutomationProperties.Name="Settings options">
      <StackPanel Spacing="14">
        <TextBlock Text="Overlay appearance and behavior"
                   FontSize="19"
                   FontWeight="SemiBold"
                   AutomationProperties.AutomationId="settings.section.overlay"
                   AutomationProperties.Name="Overlay appearance and behavior" />
        <TextBlock MaxWidth="760"
                   HorizontalAlignment="Left"
                   TextWrapping="Wrap"
                   Text="{Binding State.Description}"
                   AutomationProperties.AutomationId="settings.description"
                   AutomationProperties.Name="Long responsive settings description" />
        <WrapPanel>
          <Button x:Name="PrimaryAction" Classes="prototype-action"
                  Content="Keep overlay above games"
                  Command="{Binding ToggleTopmostCommand}"
                  AutomationProperties.AutomationId="settings.topmost"
                  AutomationProperties.Name="Keep overlay above games" />
          <Button Classes="prototype-action"
                  Content="Start with last widget"
                  Command="{Binding ToggleStartWithLastCommand}"
                  AutomationProperties.AutomationId="settings.start-last"
                  AutomationProperties.Name="Start with last widget" />
          <Button Classes="prototype-action"
                  Content="Reduce motion"
                  Command="{Binding ToggleReduceMotionCommand}"
                  AutomationProperties.AutomationId="settings.reduce-motion"
                  AutomationProperties.Name="Reduce motion" />
        </WrapPanel>
        <TextBlock Text="Interface scale" AutomationProperties.AutomationId="settings.scale.label" AutomationProperties.Name="Interface scale" />
        <Slider x:Name="InterfaceScaleSlider"
                Minimum="100"
                Maximum="150"
                Value="{Binding InterfaceScale, Mode=TwoWay}"
                TickFrequency="25"
                AutomationProperties.AutomationId="settings.scale"
                AutomationProperties.Name="Interface scale percentage" />
        <TextBlock Text="Accessibility" FontSize="19" FontWeight="SemiBold"
                   AutomationProperties.AutomationId="settings.accessibility.label"
                   AutomationProperties.Name="Accessibility" />
        <WrapPanel>
          <Button Classes="prototype-action"
                  Content="High contrast focus"
                  AutomationProperties.AutomationId="settings.high-contrast"
                  AutomationProperties.Name="High contrast focus" />
          <Button Classes="prototype-action"
                  Content="Read controller hints"
                  AutomationProperties.AutomationId="settings.read-hints"
                  AutomationProperties.Name="Read controller hints" />
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
    <TextBlock x:Name="ControllerHelp"
               Grid.Row="2"
               Classes="controller-help"
               Text="Arrows / D-pad  Navigate    Enter / A  Select    Escape / B  Back"
               AutomationProperties.AutomationId="settings.help"
               AutomationProperties.Name="Settings controller help" />
  </Grid>
</UserControl>
