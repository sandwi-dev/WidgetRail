<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:integration="using:GameBarAlternative.AvaloniaPrototype.Integration"
             x:Class="GameBarAlternative.AvaloniaPrototype.Views.IntegratedStatusView"
             x:DataType="integration:IntegratedShellViewModel">
  <TextBlock Text="{Binding StatusText}"
             TextWrapping="Wrap"
             MaxWidth="520"
             AutomationProperties.AutomationId="avp.integrated.status.text"
             AutomationProperties.Name="Widget presentation status" />
</UserControl>
