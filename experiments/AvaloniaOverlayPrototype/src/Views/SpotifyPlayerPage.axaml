<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameBarAlternative.AvaloniaPrototype.ViewModels"
             x:Class="GameBarAlternative.AvaloniaPrototype.Views.SpotifyPlayerPage"
             x:DataType="vm:SpotifyPlayerPageViewModel"
             XYFocus.NavigationModes="Enabled"
             AutomationProperties.AutomationId="page.spotify"
             AutomationProperties.Name="Spotify Player page">
  <Grid RowDefinitions="Auto,*,Auto">
    <TextBlock x:Name="PageTitle"
               Grid.Row="0"
               Classes="page-title"
               Text="{Binding State.Title}"
               AutomationProperties.AutomationId="spotify.title"
               AutomationProperties.Name="Spotify Player" />
    <ScrollViewer x:Name="PrimaryContent" Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="spotify.scroll"
                  AutomationProperties.Name="Spotify player content">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
        <Border Grid.Column="0"
                Width="170"
                Height="170"
                CornerRadius="12"
                Background="#34465C"
                BorderBrush="#7898BCE9"
                BorderThickness="1"
                AutomationProperties.AutomationId="spotify.artwork.missing"
                AutomationProperties.Name="Artwork unavailable">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock HorizontalAlignment="Center" FontSize="34" Text="♪"
                       AutomationProperties.AutomationId="spotify.artwork.icon" AutomationProperties.Name="Music note placeholder" />
            <TextBlock HorizontalAlignment="Center" Text="Artwork unavailable" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="spotify.artwork.label" AutomationProperties.Name="Artwork unavailable" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" Spacing="10">
          <TextBlock FontSize="22"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Text="{Binding State.Track}"
                     AutomationProperties.AutomationId="spotify.track"
                     AutomationProperties.Name="Current track title" />
          <TextBlock Text="{Binding State.Artist}" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="spotify.artist" AutomationProperties.Name="Current artist and album" />
          <Slider x:Name="PlaybackPositionSlider"
                  Minimum="0"
                  Maximum="312"
                  Value="{Binding Position, Mode=TwoWay}"
                  AutomationProperties.AutomationId="spotify.position"
                  AutomationProperties.Name="Playback position seconds" />
          <WrapPanel>
            <Button Classes="prototype-action" Content="Previous"
                    AutomationProperties.AutomationId="spotify.previous" AutomationProperties.Name="Previous track" />
            <Button x:Name="PrimaryAction" Classes="prototype-action" Content="Play / Pause"
                    Command="{Binding TogglePlaybackCommand}"
                    AutomationProperties.AutomationId="spotify.play" AutomationProperties.Name="Play or pause" />
            <Button Classes="prototype-action" Content="Next"
                    AutomationProperties.AutomationId="spotify.next" AutomationProperties.Name="Next track" />
            <Button Classes="prototype-action" Content="Open queue"
                    AutomationProperties.AutomationId="spotify.queue" AutomationProperties.Name="Open queue" />
          </WrapPanel>
          <TextBlock Text="{Binding State.Readiness}"
                     TextWrapping="Wrap"
                     AutomationProperties.AutomationId="spotify.readiness"
                     AutomationProperties.Name="Spotify destination ready" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <TextBlock x:Name="ControllerHelp"
               Grid.Row="2"
               Classes="controller-help"
               Text="Arrows / D-pad  Navigate    Enter / A  Activate    Left / Right  Seek    Escape / B  Back"
               AutomationProperties.AutomationId="spotify.help"
               AutomationProperties.Name="Spotify Player controller help" />
  </Grid>
</UserControl>
