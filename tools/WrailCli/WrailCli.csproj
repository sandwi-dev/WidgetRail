<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\WidgetSdkRelease.props" />
  <PropertyGroup>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>wrail</AssemblyName>
    <Version>$(WidgetSdkReleaseVersion)</Version>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="WidgetSdkReleaseVersion" Value="$(WidgetSdkReleaseVersion)" />
    <AssemblyMetadata Include="WidgetSdkPackageId" Value="$(WidgetSdkPackageId)" />
    <AssemblyMetadata Include="ControllerWidgetTemplateVersion" Value="$(ControllerWidgetTemplateVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PlatformBroker\PlatformBroker.csproj" />
    <ProjectReference Include="..\..\src\WidgetCatalog\WidgetCatalog.csproj" />
    <ProjectReference Include="..\..\src\PlatformSettings\PlatformSettings.csproj" />
    <ProjectReference Include="..\..\src\WidgetProtocol\WidgetProtocol.csproj" />
    <ProjectReference Include="..\..\src\WidgetSdk\WidgetSdk.csproj" />
    <ProjectReference Include="..\..\src\WidgetStyling\WidgetStyling.csproj" />
    <ProjectReference Include="..\..\src\WidgetRuntime\WidgetRuntime.csproj" />
    <ProjectReference Include="..\..\src\WidgetApplicationRuntime\WidgetApplicationRuntime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Shared\WindowsPortableAppRegistrationContracts.cs"
             Link="Internal\WindowsPortableAppRegistrationContracts.cs" />
    <Compile Include="..\..\src\WindowsAppLibraryProvider\WindowsPortableAppStore.cs"
             Link="Internal\WindowsPortableAppStore.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\templates\ControllerWidget\**\*">
      <Link>templates\ControllerWidget\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="..\..\src\WidgetSdk\EmbeddedMediaAdapterRuntime.js"
                      LogicalName="WidgetRail.WrailCli.EmbeddedMediaAdapterRuntime.js" />
  </ItemGroup>
  <Target Name="RemoveRetiredControllerWidgetTemplateOutput"
          AfterTargets="CopyFilesToOutputDirectory">
    <Delete Files="$(OutDir)templates\ControllerWidget\gbar.scenarios.json.template;
                   $(OutDir)templates\ControllerWidget\styles\default.gbss" />
  </Target>
</Project>
