{
  "manifestVersion": 1,
  "id": "widgetrail.samples.discord",
  "publisher": "widgetrail.samples",
  "name": "Discord",
  "version": "0.1.3",
  "pinningSupported": true,
  "fullWidgetPinningSupported": true,
  "hostApi": { "minimum": "1.0", "maximumMajor": 1 },
  "entrypoint": {
    "runtime": "dotnet-worker",
    "assembly": "payload/Discord.dll",
    "type": "widgetrail.samples.Discord.Discord"
  },
  "presentation": { "icon": "connection", "packageIcon": { "assetId": "discord.mark", "colorMode": "originalColor" } },
  "iconAssets": { "discord.mark": { "path": "assets/icons/discord.svg" } },
  "permissions": [],
  "optionalPermissions": [],
  "residencyPolicy": { "schemaVersion": 1, "mode": "unload-after-idle", "idleSeconds": 300 },
  "resourceRequest": { "updateHz": 4 },
  "architectures": ["x64", "arm64"]
}
