{
  "manifestVersion": 1,
  "id": "widgetrail.samples.sdk-gallery",
  "publisher": "widgetrail.samples",
  "name": "SDK Gallery",
  "version": "0.1.26",
  "pinningSupported": true,
  "hostApi": {
    "minimum": "1.0",
    "maximumMajor": 1
  },
  "entrypoint": {
    "runtime": "dotnet-worker",
    "assembly": "payload/SdkGalleryWidget.dll",
    "type": "WidgetRail.Samples.SdkGalleryWidget.SdkGalleryWidget"
  },
  "presentation": {
    "icon": "settings",
    "packageIcon": {
      "assetId": "gallery.mark",
      "colorMode": "originalColor"
    }
  },
  "iconAssets": {
    "gallery.mark": {
      "path": "assets/icons/gallery-mark.svg"
    }
  },
  "permissions": [],
  "optionalPermissions": [
    "presentation.documents.v1",
    "system.apps.windows.capture.v1"
  ],
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "suspend-when-hidden"
  },
  "resourceRequest": {
    "memoryMb": 32,
    "updateHz": 2
  },
  "architectures": [
    "x64",
    "arm64"
  ],
  "fullWidgetPinningSupported": true,
  "intents": {
    "requests": [
      {
        "id": "widgetrail.web.open",
        "version": 1,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": [
            "url"
          ]
        }
      },
      {
        "id": "widgetrail.video.open",
        "version": 1,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "videoId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "startTimeSeconds": {
              "type": "number",
              "minimum": 0,
              "maximum": 604800
            }
          },
          "required": [
            "provider",
            "videoId"
          ]
        }
      },
      {
        "id": "widgetrail.video.search",
        "version": 1,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "required": [
            "provider",
            "query"
          ]
        }
      }
    ]
  }
}
