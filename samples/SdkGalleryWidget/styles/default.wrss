.gallery-root {
  width: 100vw;
  height: 100vh;
  min-width: 0px;
  min-height: 0px;
  gap: 10px;
  padding: 16px 18px;
  overflow: clip;
  background: rgba(8, 12, 18, 0.68);
  color: var(--text);
}

.gallery-header { flex-shrink: 0; }
.gallery-section-bumper-key { font-size: var(--controller-glyph-size, 24px); color: var(--controller-glyph-color, var(--text-muted)); padding: 0px; flex-shrink: 0; }
.wrail-section-header__content {
  min-width: 0px;
  gap: 8px 16px;
  align: end;
  justify: space-between;
  flex-wrap: wrap;
}
.wrail-section-header__text {
  min-width: 220px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 2px;
}
.wrail-section-header__eyebrow {
  color: var(--accent);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  max-lines: 1;
}
.wrail-section-header__title {
  min-width: 0px;
  color: var(--text);
  font-size: 23px;
  font-weight: 500;
  line-height: 1.15;
  max-lines: 2;
}
.wrail-section-header__description {
  width: 100%;
  min-width: 0px;
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.35;
  max-lines: 3;
}

.gallery-page-scroll {
  min-width: 0px;
  min-height: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  padding: 2px 5px 2px 2px;
  overflow: clip;
}
.gallery-page {
  width: 100%;
  min-width: 0px;
  flex-shrink: 0;
  gap: 10px;
}
.wrail-section-header { flex-shrink: 0; }

.wrail-responsive-grid {
  width: 100%;
  min-width: 0px;
  flex-shrink: 0;
  gap: 10px;
}
.wrail-card {
  min-width: 0px;
  gap: 8px;
  padding: 12px;
  corner-radius: 10px;
}
.wrail-card--raised { background: var(--surface-raised); }
.wrail-card--subtle { background: var(--surface-active, #242933); }
.wrail-card--transparent {
  background: transparent;
  border-color: var(--border, #343b48);
  border-width: 1px;
}

.wrail-badge {
  min-width: 0px;
  gap: 5px;
  align: center;
}
.wrail-badge__icon { width: 14px; height: 14px; flex-shrink: 0; color: var(--accent); }
.wrail-badge__label {
  min-width: 0px;
  color: var(--text-muted);
  font-size: 10px;
  font-weight: 500;
  max-lines: 1;
  text-overflow: ellipsis;
}
.wrail-badge__icon--success,
.wrail-badge__label--success { color: var(--success); }

.gallery-overview-actions { gap: 7px; align: center; flex-wrap: wrap; }
.gallery-controller-hints { gap: 8px 14px; align: center; flex-wrap: wrap; }
.wrail-controller-hint { gap: 5px; align: center; }
.wrail-controller-hint__key { font-size: var(--controller-glyph-size, 22px); color: var(--controller-glyph-color, var(--text-muted)); background: transparent; border-width: 0px; padding: 0px; }
.wrail-controller-hint__label { color: var(--text-muted); font-size: 10px; max-lines: 1; }
.wrail-icon-button {
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  padding: 10px;
  color: var(--text-muted);
  background: transparent;
  border-color: transparent;
  border-width: 1px;
  corner-radius: 21px;
}
.wrail-icon-button--small { width: 36px; height: 36px; padding: 9px; corner-radius: 18px; }
.wrail-icon-button--large { width: 50px; height: 50px; padding: 12px; corner-radius: 25px; }
.wrail-icon-button--primary { color: var(--canvas, #0b0d12); background: var(--accent); }
.wrail-icon-button--danger { color: var(--danger, #e58b8b); }
.wrail-icon-button:focused {
  color: var(--text);
  background: var(--surface-active, #242933);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.wrail-icon-button:pressed { opacity: 0.68; }

.wrail-alert,
.wrail-empty-state {
  min-width: 0px;
  flex-shrink: 0;
  gap: 8px;
  padding: 12px;
  background: var(--surface-raised);
  border-color: var(--border, #343b48);
  border-width: 1px;
  corner-radius: 10px;
}
.wrail-alert__content,
.wrail-empty-state__content { min-width: 0px; gap: 10px; align: start; }
.wrail-alert__icon,
.wrail-empty-state__icon { width: 22px; height: 22px; flex-shrink: 0; color: var(--accent); }
.wrail-alert__copy,
.wrail-empty-state__copy { min-width: 0px; flex-grow: 1; flex-shrink: 1; gap: 3px; }
.wrail-alert__title,
.wrail-empty-state__title { color: var(--text); font-size: 14px; font-weight: 500; max-lines: 2; }
.wrail-alert__message,
.wrail-empty-state__message { color: var(--text-muted); font-size: 11px; line-height: 1.35; max-lines: 4; }
.wrail-alert__action,
.wrail-empty-state__action,
.gallery-wide-action,
.gallery-utilities-toast-button {
  min-height: 40px;
  min-width: 128px;
  padding: 8px 12px;
  color: var(--text);
  background: var(--surface-active, #242933);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-size: 11px;
  font-weight: 400;
  max-lines: 2;
}
.wrail-alert__action:focused,
.wrail-empty-state__action:focused,
.gallery-wide-action:focused,
.gallery-utilities-toast-button:focused {
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.gallery-controls-openers { min-width: 0px; gap: 8px; flex-wrap: wrap; }
.gallery-wide-action { flex-grow: 1; flex-shrink: 1; }

.wrail-settings-row {
  min-width: 0px;
  flex-shrink: 0;
  gap: 7px;
  padding: 12px;
  background: var(--surface-raised);
  corner-radius: 10px;
}
.wrail-settings-row__content { min-width: 0px; gap: 9px; align: start; }
.wrail-settings-row__icon { width: 20px; height: 20px; flex-shrink: 0; color: var(--accent); }
.wrail-settings-row__copy { min-width: 0px; flex-grow: 1; flex-shrink: 1; gap: 2px; }
.wrail-settings-row__label { color: var(--text); font-size: 14px; font-weight: 500; max-lines: 2; }
.wrail-settings-row__description { color: var(--text-muted); font-size: 11px; line-height: 1.35; max-lines: 3; }
.wrail-settings-row__metadata { min-width: 0px; gap: 3px; }
.wrail-settings-row__value { color: var(--text-muted); font-size: 10px; max-lines: 2; }
.wrail-settings-row__action,
.wrail-switch {
  min-height: 40px;
  padding: 8px 12px;
  color: var(--text);
  background: var(--surface-active, #242933);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-size: 11px;
  font-weight: 400;
  max-lines: 2;
}
.wrail-settings-row__action:focused,
.wrail-switch:focused {
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.wrail-switch:selected { color: var(--success); }
.gallery-controls-scrubber-card { gap: 10px; }
.gallery-density-preview { min-width: 0px; }
.gallery-density-preview--compact { gap: 4px; padding: 6px; }
.gallery-density-preview--comfortable { gap: 12px; padding: 14px; }
.gallery-density-preview--spacious { gap: 20px; padding: 24px; }
.gallery-density-preview-row { min-width: 0px; flex-wrap: wrap; }
.gallery-density-preview-row--compact { gap: 4px; }
.gallery-density-preview-row--comfortable { gap: 12px; }
.gallery-density-preview-row--spacious { gap: 20px; }
.wrail-scrubber { width: 100%; min-width: 0px; }
.wrail-scrubber__times { width: 100%; min-width: 0px; justify: space-between; }
.wrail-scrubber__elapsed,
.wrail-scrubber__duration { color: var(--text-muted); font-size: 10px; max-lines: 1; }
.wrail-scrubber__slider { width: 100%; min-width: 0px; }

.wrail-tile {
  min-width: 0px;
  min-height: 112px;
  gap: 12px;
  padding: 12px;
  align: center;
  background: var(--surface-raised);
  border-color: var(--border, #343b48);
  border-width: 1px;
  corner-radius: 11px;
}
.wrail-tile:focused {
  background: var(--surface-active, #242933);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.wrail-tile:pressed { opacity: 0.72; }
.wrail-tile__artwork { width: 54px; height: 54px; flex-shrink: 0; padding: 9px; color: var(--accent); }
.wrail-tile__content { min-width: 0px; flex-grow: 1; flex-shrink: 1; gap: 2px; }
.wrail-tile__title { color: var(--text); font-size: 16px; font-weight: 500; max-lines: 2; }
.wrail-tile__subtitle { color: var(--text-muted); font-size: 12px; max-lines: 2; }
.wrail-tile__metadata { color: var(--text-muted); opacity: 0.75; font-size: 10px; max-lines: 2; }
.wrail-tile__state { color: var(--success); font-size: 10px; font-weight: 500; max-lines: 1; }
.wrail-poster-tile {
  min-width: 0px;
  min-height: 0px;
  aspect-ratio: 2/3;
  padding: 0px;
  gap: 0px;
  align: stretch;
  justify: end;
  overflow: clip;
  corner-radius: 12px;
}
.wrail-poster-tile__artwork { width: 100%; height: 100%; object-fit: cover; corner-radius: 12px; }
.wrail-poster-tile__scrim { width: 100%; padding: 28px 14px 12px 14px; background: rgba(9, 9, 8, 0.82); }
.wrail-poster-tile__content { min-width: 0px; gap: 4px; }
.wrail-poster-tile__subtitle { height: 18px; color: var(--text-muted); font-size: 11px; font-weight: 600; line-height: 1.2; max-lines: 1; text-overflow: ellipsis; }
.wrail-poster-tile__title { height: 42px; color: var(--text); font-size: 17px; font-weight: 600; line-height: 1.2; max-lines: 2; text-overflow: ellipsis; }
.wrail-poster-tile__details { height: 18px; min-width: 0px; gap: 8px; align: center; }
.wrail-poster-tile__metadata { min-width: 0px; color: var(--text-muted); font-size: 11px; line-height: 1.2; max-lines: 1; text-overflow: ellipsis; flex-grow: 1; flex-shrink: 1; }
.wrail-poster-tile__state { color: var(--accent); font-size: 11px; font-weight: 600; line-height: 1.2; max-lines: 1; text-overflow: ellipsis; flex-grow: 0; flex-shrink: 0; }

.gallery-root-background {
  width: 100%;
  min-width: 0px;
  min-height: 0px;
  object-fit: cover;
  object-position: center;
  image-tint: rgba(8, 12, 18, 0.18);
  scrim-color: rgba(8, 12, 18, 0.30);
  corner-radius: 14px;
}
.gallery-nested-background {
  width: 100%;
  min-width: 0px;
  padding: 10px;
  background: var(--surface-active, #242933);
  corner-radius: 10px;
}

.gallery-backgrounds-page { gap: 12px; }
.gallery-background-demo-card { gap: 8px; }
.gallery-background-focus-row { gap: 8px; flex-wrap: wrap; }
.gallery-background-button {
  min-width: 142px;
  min-height: 40px;
  flex-grow: 1;
  padding: 8px 12px;
  background: var(--surface-active, #242933);
  corner-radius: 8px;
}
.gallery-background-button:focused {
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.gallery-background-demo-surface {
  width: 100%;
  min-width: 0px;
  min-height: 150px;
  padding: 12px;
  image-tint: rgba(8, 12, 18, 0.24);
  scrim-color: rgba(8, 12, 18, 0.38);
  background: var(--surface-active, #242933);
  corner-radius: 10px;
}
.gallery-background-fit-surface {
  height: 150px;
  min-height: 150px;
  max-height: 150px;
  background: var(--surface-raised);
  border-color: var(--border, #343b48);
  border-width: 2px;
}
.gallery-background-demo-surface--missing {
  background: var(--surface-raised);
  border-color: var(--border, #343b48);
  border-width: 1px;
}

.gallery-utilities-code-card { min-width: 0px; }
.wrail-code-text {
  width: 100%;
  min-width: 0px;
  padding: 9px 10px;
  color: var(--text);
  background: var(--surface-active, #242933);
  font-size: 10px;
  line-height: 1.35;
  max-lines: 4;
  corner-radius: 7px;
}
.gallery-utilities-loading-row { gap: 9px; align: center; }
.gallery-loading { width: 18px; height: 18px; flex-shrink: 0; color: var(--accent); }
.gallery-loading-label { color: var(--text-muted); font-size: 11px; max-lines: 2; }

.wrail-picker,
.wrail-action-sheet {
  min-width: 0px;
  min-height: 0px;
  flex-grow: 1;
  gap: 8px;
  padding: 12px;
  background: var(--surface-raised);
  corner-radius: 11px;
}
.wrail-picker__title,
.wrail-action-sheet__title { color: var(--text); font-size: 20px; font-weight: 500; max-lines: 2; }
.wrail-picker__description,
.wrail-action-sheet__description { color: var(--text-muted); font-size: 11px; line-height: 1.35; max-lines: 3; }
.wrail-picker__options,
.wrail-action-sheet__list { min-width: 0px; min-height: 0px; flex-grow: 1; gap: 6px; overflow: clip; }
.wrail-picker__option,
.wrail-action-sheet__item {
  width: 100%;
  min-height: 42px;
  flex-shrink: 0;
  padding: 9px 12px;
  color: var(--text);
  background: var(--surface-active, #242933);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-size: 12px;
  font-weight: 400;
  text-align: start;
  max-lines: 2;
}
.wrail-picker__option:selected { color: var(--success); }
.wrail-action-sheet__item--danger { color: var(--danger, #e58b8b); }
.wrail-picker__option:focused,
.wrail-action-sheet__item:focused {
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.wrail-toast {
  min-width: 0px;
  flex-shrink: 0;
  gap: 9px;
  padding: 10px 12px;
  align: center;
  background: var(--surface-active, #242933);
  border-color: var(--border, #343b48);
  border-width: 1px;
  corner-radius: 9px;
}
.wrail-toast__icon { width: 18px; height: 18px; flex-shrink: 0; color: var(--success); }
.wrail-toast__copy { min-width: 0px; flex-grow: 1; gap: 2px; }
.wrail-toast__title { color: var(--text); font-size: 12px; font-weight: 500; max-lines: 1; }
.wrail-toast__message { color: var(--text-muted); font-size: 10px; max-lines: 2; }
