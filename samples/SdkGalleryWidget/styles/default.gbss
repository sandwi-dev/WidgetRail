.gallery-root {
  width: 100vw;
  height: 100vh;
  min-width: 0px;
  min-height: 0px;
  max-width: 900px;
  gap: 10px;
  padding: 16px 18px;
  overflow: clip;
  background: var(--surface);
  color: var(--text);
}

.gallery-header { flex-shrink: 0; }
.gbar-section-header__content {
  min-width: 0px;
  gap: 8px 16px;
  align: end;
  justify: space-between;
  flex-wrap: wrap;
}
.gbar-section-header__text {
  min-width: 220px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 2px;
}
.gbar-section-header__eyebrow {
  color: var(--accent);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  max-lines: 1;
}
.gbar-section-header__title {
  min-width: 0px;
  color: var(--text);
  font-size: 23px;
  font-weight: 500;
  line-height: 1.15;
  max-lines: 2;
}
.gbar-section-header__description {
  width: 100%;
  min-width: 0px;
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.35;
  max-lines: 3;
}

.gallery-page-scroll {
  min-width: 0px;
  min-height: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  padding: 2px 5px 2px 2px;
  overflow: clip;
}
.gallery-page {
  width: 100%;
  min-width: 0px;
  flex-shrink: 0;
  gap: 10px;
}
.gbar-section-header { flex-shrink: 0; }

.gbar-responsive-grid {
  width: 100%;
  min-width: 0px;
  flex-shrink: 0;
  gap: 10px;
}
.gbar-card {
  min-width: 0px;
  gap: 8px;
  padding: 12px;
  corner-radius: 10px;
}
.gbar-card--raised { background: var(--surface-raised); }
.gbar-card--subtle { background: var(--surface-active, #242933); }
.gbar-card--transparent {
  background: transparent;
  border-color: var(--border, #343b48);
  border-width: 1px;
}

.gbar-badge {
  min-width: 0px;
  gap: 5px;
  align: center;
}
.gbar-badge__icon { width: 14px; height: 14px; flex-shrink: 0; color: var(--accent); }
.gbar-badge__label {
  min-width: 0px;
  color: var(--text-muted);
  font-size: 10px;
  font-weight: 500;
  max-lines: 1;
  text-overflow: ellipsis;
}
.gbar-badge__icon--success,
.gbar-badge__label--success { color: var(--success); }

.gallery-overview-actions { gap: 7px; align: center; flex-wrap: wrap; }
.gbar-icon-button {
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  padding: 10px;
  color: var(--text-muted);
  background: transparent;
  border-color: transparent;
  border-width: 1px;
  corner-radius: 21px;
}
.gbar-icon-button--small { width: 36px; height: 36px; padding: 9px; corner-radius: 18px; }
.gbar-icon-button--large { width: 50px; height: 50px; padding: 12px; corner-radius: 25px; }
.gbar-icon-button--primary { color: var(--canvas, #0b0d12); background: var(--accent); }
.gbar-icon-button--danger { color: var(--danger, #e58b8b); }
.gbar-icon-button:focused {
  color: var(--text);
  background: var(--surface-active, #242933);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.gbar-icon-button:pressed { opacity: 0.68; }

.gbar-alert,
.gbar-empty-state {
  min-width: 0px;
  flex-shrink: 0;
  gap: 8px;
  padding: 12px;
  background: var(--surface-raised);
  border-color: var(--border, #343b48);
  border-width: 1px;
  corner-radius: 10px;
}
.gbar-alert__content,
.gbar-empty-state__content { min-width: 0px; gap: 10px; align: start; }
.gbar-alert__icon,
.gbar-empty-state__icon { width: 22px; height: 22px; flex-shrink: 0; color: var(--accent); }
.gbar-alert__copy,
.gbar-empty-state__copy { min-width: 0px; flex-grow: 1; flex-shrink: 1; gap: 3px; }
.gbar-alert__title,
.gbar-empty-state__title { color: var(--text); font-size: 14px; font-weight: 500; max-lines: 2; }
.gbar-alert__message,
.gbar-empty-state__message { color: var(--text-muted); font-size: 11px; line-height: 1.35; max-lines: 4; }
.gbar-alert__action,
.gbar-empty-state__action,
.gallery-wide-action,
.gallery-utilities-toast-button {
  min-height: 40px;
  min-width: 128px;
  padding: 8px 12px;
  color: var(--text);
  background: var(--surface-active, #242933);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-size: 11px;
  font-weight: 400;
  max-lines: 2;
}
.gbar-alert__action:focused,
.gbar-empty-state__action:focused,
.gallery-wide-action:focused,
.gallery-utilities-toast-button:focused {
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.gallery-controls-openers { min-width: 0px; gap: 8px; flex-wrap: wrap; }
.gallery-wide-action { flex-grow: 1; flex-shrink: 1; }

.gbar-settings-row {
  min-width: 0px;
  flex-shrink: 0;
  gap: 7px;
  padding: 12px;
  background: var(--surface-raised);
  corner-radius: 10px;
}
.gbar-settings-row__content { min-width: 0px; gap: 9px; align: start; }
.gbar-settings-row__icon { width: 20px; height: 20px; flex-shrink: 0; color: var(--accent); }
.gbar-settings-row__copy { min-width: 0px; flex-grow: 1; flex-shrink: 1; gap: 2px; }
.gbar-settings-row__label { color: var(--text); font-size: 14px; font-weight: 500; max-lines: 2; }
.gbar-settings-row__description { color: var(--text-muted); font-size: 11px; line-height: 1.35; max-lines: 3; }
.gbar-settings-row__metadata { min-width: 0px; gap: 3px; }
.gbar-settings-row__value { color: var(--text-muted); font-size: 10px; max-lines: 2; }
.gbar-settings-row__action,
.gbar-switch {
  min-height: 40px;
  padding: 8px 12px;
  color: var(--text);
  background: var(--surface-active, #242933);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-size: 11px;
  font-weight: 400;
  max-lines: 2;
}
.gbar-settings-row__action:focused,
.gbar-switch:focused {
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.gbar-switch:selected { color: var(--success); }
.gallery-controls-scrubber-card { gap: 10px; }
.gbar-scrubber { width: 100%; min-width: 0px; }
.gbar-scrubber__times { width: 100%; min-width: 0px; justify: space-between; }
.gbar-scrubber__elapsed,
.gbar-scrubber__duration { color: var(--text-muted); font-size: 10px; max-lines: 1; }
.gbar-scrubber__slider { width: 100%; min-width: 0px; }

.gbar-tile {
  min-width: 0px;
  min-height: 112px;
  gap: 12px;
  padding: 12px;
  align: center;
  background: var(--surface-raised);
  border-color: var(--border, #343b48);
  border-width: 1px;
  corner-radius: 11px;
}
.gbar-tile:focused {
  background: var(--surface-active, #242933);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.gbar-tile:pressed { opacity: 0.72; }
.gbar-tile__artwork { width: 54px; height: 54px; flex-shrink: 0; padding: 9px; color: var(--accent); }
.gbar-tile__content { min-width: 0px; flex-grow: 1; flex-shrink: 1; gap: 2px; }
.gbar-tile__title { color: var(--text); font-size: 16px; font-weight: 500; max-lines: 2; }
.gbar-tile__subtitle { color: var(--text-muted); font-size: 12px; max-lines: 2; }
.gbar-tile__metadata { color: var(--text-muted); opacity: 0.75; font-size: 10px; max-lines: 2; }
.gbar-tile__state { color: var(--success); font-size: 10px; font-weight: 500; max-lines: 1; }

.gallery-utilities-code-card { min-width: 0px; }
.gbar-code-text {
  width: 100%;
  min-width: 0px;
  padding: 9px 10px;
  color: var(--text);
  background: var(--surface-active, #242933);
  font-size: 10px;
  line-height: 1.35;
  max-lines: 4;
  corner-radius: 7px;
}
.gallery-utilities-loading-row { gap: 9px; align: center; }
.gallery-loading { width: 18px; height: 18px; flex-shrink: 0; color: var(--accent); }
.gallery-loading-label { color: var(--text-muted); font-size: 11px; max-lines: 2; }

.gbar-picker,
.gbar-action-sheet {
  min-width: 0px;
  min-height: 0px;
  flex-grow: 1;
  gap: 8px;
  padding: 12px;
  background: var(--surface-raised);
  corner-radius: 11px;
}
.gbar-picker__title,
.gbar-action-sheet__title { color: var(--text); font-size: 20px; font-weight: 500; max-lines: 2; }
.gbar-picker__description,
.gbar-action-sheet__description { color: var(--text-muted); font-size: 11px; line-height: 1.35; max-lines: 3; }
.gbar-picker__options,
.gbar-action-sheet__list { min-width: 0px; min-height: 0px; flex-grow: 1; gap: 6px; overflow: clip; }
.gbar-picker__option,
.gbar-action-sheet__item {
  width: 100%;
  min-height: 42px;
  flex-shrink: 0;
  padding: 9px 12px;
  color: var(--text);
  background: var(--surface-active, #242933);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-size: 12px;
  font-weight: 400;
  text-align: start;
  max-lines: 2;
}
.gbar-picker__option:selected { color: var(--success); }
.gbar-action-sheet__item--danger { color: var(--danger, #e58b8b); }
.gbar-picker__option:focused,
.gbar-action-sheet__item:focused {
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.gbar-toast {
  min-width: 0px;
  flex-shrink: 0;
  gap: 9px;
  padding: 10px 12px;
  align: center;
  background: var(--surface-active, #242933);
  border-color: var(--border, #343b48);
  border-width: 1px;
  corner-radius: 9px;
}
.gbar-toast__icon { width: 18px; height: 18px; flex-shrink: 0; color: var(--success); }
.gbar-toast__copy { min-width: 0px; flex-grow: 1; gap: 2px; }
.gbar-toast__title { color: var(--text); font-size: 12px; font-weight: 500; max-lines: 1; }
.gbar-toast__message { color: var(--text-muted); font-size: 10px; max-lines: 2; }
