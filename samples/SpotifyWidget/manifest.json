{
  "manifestVersion": 1,
  "id": "org.gbar.samples.spotify",
  "publisher": "org.gbar.samples",
  "name": "Spotify",
  "version": "0.3.0",
  "hostApi": {
    "minimum": "1.0",
    "maximumMajor": 1
  },
  "entrypoint": {
    "runtime": "full-trust-application-v1",
    "executable": "payload/SpotifyApplication.exe"
  },
  "presentation": { "icon": "music" },
  "permissions": [],
  "optionalPermissions": [],
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "keep-alive"
  },
  "resourceRequest": {
    "memoryMb": 48,
    "updateHz": 4
  },
  "architectures": [
    "x64"
  ]
}
