{
  "manifestVersion": 1,
  "id": "widgetrail.samples.spotify",
  "publisher": "widgetrail.samples",
  "name": "Spotify",
  "version": "0.3.90",
  "pinningSupported": true,
  "hostApi": {
    "minimum": "1.0",
    "maximumMajor": 1
  },
  "entrypoint": {
    "runtime": "full-trust-application-v1",
    "executable": "payload/SpotifyApplication.exe"
  },
  "presentation": {
    "icon": "music",
    "packageIcon": {
      "assetId": "spotify.brand.green",
      "colorMode": "originalColor"
    }
  },
  "iconAssets": {
    "spotify.saved.outline": { "path": "assets/icons/heart-outline.svg" },
    "spotify.saved.filled": { "path": "assets/icons/heart-filled.svg" },
    "spotify.brand.black": { "path": "assets/icons/spotify-black.svg" },
    "spotify.brand.full-green": { "path": "assets/icons/spotify-full-green.svg" },
    "spotify.brand.green": { "path": "assets/icons/spotify-green.svg" },
    "spotify.brand.white": { "path": "assets/icons/spotify-white.svg" }
  },
  "notificationCategories": [
    { "id": "song-changes", "name": "Song changes", "description": "Brief banners with artwork, artist and duration. These notices do not enter the notification list.", "enabledByDefault": true, "retention": "bannerOnly" }
  ],
  "permissions": [],
  "optionalPermissions": [],
  "intents": {
    "requests": [
      {
        "id": "widgetrail.web.open",
        "version": 1,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "minLength": 1, "maxLength": 2048 }
          },
          "required": ["url"]
        }
      }
    ]
  },
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "keep-alive"
  },
  "resourceRequest": {
    "memoryMb": 48,
    "updateHz": 4
  },
  "architectures": [
    "x64"
  ]
}
