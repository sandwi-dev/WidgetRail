.spotify-widget {
  width: 100vw;
  min-width: 0px;
  max-width: 980px;
  gap: 8px;
  padding: 14px 16px;
  background: var(--surface);
  color: var(--text);
  overflow: clip;
}

/* Package-owned protocol-v21 pinned projections reuse the ordinary player and
   queue rows. The host still owns the pinned surface, layout selection, focus,
   rendering, and LT/RT cycling. */
.spotify-pinned-root {
  width: 100vw;
  min-width: 0px;
  min-height: 0px;
  gap: 10px;
  padding: 12px;
  background: var(--surface);
  color: var(--text);
  overflow: clip;
}
.spotify-pinned-now-playing { align: stretch; justify: center; }
.spotify-pinned-shell {
  width: 100%;
  min-width: 0px;
  min-height: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 10px;
  align: stretch;
  overflow: clip;
}
.spotify-pinned-player {
  min-width: 280px;
  flex-grow: 1;
  flex-shrink: 1;
}
.spotify-player-card.spotify-pinned-player-up-next {
  flex-basis: 0px;
  min-width: 280px;
  flex-grow: 1;
  flex-shrink: 1;
}
.spotify-pinned-queue {
  width: 280px;
  min-width: 240px;
  min-height: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 8px;
  padding: 12px;
  background: var(--surface-raised);
  corner-radius: 12px;
  overflow: clip;
}
.spotify-pinned-next-row { width: 100%; min-width: 0px; }
.spotify-pinned-queue-scroll {
  width: 100%;
  min-width: 0px;
  min-height: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 8px;
  overflow: clip;
}

.spotify-header { width: 100%; min-width: 0px; flex-shrink: 0; }
.spotify-full-logo { width: 117px; height: 32px; flex-shrink: 0; }
.spotify-heading {
  width: 100%;
  min-width: 0px;
  min-height: 32px;
  gap: 12px;
  align: center;
  justify: space-between;
}
.spotify-status {
  min-width: 180px;
  max-width: 100%;
  flex-grow: 1;
  flex-shrink: 1;
  color: var(--text-muted);
  font-size: 11px;
  font-weight: 400;
  max-lines: 2;
  text-align: end;
  text-overflow: ellipsis;
}
.spotify-status.is-live { color: var(--success, #57c785); }
.spotify-status.is-error { color: var(--danger, #c98181); }

.spotify-media {
  min-width: 0px;
  min-height: 112px;
  gap: 12px;
  align: center;
  flex-wrap: wrap;
}
.spotify-artwork-frame {
  width: 112px;
  height: 112px;
  flex-shrink: 0;
  overflow: clip;
  corner-radius: 10px;
  background: var(--surface-raised);
}
.spotify-artwork { width: 112px; height: 112px; corner-radius: 10px; }
.spotify-artwork-placeholder {
  width: 112px;
  height: 112px;
  padding: 36px;
  color: var(--text-muted);
}
.spotify-details { min-width: 220px; flex-grow: 1; flex-shrink: 1; gap: 4px; }
.spotify-track-title {
  color: var(--text);
  font-size: 27px;
  font-weight: 500;
  max-lines: 2;
  text-overflow: ellipsis;
}
.spotify-track-subtitle {
  color: var(--text-muted);
  font-size: 15px;
  font-weight: 400;
  max-lines: 2;
  text-overflow: ellipsis;
}
.spotify-context {
  color: var(--text-muted);
  opacity: 0.75;
  font-size: 11px;
  max-lines: 1;
  text-overflow: ellipsis;
}
.spotify-timeline { gap: 9px; align: center; margin: 10px 0 0; }
.spotify-time { width: 42px; color: var(--text-muted); font-size: 10px; max-lines: 1; }
.spotify-time.is-duration { text-align: end; }
.spotify-progress {
  min-width: 220px;
  height: 4px;
  flex-grow: 1;
  color: var(--success, #57c785);
  background: var(--surface-active, #262623);
  corner-radius: 2px;
}

.spotify-primary-controls { gap: 10px; align: center; justify: center; flex-shrink: 0; }
.spotify-transport,
.spotify-secondary-action {
  width: 46px;
  height: 46px;
  padding: 11px;
  color: var(--text-muted);
  background: transparent;
  border-color: transparent;
  border-width: 1px;
  corner-radius: 23px;
}
.spotify-play {
  width: 58px;
  height: 58px;
  padding: 15px;
  color: var(--canvas, #090908);
  background: var(--text);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 29px;
}
.spotify-transport:focused,
.spotify-secondary-action:focused,
.spotify-play:focused {
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.spotify-transport:focused,
.spotify-secondary-action:focused { color: var(--text); background: var(--surface-active, #262623); }
.spotify-secondary-action:selected { color: var(--success, #57c785); }
.spotify-scrubber { width: 100%; min-width: 0px; flex-shrink: 0; }
.spotify-playback-options { min-width: 0px; gap: 11px; align: center; justify: center; }
.spotify-transport:disabled,
.spotify-secondary-action:disabled,
.spotify-play:disabled,
.wrail-scrubber__slider:disabled { opacity: 0.42; }

.spotify-footer {
  min-width: 0px;
  gap: 4px 10px;
  align: center;
  justify: space-between;
  flex-shrink: 0;
  flex-wrap: wrap;
}
.spotify-attribution { color: var(--text-muted); font-size: 10px; max-lines: 1; }
.spotify-footer-actions { min-width: 0px; gap: 4px; flex-wrap: wrap; }
.spotify-text-action {
  min-height: 38px;
  padding: 8px 11px;
  color: var(--text-muted);
  background: transparent;
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-size: 11px;
  font-weight: 400;
}
.spotify-text-action:focused { color: var(--text); background: var(--surface-active, #262623); outline-color: var(--focus); outline-width: 2px; outline-offset: -2px; }

.spotify-state-card,
.spotify-setup-card {
  min-height: 0px;
  gap: 9px;
  padding: 18px;
  align: center;
  justify: center;
  background: var(--surface-raised);
  border-color: var(--border, #343431);
  border-width: 1px;
  corner-radius: 12px;
}
.spotify-state-card {
  width: 100%;
  flex-shrink: 0;
}
.spotify-state-scroll {
  width: 100%;
  min-width: 0px;
  min-height: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  padding: 2px;
  overflow: clip;
}
.spotify-state-icon { width: 34px; height: 34px; flex-shrink: 0; padding: 5px; color: var(--success, #57c785); }
.spotify-state-title { width: 100%; flex-shrink: 0; color: var(--text); font-size: 20px; font-weight: 500; line-height: 1.2; max-lines: 3; text-align: center; }
.spotify-state-detail { width: 100%; min-width: 0px; max-width: 560px; flex-shrink: 0; color: var(--text-muted); font-size: 12px; font-weight: 400; line-height: 1.35; text-align: center; }
.spotify-connect-actions {
  min-width: 0px;
  width: 100%;
  gap: 8px;
  margin: 8px 0 0;
  justify: center;
  flex-wrap: wrap;
  flex-shrink: 0;
}
.spotify-primary,
.spotify-secondary {
  min-width: 132px;
  min-height: 44px;
  flex-shrink: 1;
  padding: 10px 15px;
  color: var(--text);
  background: var(--surface-active, #262623);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 9px;
  font-weight: 400;
  line-height: 1.25;
  max-lines: 2;
  text-align: center;
}
.spotify-responsive-action { flex-grow: 1; }
.spotify-primary { background: var(--accent); color: var(--canvas, #090908); }
.spotify-primary:focused,
.spotify-secondary:focused { outline-color: var(--focus); outline-width: 2px; outline-offset: -2px; }
.spotify-setup-scroll {
  min-width: 0px;
  min-height: 156px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 0px;
  padding: 2px 4px 2px 2px;
  overflow: clip;
}
.spotify-setup-card {
  min-width: 0px;
  gap: 8px;
  padding: 14px 16px;
  align: start;
  justify: start;
  flex-shrink: 0;
}
.spotify-setup-title { max-lines: 2; text-align: start; }
.spotify-setup-step {
  width: 100%;
  flex-shrink: 0;
  color: var(--text-muted);
  font-size: 12px;
  line-height: 1.3;
}
.spotify-setup-action {
  width: 100%;
  flex-shrink: 0;
}
.spotify-setup-input {
  width: 100%;
  min-height: 44px;
  flex-shrink: 0;
}
/* Spotify keeps the SDK navigation shell's compact destination set horizontal
   at every responsive size, with one shared page and persistent player. */
.spotify-page-group {
  width: 100%;
  min-width: 0px;
  min-height: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 10px;
  overflow: clip;
}
.spotify-navigation-tabs {
  min-width: 0px;
  flex-grow: 1;
  flex-shrink: 1;
}
.spotify-navigation-header {
  width: 100%;
  min-width: 0px;
  gap: 12px;
  align: center;
  flex-shrink: 0;
}
.spotify-navigation-settings-hint { flex-shrink: 0; }
.spotify-section-trigger-hint {
  flex-shrink: 0;
  color: var(--text-muted);
  font-size: 10px;
  max-lines: 1;
}
.spotify-section-trigger-key {
  min-width: 28px;
  min-height: 28px;
  padding: 5px 7px;
  justify: center;
  background: var(--surface-active, #262623);
  corner-radius: 6px;
}
.spotify-player-card.spotify-player-dock {
  width: 100%;
  min-width: 0px;
  min-height: 92px;
  flex-grow: 0;
  flex-shrink: 0;
  gap: 12px;
  padding: 10px 14px;
  align: center;
  justify: start;
}
.spotify-player-empty { gap: 12px; }
.spotify-player-empty-icon {
  width: 26px;
  height: 26px;
  flex-shrink: 0;
  color: var(--success, #57c785);
}
.spotify-player-empty-copy { min-width: 0px; flex-grow: 1; flex-shrink: 1; gap: 2px; }
.spotify-player-empty-title {
  width: 100%;
  color: var(--text);
  font-size: 16px;
  font-weight: 500;
  max-lines: 1;
}
.spotify-player-empty-message {
  width: 100%;
  color: var(--text-muted);
  font-size: 12px;
  max-lines: 1;
  text-overflow: ellipsis;
}
.spotify-artwork-frame.spotify-dock-artwork-frame,
.spotify-artwork.spotify-dock-artwork,
.spotify-artwork-placeholder.spotify-dock-artwork-placeholder {
  width: 88px;
  height: 88px;
}
.spotify-artwork-placeholder.spotify-dock-artwork-placeholder { padding: 27px; }
.spotify-details.spotify-dock-details {
  min-width: 140px;
  max-width: 280px;
  flex-grow: 1;
  flex-shrink: 1;
  align: start;
}
.spotify-track-title.spotify-dock-track-title,
.spotify-track-subtitle.spotify-dock-track-subtitle,
.spotify-context.spotify-dock-context { text-align: start; }
.spotify-player-transport {
  min-width: 260px;
  min-height: 0px;
  flex-grow: 2;
  flex-shrink: 1;
  gap: 3px;
  align: center;
}
.spotify-player-card {
  width: 100%;
  min-width: 0px;
  min-height: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 8px;
  padding: 14px;
  align: center;
  justify: center;
  background: var(--surface-raised);
  corner-radius: 12px;
  overflow: clip;
}
.spotify-player-card-compact {
  flex-grow: 0;
  flex-shrink: 0;
  gap: 6px;
  padding: 10px;
  justify: start;
}
.spotify-artwork-frame.spotify-compact-artwork-frame,
.spotify-artwork.spotify-compact-artwork,
.spotify-artwork-placeholder.spotify-compact-artwork-placeholder {
  width: 96px;
  height: 96px;
}
.spotify-artwork-placeholder.spotify-compact-artwork-placeholder { padding: 30px; }
.spotify-compact-details {
  min-height: 48px;
  flex-shrink: 0;
}
.spotify-track-title.spotify-compact-track-title {
  font-size: 18px;
  max-lines: 1;
}
.spotify-compact-scrubber {
  min-height: 44px;
  flex-shrink: 0;
}
.spotify-compact-primary-controls {
  min-height: 52px;
  flex-shrink: 0;
}
.spotify-compact-attribution {
  min-height: 12px;
  flex-shrink: 0;
}
.spotify-artwork-frame,
.spotify-artwork,
.spotify-artwork-placeholder {
  width: 142px;
  height: 142px;
}
.spotify-artwork-placeholder { padding: 46px; }
.spotify-details {
  width: 100%;
  min-width: 0px;
  align: center;
  gap: 2px;
}
.spotify-track-title {
  width: 100%;
  font-size: 21px;
  line-height: 1.15;
  max-lines: 2;
  text-align: center;
}
.spotify-track-subtitle,
.spotify-context {
  width: 100%;
  max-lines: 1;
  text-align: center;
  text-overflow: ellipsis;
}
.spotify-primary-controls {
  width: 100%;
  gap: 7px;
  justify: center;
}
.spotify-transport { width: 40px; height: 40px; padding: 9px; }
.spotify-play { width: 52px; height: 52px; padding: 13px; }
.spotify-secondary-action { width: 36px; height: 36px; padding: 8px; }
.spotify-page {
  width: 100%;
  min-width: 0px;
  min-height: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 8px;
  padding: 12px;
  background: var(--surface-raised);
  corner-radius: 12px;
  overflow: clip;
}
.spotify-page-scroll {
  width: 100%;
  min-width: 0px;
  min-height: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 6px;
  padding: 2px;
  overflow: clip;
}
.spotify-playlist-grid {
  width: 100%;
  min-width: 0px;
  gap: 8px;
  align: stretch;
}
.spotify-page-loading { align: center; justify: center; }
.spotify-page-error { justify: center; }
.spotify-page-action {
  min-width: 96px;
  min-height: 40px;
  padding: 8px 12px;
  color: var(--text);
  background: var(--surface-active, #262623);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-size: 11px;
  font-weight: 400;
  line-height: 1.2;
  text-align: center;
}
.spotify-page-action.is-quiet { color: var(--text-muted); background: transparent; }
.spotify-page-action:focused {
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.spotify-playlist-header {
  min-width: 0px;
  flex-shrink: 0;
}
.wrail-section-header__content {
  width: 100%;
  min-width: 0px;
  min-height: 44px;
}
.wrail-section-header__trailing {
  flex-shrink: 0;
  padding: 0px 2px 0px 8px;
}
.spotify-playlist-header-action {
  min-width: 88px;
  max-width: 112px;
  flex-shrink: 0;
}
.spotify-media-row {
  width: 100%;
  min-width: 0px;
  min-height: 82px;
  flex-shrink: 0;
  padding: 9px 11px;
  gap: 11px;
  background: transparent;
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
}
.wrail-tile__artwork {
  width: 60px;
  height: 60px;
  flex-shrink: 0;
  corner-radius: 7px;
}
.wrail-tile__content {
  min-width: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 2px;
  overflow: clip;
}
.wrail-tile__title {
  width: 100%;
  font-size: 15px;
  font-weight: 500;
  line-height: 1.15;
  max-lines: 1;
  text-overflow: ellipsis;
}
.wrail-tile__subtitle {
  width: 100%;
  font-size: 12px;
  line-height: 1.15;
  max-lines: 1;
  text-overflow: ellipsis;
}
.wrail-tile__metadata,
.wrail-tile__state {
  width: 100%;
  font-size: 11px;
  line-height: 1.1;
  max-lines: 1;
  text-overflow: ellipsis;
}
.spotify-media-row:focused {
  background: var(--surface-active, #262623);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.spotify-playlist-row {
  width: 280px;
  min-width: 280px;
  max-width: 280px;
  flex-grow: 0;
  flex-shrink: 0;
  flex-wrap: nowrap;
}
.spotify-section-refresh { flex-shrink: 0; }
.spotify-device-row { width: 100%; min-width: 0px; flex-shrink: 0; }
.spotify-playlist-detail { padding: 10px 12px 12px; }
