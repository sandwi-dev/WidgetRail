{
  "manifestVersion": 1,
  "id": "widgetrail.samples.ytmusic",
  "publisher": "widgetrail.samples",
  "name": "YouTube Music",
  "version": "0.3.42",
  "pinningSupported": true,
  "hostApi": {
    "minimum": "1.0",
    "maximumMajor": 1
  },
  "entrypoint": {
    "runtime": "full-trust-application-v1",
    "executable": "payload/YtMusicApplication.exe"
  },
  "presentation": {
    "icon": "music",
    "packageIcon": { "assetId": "ytmusic.mark", "colorMode": "originalColor" }
  },
  "iconAssets": {
    "ytmusic.mark": { "path": "assets/icons/yt-music.svg" }
  },
  "notificationCategories": [
    { "id": "song-changes", "name": "Song changes", "description": "Brief banners with artwork, artist and duration. These notices do not enter the notification list.", "enabledByDefault": true, "retention": "bannerOnly" }
  ],
  "permissions": [],
  "optionalPermissions": [],
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "keep-alive"
  },
  "resourceRequest": {
    "memoryMb": 48,
    "updateHz": 5
  },
  "architectures": [
    "x64"
  ]
}
