{
  "manifestVersion": 1,
  "id": "org.gbar.samples.ytmusic",
  "publisher": "org.gbar.samples",
  "name": "YT Music",
  "version": "0.2.1",
  "hostApi": {
    "minimum": "1.0",
    "maximumMajor": 1
  },
  "entrypoint": {
    "runtime": "dotnet-worker",
    "assembly": "payload/YtMusicWidget.dll",
    "type": "GameBarAlternative.Samples.YtMusicWidget.YtMusicWidget"
  },
  "presentation": { "icon": "music" },
  "permissions": [
    "network.loopback:13091"
  ],
  "optionalPermissions": [
    "storage.private-secrets.v1"
  ],
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "suspend-when-hidden"
  },
  "resourceRequest": {
    "memoryMb": 48,
    "updateHz": 5
  },
  "architectures": [
    "x64",
    "arm64"
  ]
}
