.music-root {
  width: 100vw;
  min-width: 0px;
  padding: 14px;
  gap: 8px;
  background: var(--surface);
  color: var(--text);
  overflow: clip;
}
.music-title { font-size: 22px; font-weight: 600; max-lines: 1; text-overflow: ellipsis; }
.music-track-title { font-size: 18px; font-weight: 600; max-lines: 1; text-overflow: ellipsis; }
.music-muted { color: var(--text-muted); font-size: 12px; max-lines: 2; text-overflow: ellipsis; }
.music-description { max-lines: 5; font-size: 15px; }
.music-navigation { flex-grow: 1; flex-shrink: 1; min-height: 0px; min-width: 0px; }
.music-scroll { width: 100%; flex-grow: 1; flex-shrink: 1; min-height: 0px; min-width: 0px; gap: 8px; }
.music-row { width: 100%; min-width: 0px; gap: 8px; align: center; }
.music-cover { width: 44px; height: 44px; corner-radius: 6px; flex-shrink: 0; }
.music-track { flex-grow: 1; flex-shrink: 1; min-width: 0px; min-height: 44px; max-lines: 2; text-overflow: ellipsis; text-align: start; }
.music-radio { width: 108px; min-height: 44px; flex-shrink: 0; }
.music-controls { gap: 8px; align: center; flex-wrap: wrap; min-width: 0px; }
.music-grow { flex-grow: 1; flex-shrink: 1; min-width: 100px; }
.music-volume { width: 110px; }
.music-player { gap: 6px; padding: 12px; corner-radius: 12px; background: var(--surface-raised); flex-shrink: 0; min-width: 0px; }
