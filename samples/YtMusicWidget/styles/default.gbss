:root {
  --media-accent: #fc3f6c;
  --media-focus: #ff89a5;
  --media-surface: #171a22;
  --media-control: #292e3a;
  --media-control-hover: #353b49;
}

.ytmusic-widget {
  gap: 18px;
  padding: 26px 30px 22px;
  background: var(--media-surface);
  color: var(--text);
  overflow: visible;
}

#header {
  gap: 2px;
  margin: 0 0 2px;
}

.widget-title {
  color: var(--text);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.09em;
  max-lines: 1;
  text-transform: uppercase;
}

.connection-status,
.connection-help,
.loading-detail,
.track-artist,
.track-album,
.time {
  color: var(--text-muted);
  max-lines: 1;
  text-overflow: ellipsis;
}

.connection-status {
  font-size: 13px;
}

.connection-status.is-connected {
  color: var(--success);
}

.connection-status.is-disconnected {
  color: var(--warning);
}

.pairing-code {
  color: var(--media-accent);
  font-size: 30px;
  font-weight: 700;
  letter-spacing: 0.14em;
}

#media-layout {
  height: 168px;
  gap: 24px;
  align: center;
}

.artwork-frame,
.artwork-image,
.artwork-placeholder {
  width: 164px;
  height: 164px;
  corner-radius: 13px;
  overflow: clip;
}

.artwork-frame,
.artwork-placeholder {
  background: var(--surface-raised);
}

.artwork-placeholder {
  color: var(--text-muted);
  padding: 52px;
}

#media-details {
  min-width: 360px;
  flex-grow: 1;
  gap: 13px;
  padding: 7px 0;
}

#track-details {
  gap: 3px;
}

.track-title {
  color: var(--text);
  font-size: 25px;
  font-weight: 700;
  max-lines: 1;
  text-overflow: ellipsis;
}

.track-artist {
  font-size: 16px;
}

.track-album {
  color: var(--text-subdued);
  font-size: 12px;
}

#progress-row {
  gap: 10px;
  align: center;
}

.time {
  width: 42px;
  font-size: 11px;
}

#duration-text {
  text-align: end;
}

.track-progress {
  min-width: 240px;
  height: 5px;
  flex-grow: 1;
  color: var(--media-accent);
  background: #3a3e49;
}

#primary-actions {
  height: 60px;
  gap: 14px;
  align: center;
  justify: center;
}

#secondary-actions {
  height: 42px;
  gap: 12px;
  align: center;
  justify: center;
}

.transport-action,
.refresh-action,
.secondary-action,
.play-action {
  padding: 10px;
  color: var(--text);
  background: var(--media-control);
  border-width: 0;
  shape: circle;
  transition-duration: 120ms;
  transition-easing: ease-out;
}

.transport-action,
.refresh-action {
  width: 48px;
  height: 48px;
}

.play-action {
  width: 60px;
  height: 60px;
  padding: 12px;
  background: var(--media-accent);
}

.secondary-action {
  width: 42px;
  height: 42px;
  padding: 9px;
}

.transport-action:focused,
.refresh-action:focused,
.secondary-action:focused {
  background: var(--media-control-hover);
  outline-color: var(--media-focus);
  outline-width: 2px;
  outline-offset: -3px;
  scale: 1.04;
}

.play-action:focused {
  background: var(--media-accent);
  outline-color: #ffb0c2;
  outline-width: 3px;
  outline-offset: -4px;
  scale: 1.05;
}

.secondary-action.is-active {
  color: var(--media-accent);
}

#connection-actions {
  gap: 12px;
  margin: 10px 0 0;
}

.primary-action,
.connection-action {
  min-height: 44px;
  padding: 12px 18px;
  background: var(--media-control);
  border-width: 0;
  corner-radius: 12px;
}

.primary-action:focused,
.connection-action:focused {
  background: var(--media-accent);
  outline-color: var(--media-focus);
  outline-width: 2px;
  outline-offset: -3px;
  scale: 1.03;
}
