/* Keep global theme tokens undefined here. Fallbacks also permit standalone package validation. */
.playnite-library-widget {
  width: 100%;
  height: 100%;
  min-width: 0px;
  min-height: 0px;
  max-width: 1180px;
  max-height: 760px;
  padding: 12px;
  align: center;
  justify: center;
  overflow: clip;
  background: var(--canvas, var(--surface));
  color: var(--text);
}
.playnite-library-canvas { flex-grow: 1; }
.wrail-background-surface { background: rgba(0, 0, 0, 0); }
.wrail-focus-presentation-surface { width: 100%; min-width: 0px; min-height: 0px; gap: 14px; align: start; justify: end; }
.playnite-library-home-surface { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; align: center; justify: center; overflow: clip; background: rgba(0, 0, 0, 0); }
.playnite-library-home-background { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; align: center; justify: center; overflow: clip; background: var(--canvas, var(--surface)); image-tint: alpha(var(--canvas, var(--surface)), .44); }
.playnite-library-surface-stage { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; align: center; justify: center; overflow: clip; }
.playnite-library-home-foreground { width: 100%; min-width: 520px; max-width: 1180px; height: 100%; min-height: 0px; flex-grow: 1; overflow: clip; padding: 18px 20px 16px; }
.playnite-library-home-fallback { gap: 12px; }
.playnite-library-browse-surface { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; padding: 0px; background: rgba(0, 0, 0, 0); overflow: clip; }
.playnite-library-browse-background { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; align: center; justify: center; background: var(--canvas, var(--surface)); overflow: clip; }
.playnite-library-browse-artwork { image-tint: alpha(var(--canvas, var(--surface)), .25); }
.playnite-library-browse-foreground { width: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; padding: 18px; gap: 12px; background: alpha(var(--surface), .84); border-color: alpha(var(--border, var(--surface-muted)), .84); border-width: 1px; corner-radius: 16px; }
.playnite-library-header { min-width: 0px; gap: 3px; overflow: visible; }
.playnite-library-header-row { width: 100%; align: center; justify: space-between; gap: 16px; padding: 10px 14px; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 12px; }
.playnite-library-home-actions { width: 100%; min-width: 0px; align: center; justify: space-between; gap: 12px; padding: 6px 14px; background: alpha(var(--surface), .84); border-color: alpha(var(--border, var(--surface-muted)), .84); border-width: 1px; corner-radius: 12px; }
.playnite-library-home-utilities { min-width: 0px; flex-grow: 0; align: center; gap: 8px; }
.playnite-library-control { min-height: 40px; flex-grow: 0; padding: 8px 12px; font-family: var(--font-text, Segoe UI); font-size: 13px; font-weight: 600; text-align: center; background: var(--surface-raised); color: var(--text); border-color: var(--border-strong, var(--text-muted)); border-width: 1px; corner-radius: 10px; outline-color: transparent; outline-width: 0px; outline-offset: var(--focus-offset, -1.5px); }
.playnite-library-control:focused { border-color: var(--text); outline-color: var(--focus); outline-width: var(--focus-width, 1.5px); outline-offset: var(--focus-offset, -1.5px); }
.playnite-library-control:pressed { background: var(--surface-active, var(--surface-muted)); border-color: var(--focus); }
.playnite-library-control:selected { background: var(--surface-active, var(--surface-muted)); color: var(--text); border-color: var(--accent); }
.playnite-library-filter-active { background: var(--surface-active, var(--surface-muted)); color: var(--text); border-color: var(--accent); }
.playnite-library-filter-active:focused { border-color: var(--text); outline-color: var(--focus); outline-width: var(--focus-width, 1.5px); }
.playnite-library-control:disabled { background: var(--surface-subtle, var(--surface-muted)); color: var(--text-subdued); border-color: var(--border, var(--surface-muted)); }
.playnite-library-header-copy { min-width: 0px; flex-grow: 1; }
.playnite-library-header-expanded { min-width: 0px; gap: 3px; overflow: visible; }
.playnite-library-eyebrow { color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; max-lines: 1; }
.playnite-library-title { min-height: 38px; padding: 2px 0px 4px; overflow: visible; color: var(--text); font-family: var(--font-display, Segoe UI); font-size: 26px; font-weight: 600; line-height: 1.30; max-lines: 2; }
.playnite-library-status { color: var(--text-muted); font-size: 12px; max-lines: 2; }
.playnite-library-library-menu { min-width: 208px; gap: 6px; }
.playnite-library-library-menu-content { min-width: 0px; align: center; justify: space-between; gap: 10px; }
.playnite-library-menu-label { color: var(--text); font-size: 13px; font-weight: 600; max-lines: 1; }

.playnite-library-summary-title { min-width: 0px; color: var(--text); font-family: var(--font-display, Segoe UI); font-size: 34px; font-weight: 600; line-height: 1.15; max-lines: 2; text-overflow: ellipsis; }

.playnite-library-summary-state { color: var(--accent); font-size: 12px; font-weight: 600; max-lines: 1; }

.playnite-library-filter-control { min-width: 0px; }
.playnite-library-source-status { min-width: 0px; gap: 5px; }
.playnite-library-source-rows { gap: 3px; }
.playnite-library-source-row { color: var(--text); font-size: 13px; }
.playnite-library-source-summary { color: var(--text-muted); font-size: 13px; }
.playnite-library-query { min-width: 0px; flex-grow: 0; gap: 10px; padding: 4px; background: transparent; }
.playnite-library-search { min-width: 0px; min-height: 42px; flex-grow: 1; font-weight: 400; text-align: start; }
.playnite-library-collections,
.playnite-library-filters { align: center; min-width: 0px; gap: 8px; }
.playnite-library-main { width: 100%; min-width: 0px; min-height: 0; }
.playnite-library-content { width: 100%; min-width: 0px; min-height: 0; flex-grow: 1; gap: 10px; }
.playnite-library-home-content { flex-grow: 0; }
.playnite-library-empty { width: 100%; min-width: 0px; max-width: 560px; gap: 8px; padding: 16px; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 12px; }
.playnite-library-empty-content { align: center; justify: center; }
.playnite-library-empty-title { color: var(--text); font-family: var(--font-text, Segoe UI); font-size: 20px; font-weight: 700; text-align: start; max-lines: 2; }
.playnite-library-empty-detail { color: var(--text-muted); font-family: var(--font-text, Segoe UI); font-size: 13px; font-weight: 400; text-align: start; max-lines: 3; }
.playnite-library-empty-action { align: center; }
.playnite-library-page-scroll { width: 100%; height: 100%; min-width: 0px; min-height: 0; max-width: 980px; max-height: 680px; flex-grow: 1; gap: 12px; overflow: clip; }
.playnite-library-catalog-scroll { width: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; gap: 10px; overflow: clip; }
.playnite-library-hidden-surface { width: 100%; height: 100%; min-width: 0px; min-height: 0; flex-grow: 1; gap: 12px; align: center; justify: center; padding: 12px; overflow: clip; background: rgba(0, 0, 0, 0); color: var(--text); }
.playnite-library-scroll { width: 100%; min-width: 0px; flex-grow: 1; min-height: 0; gap: 10px; overflow: clip; }
.playnite-library-hero { min-width: 0px; min-height: 126px; gap: 14px; padding: 12px; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 12px; }
.playnite-library-hero-artwork { width: 172px; min-width: 172px; height: 102px; min-height: 102px; corner-radius: 9px; overflow: clip; }
.playnite-library-hero-content { min-width: 0px; gap: 5px; overflow: visible; }
.playnite-library-hero-title { min-height: 33px; padding: 2px 0px 3px; overflow: visible; color: var(--text); font-size: 22px; font-weight: 700; line-height: 1.30; max-lines: 2; }
.playnite-library-hero-source { color: var(--text-muted); }
.playnite-library-hero-state { color: var(--accent); font-weight: 600; }
/* Tile margins contribute 12px of the total gap between posters. */
.playnite-library-grid { width: 100%; min-width: 0px; gap: 0px; }
/* Outer breathing room protects the enlarged border without widening item gaps. */
.playnite-library-browse-scroll { gap: 4px 2px; padding: 8px 4px; }
.playnite-library-rail { width: 100%; min-width: 0px; gap: 0px; padding: 12px 6px 16px; }
.playnite-library-rail-stage { width: 100%; min-width: 0px; min-height: 0px; }
.playnite-library-rail-reservation { opacity: 0; }
/* Preserve compact spacing; focused posters may overlap their neighbours. */
.playnite-library-tile { aspect-ratio: 2/3; min-height: 0px; margin: 6px; scale: 1; transition-duration: 140ms; transition-easing: ease-in-out; background: var(--surface-subtle, var(--surface-muted)); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 12px; }
.playnite-library-fixed-tile { width: 28vh; min-width: 112px; max-width: 150px; flex-grow: 0; }
.playnite-home-poster { width: 35vh; min-width: 136px; max-width: 192px; }
.playnite-library-browse-tile { min-width: 0px; flex-grow: 0; }
.playnite-library-tile:focused { scale: 1.10; border-color: var(--focus); }
.playnite-library-tile:pressed { scale: 0.96; }
.playnite-library-tile:disabled { background: var(--surface-subtle, var(--surface-muted)); color: var(--text-subdued); }
.wrail-poster-tile__scrim { width: 100%; min-height: 0px; padding: 12px; background: var(--surface-subtle, var(--surface-muted)); corner-radius: 12px; overflow: clip; }
.wrail-poster-tile__content { min-height: 0px; gap: 4px; overflow: clip; }
.wrail-poster-tile__title { color: var(--text); }
.wrail-poster-tile__artwork { image-fallback: label; }
.wrail-poster-tile__subtitle,
.wrail-poster-tile__metadata { color: var(--text-muted); }
.wrail-poster-tile__state { color: var(--accent); }
.playnite-library-actions { min-width: 0px; gap: 8px; }
.playnite-library-footer { min-height: 28px; gap: 6px; }
.playnite-library-hint-unavailable { opacity: 0.64; }
.playnite-library-warning { margin: 8px 0 0; }
.playnite-library-details { max-width: 980px; max-height: 720px; }
.playnite-details-title { font-size: 30px; font-weight: 600; max-lines: 2; overflow-wrap: anywhere; }
.playnite-library-details-layout { width: 100%; min-width: 0; min-height: 0; flex-grow: 1; }
.playnite-library-details-scroll { min-width: 0; min-height: 0; padding: 10px 12px; gap: 16px; }
.playnite-library-playnite { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; align: center; justify: center; padding: 12px; background: rgba(0, 0, 0, 0); color: var(--text); }
.playnite-library-playnite-shell { width: 100%; height: 100%; max-width: 900px; max-height: 620px; min-width: 0px; min-height: 0px; gap: 14px; padding: 16px; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 14px; overflow: clip; }
.playnite-library-playnite-header { width: 100%; min-width: 0px; align: center; justify: space-between; gap: 12px; overflow: visible; }
.playnite-library-playnite-heading { min-width: 0px; flex-grow: 1; gap: 2px; overflow: visible; }
.playnite-library-playnite-actions { width: 100%; flex-grow: 0; justify: start; }
.playnite-library-playnite-card { gap: 10px; padding: 14px; background: var(--surface-raised); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 12px; overflow: clip; }
.playnite-library-categories { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; align: center; justify: center; padding: 12px; overflow: clip; background: rgba(0, 0, 0, 0); color: var(--text); }
.playnite-library-categories-shell { width: 100%; height: 100%; max-width: 900px; max-height: 620px; min-width: 0px; min-height: 0px; flex-grow: 1; gap: 14px; padding: 16px; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 14px; overflow: clip; }
.playnite-library-categories-header { width: 100%; min-width: 0px; flex-grow: 0; align: center; justify: space-between; gap: 12px; background: rgba(0, 0, 0, 0); overflow: visible; }
.playnite-library-categories-heading { min-width: 0px; flex-grow: 1; gap: 2px; overflow: visible; }
.playnite-library-categories-back { flex-grow: 0; }
.playnite-library-categories-content { width: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; gap: 10px; overflow: clip; }
.playnite-library-category-create { width: 340px; max-width: 340px; min-width: 0px; flex-grow: 0; }
.playnite-library-categories-list { width: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; gap: 8px; overflow: clip; }
.playnite-library-category { width: 100%; min-width: 0px; min-height: 64px; flex-grow: 0; padding: 12px 16px; gap: 16px; background: var(--surface-raised); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 10px; }
.playnite-library-category-row { width: 100%; min-width: 0px; align: center; justify: space-between; gap: 12px; }
.playnite-library-category-copy { min-width: 0px; flex-grow: 1; gap: 2px; }
.playnite-library-category-summary { min-width: 0px; color: var(--text); font-size: 16px; font-weight: 600; max-lines: 2; text-overflow: ellipsis; }
.playnite-library-category-count { min-width: 0px; color: var(--text-muted); font-size: 12px; max-lines: 1; }
.playnite-library-category-open { flex-grow: 0; }
.playnite-library-playnite-token { min-height: 44px; }
.playnite-library-setup-intro { font-size: 20px; font-weight: 600; color: var(--text); max-lines: 2; }
.playnite-library-setup-path { font-size: 14px; color: var(--text-muted); max-lines: 3; overflow-wrap: anywhere; }
.playnite-library-setup-primary { width: 100%; min-height: 44px; background: var(--surface-raised); color: var(--text); }
.playnite-library-setup-actions { min-width: 0; gap: 12px; }
.playnite-library-setup-secondary { min-width: 0; align: center; gap: 12px; }
.playnite-library-setup-progress { width: 100%; min-width: 0; padding: 16px; background: var(--surface-raised); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 12px; }
.playnite-library-setup-spinner { width: 32px; height: 32px; color: var(--accent); }
.playnite-library-setup-progress-copy { min-width: 0; gap: 8px; }
.playnite-library-setup-stage { font-size: 18px; font-weight: 600; color: var(--text); max-lines: 3; }
.playnite-library-setup-hint { font-size: 14px; color: var(--text-muted); max-lines: 4; }
.playnite-library-hidden-shell { width: 100%; height: 100%; max-width: 900px; max-height: 620px; min-width: 0px; min-height: 0px; flex-grow: 1; gap: 14px; padding: 16px; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 14px; overflow: clip; }
.playnite-library-hidden-header { width: 100%; min-width: 0px; flex-grow: 0; align: center; justify: space-between; gap: 12px; background: rgba(0, 0, 0, 0); overflow: visible; }
.playnite-library-hidden-heading { min-width: 0px; flex-grow: 1; gap: 2px; overflow: visible; }
.playnite-library-hidden-back { flex-grow: 0; }

/* Readable controller hints remain outside focus navigation. */
.wrail-controller-hint { min-height: 28px; flex-grow: 0; align: center; gap: 6px; padding: 0px; background: transparent; border-width: 0px; }
.wrail-controller-hint__key { font-size: var(--controller-glyph-size, 24px); color: var(--controller-glyph-color, var(--text-muted)); padding: 0px; background: transparent; border-width: 0px; }
.wrail-controller-hint__label { color: var(--text-muted); font-size: 12px; font-weight: 400; max-lines: 1; text-overflow: ellipsis; }
.playnite-library-footer { width: 100%; align: center; justify: start; gap: 24px; }
.playnite-library-install-badge { width: 30px; height: 30px; min-height: 30px; padding: 6px; background: var(--surface-active, var(--surface-muted)); border-top-color: var(--border-strong, var(--text-muted)); border-top-width: 1px; corner-radius: 0px; }
.playnite-library-install-label { width: 18px; height: 18px; color: var(--text); font-size: 12px; font-weight: 600; max-lines: 1; text-align: center; }

/* Shared navigation and focused-game information use the global palette. */

.playnite-library-summary-badge { color: var(--text); background: var(--surface-active, var(--surface-muted)); padding: 4px 8px; corner-radius: 6px; font-size: 12px; font-weight: 600; max-lines: 1; text-overflow: ellipsis; }
.playnite-library-summary-badge-accent { color: var(--accent); }
.playnite-library-category:focused { border-color: var(--focus); outline-color: var(--focus); outline-width: var(--focus-width, 1.5px); outline-offset: var(--focus-offset, -1.5px); }
.playnite-library-category:pressed { background: var(--surface-subtle, var(--surface-muted)); }
.playnite-library-category-chevron { color: var(--text-muted); }
/* Preserve readable labels when no cover is available, including warm rows. */
.playnite-library-poster-fallback { min-height: 0px; padding: 12px; background: var(--surface-subtle, var(--surface-muted)); }
.playnite-library-poster-fallback-content { min-height: 0px; gap: 6px; }
.playnite-library-poster-fallback-title { color: var(--text); font-size: 16px; max-lines: 3; }
.playnite-library-poster-fallback-detail { min-height: 0px; }

.playnite-library-poster-artwork-copy { height: 0px; min-height: 0px; padding: 0px; gap: 0px; background: rgba(0, 0, 0, 0); overflow: clip; }

.playnite-home-selected-strip { width:100%; min-width:0; align:center; gap:28px; }
.playnite-home-selected-game { min-width:0; flex-grow:1; gap:3px; }
.playnite-home-stat { min-width:0; gap:2px; }
.playnite-home-stat-label { font-size:13px; color:var(--text-muted); }
.playnite-home-stat-value { font-size:19px; font-weight:600; color:var(--text); }
.playnite-library-summary-compact { min-width: 0px; gap: 4px; }
.playnite-library-summary-compact-title { color: var(--text); font-family: var(--font-display, Segoe UI); font-size: 22px; font-weight: 600; line-height: 1.2; max-lines: 1; text-overflow: ellipsis; }
.playnite-library-summary-compact-meta { color: var(--text-muted); font-size: 12px; max-lines: 1; text-overflow: ellipsis; }
.playnite-library-playnite-content { width: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; gap: 14px; padding: 2px; overflow: clip; }

.playnite-library-search-group { min-width: 0; }

.playnite-library-details-meta { color: var(--text-muted); max-lines: 3; text-overflow: ellipsis; overflow-wrap: anywhere; }

.playnite-library-tabs { width: 100%; min-width: 0px; max-width: 640px; min-height: 44px; gap: 8px; padding: 0px; background: transparent; border-width: 0px; surface-shading: 0; }
.playnite-library-tab { width: 168px; min-width: 104px; flex-grow: 1; text-align: center; }
.playnite-library-tab-key { font-size: var(--controller-glyph-size, 24px); color: var(--text); }
.playnite-library-nav-hint { color: var(--text); }

.playnite-library-details-toolbar { align: center; gap: 12px; min-width: 0; }

.playnite-library-details-row-title { font-size: 16px; font-weight: 600; color: var(--text); max-lines: 2; }
.playnite-library-details-section-title { margin: 12px 0px 2px 0px; font-size: 20px; font-weight: 600; color: var(--text); max-lines: 2; }

.playnite-library-details-paragraphs { min-width: 0; gap: 12px; }

.playnite-library-common-frame { width: 100%; height: 100%; min-width: 0px; min-height: 0px; max-width: 1180px; padding: 24px 20px; flex-grow: 1; gap: 12px; }
.playnite-library-result-count { color: var(--text); background: var(--surface-subtle, var(--surface-muted)); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 10px; font-size: 13px; font-weight: 600; min-width: 0px; padding: 9px 12px; margin: 0px 0px 0px 8px; }

.playnite-library-details-header-hints { align: center; justify: end; flex-grow: 0; gap: 16px; }

.playnite-library-details-button { width: 100%; min-width: 0; }

.playnite-library-details-source { color: var(--text); font-size: 18px; font-weight: 600; max-lines: 2; overflow-wrap: anywhere; }

.playnite-library-details-source-row { min-width: 0; align: center; gap: 12px; }
.playnite-library-details-completion { color: var(--text); background: var(--surface-subtle, var(--surface-muted)); font-size: 13px; font-weight: 600; padding: 4px 10px; corner-radius: 8px; min-width: 0; max-lines: 2; overflow-wrap: anywhere; }

/* Content acrylic needs more backdrop suppression than decorative previews.
   Automatic luminosity follows the theme's tint, including light themes. */
.wrail-modal { background-material: acrylic; background-tint-opacity: var(--acrylic-tint-opacity, .35); background-luminosity-opacity: var(--acrylic-luminosity-opacity, .25); width: 900px; height: 720px; padding: 24px; gap: 20px; background: var(--surface-raised); }
.wrail-modal.playnite-game-details-dialog { width: 1180px; height: 940px; padding: 24px; gap: 0px; corner-radius: 16px; background: var(--surface); }
.wrail-navigation-shell__separator { width: 1px; min-width: 1px; max-width: 1px; height: 22px; min-height: 22px; max-height: 22px; flex-grow: 0; border-left-width: 1px; border-color: var(--border-strong, var(--border, var(--text-muted))); }
.wrail-navigation-shell__compact-item { padding: 9px 4px; gap: 4px; }
/* The shared row header reserves hint width; long titles wrap in the remaining space. */
.wrail-modal__title { font-size: 24px; line-height: 1.2; }
#playnite-start-dialog { width: 560px; height: 380px; max-height: 460px; min-height: 0px; }

/* Compact browsing: one toolbar, quiet filter chips, and one focused summary. */
.playnite-library-toolbar { width: 100%; min-width: 0; align: center; gap: 10px; }
.playnite-library-search-group { flex-grow: 1; min-width: 0; align: center; gap: 8px; }
.playnite-library-search-clear { flex-grow: 0; min-width: 64px; }
.playnite-library-search { min-width: 0; min-height: 44px; font-size: 16px; }
.playnite-library-sort { width: 170px; min-width: 120px; flex-grow: 0; font-size: 15px; }
.playnite-library-filter-button { min-width: 88px; font-size: 15px; }
.playnite-library-filter-chips { width: 100%; min-width: 0; min-height: 36px; gap: 6px; }
.playnite-library-chip { min-height: 34px; padding: 5px 12px; font-size: 14px; color: var(--text-muted); background: transparent; border-width: 1px; border-color: transparent; corner-radius: 7px; }
.playnite-library-chip.playnite-library-filter-active { color: var(--text); background: var(--surface-active, var(--surface-muted)); border-color: var(--border-strong, var(--text-muted)); }
.playnite-library-chip:focused { color: var(--text); outline-width: var(--focus-width, 2px); outline-color: var(--focus); outline-offset: -2px; }
.playnite-library-filter-tag { font-size: 14px; color: var(--text-muted); background: var(--surface-subtle, var(--surface-muted)); padding: 5px 10px; corner-radius: 7px; }
.playnite-library-filter-dialog { width: 100%; min-width: 0; gap: 12px; padding: 2px; }
.playnite-library-primary { background: var(--surface-raised); color: var(--text); font-weight: 600; }
.playnite-library-primary:focused { outline-color: var(--focus); }
.playnite-library-browse-summary-surface { align: stretch; width: 100%; height: 100%; min-width: 0; min-height: 0; flex-grow: 1; gap: 12px; justify: start; }
.playnite-library-summary-strip { width: 100%; min-width: 0; min-height: 90px; padding: 12px 16px; gap: 14px; align: center; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 12px;  }
.playnite-library-summary-copy { min-width: 0; flex-grow: 1; gap: 6px; }
.playnite-library-summary-title-compact { font-size: 24px; max-lines: 1; }
.playnite-library-summary-meta-row { min-width: 0; gap: 12px; align: center; }
.playnite-library-summary-meta { min-width: 0px; color: var(--text-muted); font-size: 14px; line-height: 1.3; max-lines: 2; text-overflow: ellipsis; }
.playnite-library-summary-badges { min-width: 0; gap: 6px; }
.playnite-home-metadata { align: center; }
.playnite-home-platform, .playnite-home-status { font-size:14px; line-height:1.3; max-lines:1; text-overflow:ellipsis; }
.playnite-home-platform { padding:4px 0; }
.playnite-library-play-hint { flex-grow: 0; padding: 8px 12px; gap: 8px; background: var(--surface-active, var(--surface-muted)); border-color: var(--border-strong, var(--text-muted)); border-width: 1px; corner-radius: 8px; }
.playnite-library-play-label { font-size: 16px; font-weight: 600; color: var(--accent); }
.playnite-library-play-key { color: var(--accent); }

/* Home keeps bounded rows and uses the existing focus-driven game background. */
.playnite-library-home-summary { width: 100%; min-width: 0px; gap: 0px; padding: 12px 20px; background: alpha(var(--surface), .84); border-color: alpha(var(--border, var(--surface-muted)), .84); border-width: 1px; corner-radius: 16px; }
.playnite-library-summary-title-home { font-size:30px; max-lines:1; text-overflow:ellipsis; }
.playnite-library-section-heading { width: 100%; min-width: 0; justify: space-between; align: center; gap: 12px; }
.playnite-library-section-title { min-width: 0; font-size: 18px; font-weight: 600; color: var(--text); }
.playnite-library-section-link { min-height: 34px; padding: 4px 10px; color: var(--text); background: var(--surface-active, var(--surface-muted)); border-color: var(--border-strong, var(--text-muted)); border-width: 1px; font-size: 14px; }
.playnite-library-section-link:focused { outline-color: var(--focus); outline-width: var(--focus-width, 2px); outline-offset: -2px; }

/* Details foreground everyday actions; maintenance stays in Game options. */
.playnite-library-details-poster { width: 80px; height: 120px; corner-radius: 8px; overflow: clip; background: var(--surface-muted); }
.playnite-details-artwork { background: var(--surface-muted); image-tint: alpha(var(--canvas, var(--surface)), .16); scrim-color: transparent; corner-radius: 12px; overflow: clip; }
.playnite-library-details-header { padding: 16px; min-width: 0; align: center; gap: 16px; }
.playnite-details-title-block { min-width: 0; gap: 2px; }
.playnite-library-details-buttons { max-width: 400px; min-width: 0; gap: 10px; justify: start; direction: row; align: center; }
.playnite-library-details-play { width: 180px; min-width: 140px; min-height: 44px; flex-grow: 0; font-size: 16px; font-weight: 600; background: var(--surface-raised); color: var(--text); }
.playnite-library-details-play:focused { outline-color: var(--focus); }
.playnite-library-details-facts { width: 100%; min-width: 0; gap: 12px 24px; }
.playnite-library-details-value { align: start; gap: 3px; min-width: 0; padding: 8px 0; direction: column; border-bottom-width: 1px; border-bottom-color: var(--border, var(--surface-muted)); }
.playnite-library-details-label { color: var(--text-muted); font-size: 14px; font-weight: 400; min-width: 0; flex-grow: 0; max-lines: 2; overflow-wrap: anywhere; }
.playnite-library-details-field { color: var(--text); font-size: 16px; font-weight: 400; min-width: 0; flex-grow: 0; max-lines: 4; overflow-wrap: anywhere; }
.playnite-library-details-description { color: var(--text); font-size: 16px; font-weight: 400; line-height: 1.45; max-lines: 128; text-overflow: ellipsis; overflow-wrap: anywhere; }
.playnite-library-details-tabs { width: 100%; min-width: 0; gap: 2px; padding: 5px 8px; }
.playnite-library-details-content { gap: 12px; min-width: 0; }
.playnite-library-details-row { direction: column; min-width: 0; padding: 10px 12px; gap: 4px; background: var(--surface-subtle, var(--surface-muted)); corner-radius: 10px; }
.playnite-library-rich-preview { min-width: 0; gap: 10px; }
.playnite-library-achievement-page, .playnite-library-achievement-list { width: 100%; height: 100%; min-width: 0; min-height: 0; }
.playnite-library-achievement-list { gap: 6px; }
.playnite-library-achievement-summary-row { min-width: 0; align: center; gap: 12px; }
.playnite-library-achievement-summary { color: var(--text); font-size: 18px; font-weight: 600; }
.playnite-library-achievement-total-progress { flex-grow: 1; min-width: 48px; }
.playnite-library-achievement-tools { min-width: 0; align: center; gap: 8px; }
.playnite-library-achievement-search { min-width: 100px; flex-grow: 1; font-size: 15px; }
.playnite-library-achievement-search-group { min-width: 0; flex-grow: 1; align: center; gap: 8px; }
.playnite-library-achievement-filter { width: 150px; min-width: 120px; }
.playnite-library-achievement-sort { width: 170px; min-width: 120px; font-size: 15px; }
.playnite-library-achievement-row { direction: row; align: center; justify: start; text-align: start; min-width: 0; min-height: 64px; padding: 8px 24px 8px 12px; gap: 12px; corner-radius: 8px; background: var(--surface-subtle, var(--surface-muted)); }
.playnite-library-achievement-row-icon { width: 44px; height: 44px; flex-grow: 0; corner-radius: 6px; }
.playnite-library-achievement-row-text { min-width: 0; flex-grow: 1; gap: 2px; align: stretch; }
.playnite-library-achievement-heading { min-width: 0; color: var(--text); text-align: start; font-size: 17px; }
.playnite-library-achievement-name { color: var(--text); text-align: start; font-size: 17px; font-weight: 600; max-lines: 2; }
.playnite-library-achievement-meta { color: var(--text-muted); text-align: start; font-size: 14px; max-lines: 2; }
.playnite-library-achievement-progress-label { color: var(--text); font-size: 15px; }
.playnite-library-preview-title { color: var(--text); font-size: 20px; font-weight: 600; max-lines: 3; }
.playnite-library-preview-state { color: var(--text-muted); font-size: 14px; }
.playnite-library-positive { color: var(--data-green, var(--accent)); }
.playnite-library-preview-description { color: var(--text); font-size: 16px; line-height: 1.45; max-lines: 12; overflow-wrap: anywhere; }

.playnite-library-details-completion-select { max-width: 400px; min-width: 240px; }


/* One content material per foreground panel. Keep text readable over bright or
   dark artwork without fading children or stacking acrylic on inner controls. */
.playnite-library-home-actions, .playnite-library-home-summary,
.playnite-library-browse-foreground {
  background-material: acrylic;
  background-tint-opacity: .8;
  background-luminosity-opacity: auto;
}

.playnite-library-achievement-description { color: var(--text); text-align: start; font-size: 16px; line-height: 1.35; max-lines: 128; overflow-wrap: anywhere; }

.playnite-library-advanced-content { gap: 14px; }

.playnite-library-progress-pin { padding: 14px 16px; gap: 8px; background: alpha(var(--surface), .96); corner-radius: 12px; }
.playnite-library-progress-game { color: var(--text-muted); font-size: 12px; max-lines: 1; }
.playnite-library-progress-title { color: var(--text); font-size: 17px; font-weight: 600; max-lines: 2; overflow-wrap: anywhere; }
.playnite-library-progress-numbers { justify: space-between; align: center; gap: 12px; }
.playnite-library-progress-count { color: var(--text); font-size: 14px; font-weight: 600; }

.playnite-library-progress-artwork { width: 36px; height: 36px; corner-radius: 6px; }

/* Achievement destination: fixed navigation/tools, one demanded game list. */
.playnite-hub-page { width:100%; height:100%; min-width:0; min-height:0; padding:20px; background:transparent; corner-radius:20px; }
.playnite-hub-body { width:100%; height:100%; min-width:0; min-height:0; }
.playnite-hub-game-copy { min-width:0; flex-grow:1; gap:4px; align:stretch; }
.playnite-hub-title { font-family:var(--font-display, Segoe UI); font-size:28px; font-weight:600; color:var(--text); max-lines:2; }
.playnite-hub-meta { font-size:13px; color:var(--text-muted); max-lines:2; text-overflow:ellipsis; }
.playnite-hub-section-title { font-size:17px; font-weight:600; color:var(--text); max-lines:1; }
.playnite-hub-stat { min-width:0; padding:8px 12px; gap:12px; align:center; corner-radius:12px; background:var(--surface-raised); }
.playnite-hub-stat-value { font-size:24px; font-weight:600; color:var(--text); }
.playnite-hub-summary { gap:12px; }
.playnite-hub-recent-section { gap:8px; min-width:0; }
.playnite-hub-recent { width:100%; min-width:0; height:124px; min-height:124px; }
.playnite-hub-recent-card { width:288px; height:100px; min-height:100px; min-width:0; gap:12px; padding:12px; margin:0px 12px 0px 0px; align:center; text-align:start; corner-radius:12px; background:var(--surface-raised); }
.playnite-hub-recent-art { width:48px; height:48px; min-width:48px; corner-radius:8px; }
.playnite-hub-games { width:100%; height:100%; min-width:0; min-height:0; }
.playnite-hub-game { width:100%; min-width:0; min-height:88px; margin:0px 12px 8px 0px; padding:8px 12px; align:center; gap:16px; text-align:start; corner-radius:12px; background:var(--surface-raised); }
.playnite-hub-cover { width:44px; height:64px; min-width:44px; corner-radius:6px; }
.playnite-hub-game-name { font-size:17px; font-weight:600; color:var(--text); max-lines:1; text-overflow:ellipsis; }
.playnite-hub-game:focused, .playnite-hub-recent-card:focused { outline-color:var(--focus); outline-width:2px; outline-offset:-2px; }
.playnite-hub-empty { width:100%; min-width:0; gap:16px; padding:32px; align:start; justify:center; }
.playnite-hub-empty-icon { width:48px; height:48px; color:var(--accent); }
.playnite-hub-empty-description { font-size:16px; line-height:1.45; color:var(--text-muted); max-width:700px; max-lines:6; }

.playnite-hub-summary-compact { width:100%; min-width:0; padding:12px; background:var(--surface-raised); corner-radius:12px; font-size:15px; color:var(--text); max-lines:2; }

.playnite-hub-list-status { min-width:0; flex-grow:1; font-size:13px; color:var(--text-muted); max-lines:2; }

.playnite-hub-recent-meta { font-size:13px; line-height:1.3; color:var(--text-muted); max-lines:1; text-overflow:ellipsis; }

/* Categorical data ink follows the active theme, as in PoB. Labels and prose
   retain ordinary text; status is still explicit in words and symbols. */
.playnite-ink-source, .playnite-library-hero-source, .playnite-library-details-source,
.playnite-library-summary-meta, .playnite-library-summary-compact-meta,
.playnite-library-category-count, .playnite-library-result-count { color:var(--data-blue, var(--text)); }
.playnite-ink-progress, .playnite-library-achievement-summary,
.playnite-library-achievement-progress-label, .playnite-library-progress-count { color:var(--data-green, var(--text)); }
.playnite-ink-reward, .playnite-library-summary-badge-accent { color:var(--data-gold, var(--text)); }
.playnite-ink-time { color:var(--data-purple, var(--text)); }
.playnite-ink-muted { color:var(--text-muted); }

.playnite-capture-content { width:100%; min-width:0; gap:16px; }
.playnite-capture-section { width:100%; min-width:0; padding:16px; gap:12px; corner-radius:12px; background:var(--surface); border-width:1px; border-color:var(--border, var(--text-muted)); }
.playnite-capture-title { font-size:20px; font-weight:600; color:var(--text); }
.playnite-capture-screenshots-title { color:var(--data-blue, var(--text)); }
.playnite-capture-recordings-title { color:var(--data-purple, var(--text)); }
.playnite-capture-folders-title { color:var(--data-gold, var(--text)); }
.playnite-capture-option-group { width:100%; min-width:0; gap:8px; padding:8px 0px 0px 0px; }
.playnite-capture-group-title { font-size:14px; font-weight:600; color:var(--text-muted); }
.playnite-capture-setting { min-width:0; flex-grow:1; gap:8px; }
/* Same semantic paint and contrasting focus as the shared primary action. */
.playnite-capture-save { background:var(--accent); color:var(--canvas, var(--surface)); border-color:transparent; }
.playnite-capture-save:focused { outline-color:var(--focus); outline-width:var(--focus-width, 2px); outline-offset:var(--focus-filled-offset, 2px); }
.playnite-capture-save:disabled { background:var(--surface-subtle, var(--surface-muted)); color:var(--text-subdued); border-color:var(--border, var(--surface-muted)); outline-color:var(--focus); }

.playnite-capture-card { width:100%; min-width:0; align:center; gap:16px; padding:10px; corner-radius:10px; }
.wrail-modal.playnite-short-capture-dialog { height: auto; max-height: 480px; }
.wrail-modal.playnite-link-game-picker { width: 680px; height: 580px; }
.playnite-game-link-hint { interaction-state-source: indexed-item; opacity: 0; }
.playnite-game-link-hint:focused, .playnite-game-link-hint:pressed { opacity: 1; }
.wrail-modal.playnite-link-status { width: 500px; height: auto; max-height: 480px; }
.playnite-capture-grid { width:100%; min-width:0; gap:8px; }
.playnite-capture-tile { width:100%; min-width:0; min-height:104px; }
.playnite-linked-picture { width:100%; min-width:0; height:104px; background:var(--canvas, var(--surface)); }
.playnite-capture-row-art { width:112px; height:72px; flex-grow:0; corner-radius:6px; }
.playnite-capture-stage { background:var(--canvas, var(--surface)); width:100%; flex-grow:1; min-width:0px; min-height:0px; }
.wrail-modal-overlay { padding:0px; border-width:0px; corner-radius:0px; background-material:standard; background:transparent; }
.playnite-capture-viewer { width:100%; height:100%; min-height:0px; padding:0px; border-width:0px; corner-radius:0px; background:transparent; }
.playnite-capture-card-labels { min-width:0; flex-grow:1; align:start; gap:3px; }
.playnite-hero-actions { width:100%; min-width:0; gap:32px; align:center; padding:12px 18px; background:alpha(var(--canvas, var(--surface)), .91); }
.playnite-journal-title { font-size:23px; font-weight:600; color:var(--text); }
.playnite-store-media { width:100%; height:47vh; min-height:180px; padding:0; border-width:0; background:var(--canvas, var(--surface)); }
.playnite-store-loading { width:100%; align:stretch; padding:0; border-width:0; background:var(--canvas, var(--surface)); }
/* The Auto row measures the selected game's summary and the reserved poster rail
   together, including title wrapping, text scaling and the rail's lower inset. */
.playnite-home-play-stage { min-height:68vh; flex-grow:0; align:stretch; }
.playnite-home-activity-body { width:100%; height:100%; min-height:0; padding:0; }
.story-feed-list { width:100%; height:100%; min-width:0; min-height:0; padding:0; margin:0px -8px 0px 0px; background:transparent; }
.story-card { width:100%; min-width:0; padding:0; gap:0; margin:0px 8px 8px 0px; corner-radius:9px; overflow:clip; background:transparent; }
.home-digest-layout { width:100%; min-width:0; }
.home-unlock-card { width:100%; min-width:0; padding:0; margin:0px 8px 8px 0px; border-width:0; corner-radius:10px; overflow:clip; background:transparent; }
.home-activity-tile { width:100%; min-width:0; height:168px; }
.home-unlock-panel { padding:12px 16px; corner-radius:10px; background:var(--surface-raised); background-material:acrylic; background-tint-opacity:.64; background-luminosity-opacity:.54; }
.home-unlock-name { font-size:21px; font-weight:600; color:var(--data-gold, var(--text)); max-lines:1; text-overflow:ellipsis; }
.home-unlock-condition { font-size:15px; color:var(--text); max-lines:3; text-overflow:ellipsis; }
.home-digest-game { font-family:var(--font-display, Segoe UI); font-size:22px; font-weight:600; max-lines:2; text-overflow:ellipsis; color:var(--text); }
.home-digest-credit, .home-digest-session-copy { min-width:0; padding:10px 14px; justify:center; gap:3px; }
.home-digest-credit { background:alpha(var(--surface-raised), .52); }
.home-digest-session { width:100%; min-width:0; min-height:84px; background:alpha(var(--surface), .48); }
.home-digest-session-copy { background:alpha(var(--surface), .48); }
.home-digest-photos { width:100%; min-width:0; height:100%; background:var(--canvas, var(--surface)); }
.game-journal-list { width:100%; height:100%; min-width:0; min-height:0; padding:0 8px; background:transparent; }
.story-card:focused, .story-card:pressed { background:transparent; }
.story-card-material { width:100%; min-width:0; gap:0; padding:0; corner-radius:12px; overflow:clip; background:var(--surface); background-material:acrylic; background-tint-opacity:var(--acrylic-tint-opacity, .35); background-luminosity-opacity:var(--acrylic-luminosity-opacity, .25); }
.story-card:focused { outline-color:var(--focus); outline-width:2px; outline-offset:-2px; }
.story-credit-game { font-size:17px; font-weight:600; color:var(--text); max-lines:1; text-overflow:ellipsis; }
.story-credit-time, .story-description { font-size:15px; color:var(--text-muted); max-lines:2; text-overflow:ellipsis; }
.story-award-panel { width:100%; min-width:0; min-height:145px; padding:12px 16px; background:var(--surface); border-left-width:3px; border-left-color:var(--data-gold, var(--accent)); }
.story-badge { width:64px; height:64px; corner-radius:12px; overflow:clip; background:var(--surface-raised); }
.story-medal { width:36px; height:36px; color:var(--data-gold, var(--accent)); }
.story-insignia, .story-scene, .story-photo { width:100%; height:100%; }
.story-words { width:100%; min-width:0; justify:center; gap:3px; }
.story-gold-label, .story-rarity-label { font-size:15px; font-weight:600; color:var(--data-gold, var(--text)); }
.story-award-title { font-family:var(--font-display, Segoe UI); font-size:23px; font-weight:600; color:var(--text); max-lines:2; text-overflow:ellipsis; }
.story-rarity { width:100%; min-width:0; }
.story-time-label { font-size:15px; font-weight:600; color:var(--data-purple, var(--text-muted)); }
.story-duration { font-family:var(--font-display, Segoe UI); font-size:34px; font-weight:600; color:var(--text); }
.story-clock { font-size:15px; color:var(--text); max-lines:2; }
.story-photo-note { padding:4px 8px; margin:6px; corner-radius:5px; font-size:16px; color:var(--text); background:var(--surface); }
.story-journal-entry { width:100%; min-width:0; gap:0; margin:0px 8px 4px 0px; padding:0; corner-radius:9px; overflow:clip; background:var(--surface-raised); }

.journal-session { width:100%; min-width:0; padding:12px 16px; background:var(--surface-raised); border-left-width:3px; border-left-color:var(--data-purple, var(--accent)); }
.journal-duration { min-width:94px; gap:0; }
.journal-bands { width:100%; min-width:0; height:12px; }
.journal-band, .journal-band-played { width:100%; height:12px; corner-radius:2px; background:var(--surface-muted); }
.journal-band-played { background:var(--data-purple, var(--accent)); border-width:1px; border-color:var(--data-purple, var(--text)); }
.journal-linked-unlock { width:100%; min-width:0; gap:8px; align:center; padding:6px 16px 10px; }
.week-chart { width:100%; min-width:0; }
.week-column, .week-bar { width:100%; height:100%; }
.story-feed-title { padding:8px 0px; color:var(--text); font-family:var(--font-display, Segoe UI); font-size:24px; font-weight:600; }
.playnite-journal-progress { width:100%; min-width:48px; }
.playnite-journal-kind { font-size:15px; font-weight:600; color:var(--text-muted); }
.playnite-journal-entry { width:100%; min-width:0; align:start; gap:6px; padding:12px 14px 16px; corner-radius:8px; background:var(--surface-subtle, var(--surface-muted)); }
.playnite-journal-date { font-size:20px; font-weight:600; color:var(--text); }
.playnite-journal-photos { width:100%; min-width:0; margin:6px 0px 0px; }
.playnite-journal-photo { width:100%; height:164px; corner-radius:6px; overflow:clip; }
.playnite-journal-trophy { width:22px; height:22px; color:var(--data-gold, var(--accent)); }
.playnite-journal-reward { align:center; gap:10px; padding:6px 0px; }
.playnite-journal-unlock { font-size:18px; color:var(--text); font-weight:600; max-lines:2; }
.playnite-home-facts { width:100%; gap:12px; }
.playnite-home-fact-card { width:100%; min-width:0; align:start; gap:8px; padding:16px; corner-radius:10px; background:var(--surface-raised); }
.playnite-capture-caption { font-size:13px; font-weight:600; color:var(--data-blue, var(--text)); max-lines:1; }
.playnite-capture-card-title { font-size:18px; font-weight:600; max-lines:2; text-overflow:ellipsis; }
.playnite-capture-choice { height:44px; min-height:44px; max-height:44px; }

.playnite-capture-header-actions { gap: 12px; align: center; }
.playnite-capture-unsaved { color: var(--warning, var(--text)); font-weight: 600; }

.wrail-modal.playnite-capture-settings-dialog { background: var(--canvas, var(--surface)); background-material: standard; }
.playnite-capture-choice, .playnite-capture-toggle { text-align: start; background: var(--surface-raised); color: var(--text); }
.playnite-capture-toggle.wrail-switch--on { background: var(--surface-active, var(--surface)); color: var(--text); border-color: var(--accent); }
.playnite-capture-toggle.wrail-switch--off { background: var(--surface-muted); color: var(--text-muted); border-color: var(--border, var(--text-muted)); }
.playnite-capture-slider { background: var(--border-strong, var(--text-muted)); color: var(--accent); border-color: var(--text); }
.playnite-launch-scene { surface-entrance: fade; width: 100%; height: 100%; flex-grow: 1; justify: end; align: stretch; background: var(--canvas, var(--surface)); image-tint: alpha(var(--canvas, var(--surface)), .20); }
.playnite-launch-caption { width: 100%; height: 100%; justify: end; align: start; padding: 48px; gap: 14px; }
.playnite-launch-title { font-size: 44px; font-weight: 600; color: var(--text); max-lines: 3; overflow-wrap: anywhere; }
.playnite-launch-progress { align: center; gap: 10px; }
.playnite-launch-actions { gap: 12px; }
.wrail-modal.playnite-launch-confirm { width: 680px; height: auto; max-height: 480px; }
.playing-rail-stop { focus-snap-end:68vh; }
.playnite-library-rail-stage { focus-snap-peek:36px; }
.playing-body { min-height:84vh; justify:end; width:100%; min-width:0px; padding:4px 0px 0px; gap:4px; }
.playing-home-stage { flex-grow:0; min-height:0px; align:stretch; }
.news-month { color:var(--text-secondary, var(--text)); font-size:16px; font-weight:600; }
.playing-scroll { width:100%; height:204px; flex-grow:0; padding:0px; }
.playing-cards { align:stretch; gap:12px; padding:3px 2px; }
.playing-foreground-header { foreground-chrome:auto-hide; }
.playing-action, .playing-story { height:194px; padding:0px; gap:0px; align:stretch; justify:start; overflow:clip; corner-radius:12px; background:transparent; }
.playing-manage { width:234px; }
.playing-story { width:398px; }
.playing-card-face { width:100%; height:192px; min-width:0px; corner-radius:11px; overflow:clip; background:var(--surface); background-material:acrylic; background-tint-opacity:.52; background-luminosity-opacity:.46; }
.playing-card-meta { color:var(--text-secondary, var(--text)); font-size:13px; max-lines:1; text-overflow:ellipsis; }
.playing-card-title { color:var(--text); font-size:19px; font-weight:600; max-lines:2; text-overflow:ellipsis; }
.wrail-modal.news-dialog { width: 1120px; height: 720px; padding: 24px; }
.news-index { gap: 6px; padding: 6px; }
.news-headline { width: 100%; min-height: 42px; padding: 8px 10px; align: start; }
.news-article { gap: 14px; padding: 8px; }
.news-title { font-size: 32px; font-weight: 600; }
.news-image { width: 100%; max-height: 220px; }
.news-copy { font-size: 18px; line-height: 1.45; }
.playing-help { width:164px; intent-visibility: when-handler-installed; }
.playing-discord-compact { width:246px; }
.playing-discord-wide { width:398px; }
.playing-discord-face { padding:12px 14px; }
.playing-discord-brand { width:24px; height:24px; }
.playing-discord-launch-mark { width:66px; height:66px; }
.playing-discord-title, .playing-discord-name, .playing-discord-count { max-lines:1; text-overflow:ellipsis; }
.playing-discord-name { color:var(--text); font-size:16px; font-weight:600; }
.playing-discord-copy { gap:1px; min-width:0px; justify:center; }
.playing-discord-avatar { width:36px; height:36px; corner-radius:18px; overflow:clip; }
.playing-discord-photo { width:100%; height:100%; }
.playing-discord-avatar-fallback { align:center; justify:center; background:alpha(var(--data-purple, var(--accent)),.20); }
.playing-discord-initial { text-align:center; font-size:14px; font-weight:600; color:var(--text); }
.playing-discord-small-avatar { width:20px; height:20px; corner-radius:10px; font-size:12px; }
.playing-discord-heading { padding:0px 12px 0px 0px; }
.playing-discord-count, .playing-discord-command { color:var(--text); font-size:14px; font-weight:600; }
.wrail-modal.playing-discord-dialog { width:548px; height:auto; max-height:82vh; }
.playing-discord-rows { gap:2px; }
.playing-discord-row { width:100%; min-width:0px; padding:8px 10px; min-height:56px; }
.playing-discord-row-action { width:100%; padding:0px; align:stretch; }
.playing-discord-footer { justify:end; gap:8px; }
.news-reading-panes { focus-presentation-layout: reading-pane; width: 100%; height: 100%; min-height: 0px; flex-grow: 1; gap: 24px; }

.news-headline-text { font-size: 16px; max-lines: 3; text-overflow: ellipsis; }

.playing-photo { width:344px; }
.playing-photo-face { width:100%; height:192px; background:var(--canvas, var(--surface)); corner-radius:11px; overflow:clip; }
.playing-photo-art { width:100%; height:192px; }
.playing-photo-caption { width:100%; min-width:0px; padding:7px 12px; background:alpha(var(--surface), .9); }
.playing-award-face { padding:12px 16px 14px; }

.playing-award-name { color:var(--text); font-size:20px; font-weight:600; max-lines:1; text-overflow:ellipsis; }
.playing-award-heading { min-width:0; margin:0 24px 0 0; }
.playing-award-count { color:var(--data-gold, var(--text)); font-size:14px; font-weight:600; }

.playing-detail-face { padding:12px; }
.playing-detail-portrait, .playing-detail-art { width:78px; height:117px; }
.playing-detail-portrait { corner-radius:4px; overflow:clip; background:var(--canvas, var(--surface)); }
.playing-detail-art { image-fallback:none; }
.playing-detail-icon { width:26px; height:26px; color:var(--text-secondary, var(--text)); }
.playing-detail-copy { min-width:0px; align:stretch; gap:5px; }
.playing-detail-developer { font-size:15px; color:var(--text); max-lines:2; text-overflow:ellipsis; }
.playing-detail-metadata { font-size:13px; color:var(--text-secondary, var(--text)); max-lines:1; text-overflow:ellipsis; }
.playing-help-mark { width:86px; height:86px; }
.playing-help-face { padding:10px 14px 14px; }
.playing-story-copy { width:100%; min-width:0px; padding:10px 16px; gap:4px; justify:center; }
.playing-headline { font-family:var(--font-display, Segoe UI); font-size:22px; font-weight:600; max-lines:2; text-overflow:ellipsis; }
.playing-excerpt { font-size:16px; color:var(--text-secondary, var(--text)); max-lines:2; text-overflow:ellipsis; }
.playing-story-art { width:112px; height:192px; }
.playing-session-face { padding:12px 16px 14px; }
.playing-session-previous { gap:0px; }
.playing-sessions { width:264px; }
.playing-start-time { font-size:21px; font-weight:600; color:var(--text); max-lines:1; }
.playing-session-duration { font-size:16px; font-weight:600; max-lines:1; text-overflow:ellipsis; }
.playing-lead-medal { width:66px; height:66px; }

.playing-single-heading { max-lines:1; text-overflow:ellipsis; }

.wrail-modal.playing-card-dialog { width:480px; height:auto; max-height:640px; }
.playing-card-switches { width:100%; gap:4px; }
.playnite-settings-heading { gap: 12px; align: center; }
.playnite-settings-integration { gap: 6px; padding: 10px 0; border-top-width: 1px; border-top-color: var(--border, var(--surface-muted)); }

.playnite-library-home-background, .playnite-library-browse-background {
  artwork-transition: directional-fade;
  artwork-transition-duration: 300ms;
  artwork-transition-travel-x: 0.5%;
  artwork-transition-travel-y: 0.25%;
  artwork-motion: pan-zoom;
  artwork-motion-duration: 9s;
  artwork-motion-scale-from: 1.03;
  artwork-motion-scale-to: 1.01;
  artwork-motion-origin: 75% 50%;
}
.playnite-library-tile:focused, .playing-action:focused, .playing-story:focused, .story-card:focused, .home-unlock-card:focused {
  outline-color: var(--focus);
  outline-width: 3px;
  outline-offset: -3px;
  focus-outline-effect: breathe;
  focus-outline-duration: 1.3s;
  focus-outline-intensity: .85;
  focus-outline-repeat-delay: 200ms;
  focus-sheen: reflection;
  focus-sheen-duration: 1.9s;
  focus-sheen-delay: 180ms;
  focus-sheen-repeat-delay: 6s;
  focus-sheen-opacity: 0.24;
}
.playnite-library-tile:focused { focus-sheen-opacity: 0.30; }

.sessions-body, .sessions-history { width:100%; height:100%; min-width:0; min-height:0; }
.sessions-chart-block, .sessions-profile, .sessions-chart { width:100%; min-width:0; gap:5px; align:stretch; }
.sessions-heading { font-size:24px; font-weight:600; color:var(--text); }
.sessions-subhead { font-size:18px; font-weight:600; color:var(--text); }
.sessions-caption, .sessions-axis-label { font-size:15px; color:var(--text-secondary, var(--text)); }
.sessions-axis-label { font-size:13px; }
.sessions-range { font-size:15px; min-height:38px; padding:4px 12px; }
.sessions-plot { width:100%; min-width:0; }
.sessions-chart-target { width:100%; min-width:24px; height:78px; align:stretch; padding:3px; border-width:0; background:transparent; corner-radius:4px; }
.sessions-chart-target:focused { outline-width:2px; outline-color:var(--focus); background:transparent; }
.sessions-plot-column { width:100%; height:68px; min-width:20px; }
.sessions-bar, .sessions-quiet-bar, .sessions-baseline { width:100%; height:100%; min-width:0; min-height:0; }
.sessions-baseline { background:var(--border-strong, var(--text-muted)); }
.sessions-bar, .sessions-length-fill { background:var(--data-purple, var(--accent)); corner-radius:2px; }
.sessions-bar, .sessions-baseline { max-width:82px; }
.sessions-quiet-bar { background:transparent; }
.sessions-median { font-size:26px; font-weight:600; color:var(--data-purple, var(--accent)); }
.sessions-length-track { height:7px; width:100%; background:var(--surface-muted); corner-radius:3px; }
.sessions-length-fill { width:100%; height:100%; }
.sessions-row { width:100%; min-width:0; padding:0; background:transparent; }
.sessions-row-body { width:100%; min-width:0; align:stretch; padding:8px 12px; gap:6px; }
.sessions-clock { font-size:17px; font-weight:600; color:var(--text); }
.sessions-length { font-size:19px; font-weight:600; color:var(--data-purple, var(--accent)); }
.sessions-run-icon { width:22px; height:22px; color:var(--data-purple, var(--accent)); }
.sessions-highlight-art { width:64px; height:42px; }
.sessions-highlight-row { width:100%; align:stretch; padding:6px 12px 6px 42px; border-left-width:2px; border-left-color:var(--data-purple, var(--accent)); }
.sessions-preview-strip { align:center; gap:6px; }
.sessions-award-preview { width:36px; height:36px; }
.sessions-capture-preview { width:60px; height:36px; }
.sessions-chevron { font-size:17px; color:var(--text-secondary, var(--text)); }

.playnite-library-tile:focused, .playing-photo:focused, .home-unlock-card:focused {
  focus-outline-effect: edge-glint;
  focus-outline-duration: 1.7s;
  focus-outline-repeat-delay: 400ms;
  focus-outline-intensity: 1;
}
.playing-current-game { width:374px; }
.playing-award-words { gap:3px; min-width:0; }
.playing-trophy-case { min-width:252px; max-width:448px; }
.playing-award-progress { gap:4px; align:stretch; }
.playing-award-description { font-size:15px; color:var(--text); max-lines:3; text-overflow:ellipsis; }
.playing-award-facts { font-size:14px; color:var(--text-secondary, var(--text)); max-lines:2; text-overflow:ellipsis; }

.playnite-capture-disclosure { width:100%; min-width:0; gap:8px; }

.playnite-capture-warning { padding:8px; corner-radius:8px; background:var(--surface); }
