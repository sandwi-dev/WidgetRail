/* Keep global theme tokens undefined here. Fallbacks also permit standalone package validation. */
.playnite-library-widget {
  width: 100%;
  height: 100%;
  min-width: 0px;
  min-height: 0px;
  max-width: 1180px;
  max-height: 760px;
  padding: 12px;
  align: center;
  justify: center;
  overflow: clip;
  background: var(--canvas, var(--surface));
  color: var(--text);
}
.playnite-library-canvas { flex-grow: 1; }
.wrail-background-surface { background: rgba(0, 0, 0, 0); }
.wrail-focus-presentation-surface { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; gap: 14px; align: start; justify: end; }
.playnite-library-home-surface { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; align: center; justify: center; overflow: clip; background: rgba(0, 0, 0, 0); }
.playnite-library-home-background { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; align: center; justify: center; overflow: clip; background: var(--canvas, var(--surface)); }
.playnite-library-surface-stage { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; align: center; justify: center; overflow: clip; }
.playnite-library-home-foreground { width: 100%; min-width: 520px; max-width: 1180px; height: 100%; min-height: 0px; flex-grow: 1; overflow: clip; padding: 18px 20px 16px; }
.playnite-library-home-content { background: alpha(var(--surface), .84); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 16px; padding: 14px 16px; width: 100%; min-width: 0px; min-height: 0px; flex-grow: 0; gap: 14px; }
.playnite-library-home-fallback { gap: 12px; }
.playnite-library-browse-surface { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; padding: 0px; background: rgba(0, 0, 0, 0); overflow: clip; }
.playnite-library-browse-background { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; align: center; justify: center; background: var(--canvas, var(--surface)); overflow: clip; }
.playnite-library-browse-foreground { width: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; padding: 18px; gap: 12px; background: alpha(var(--surface), .84); border-color: alpha(var(--border, var(--surface-muted)), .84); border-width: 1px; corner-radius: 16px; }
.playnite-library-header { min-width: 0px; gap: 3px; overflow: visible; }
.playnite-library-header-row { width: 100%; align: center; justify: space-between; gap: 16px; padding: 10px 14px; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 12px; }
.playnite-library-home-actions { width: 100%; min-width: 0px; align: center; justify: space-between; gap: 12px; padding: 6px 14px; background: alpha(var(--surface), .84); border-color: alpha(var(--border, var(--surface-muted)), .84); border-width: 1px; corner-radius: 12px; }
.playnite-library-home-utilities { min-width: 0px; flex-grow: 0; align: center; gap: 8px; }
.playnite-library-control { min-height: 40px; flex-grow: 0; padding: 8px 12px; font-family: var(--font-text, Segoe UI); font-size: 13px; font-weight: 600; text-align: center; background: var(--surface-raised); color: var(--text); border-color: var(--border-strong, var(--text-muted)); border-width: 1px; corner-radius: 10px; outline-color: transparent; outline-width: 0px; outline-offset: var(--focus-offset, -1.5px); }
.playnite-library-control:focused { border-color: var(--text); outline-color: var(--focus); outline-width: var(--focus-width, 1.5px); outline-offset: var(--focus-offset, -1.5px); }
.playnite-library-control:pressed { background: var(--surface-active, var(--surface-muted)); border-color: var(--focus); }
.playnite-library-control:selected { background: var(--surface-active, var(--surface-muted)); color: var(--text); border-color: var(--accent); }
.playnite-library-filter-active { background: var(--surface-active, var(--surface-muted)); color: var(--text); border-color: var(--accent); }
.playnite-library-filter-active:focused { border-color: var(--text); outline-color: var(--focus); outline-width: var(--focus-width, 1.5px); }
.playnite-library-control:disabled { background: var(--surface-subtle, var(--surface-muted)); color: var(--text-subdued); border-color: var(--border, var(--surface-muted)); }
.playnite-library-header-copy { min-width: 0px; flex-grow: 1; }
.playnite-library-header-expanded { min-width: 0px; gap: 3px; overflow: visible; }
.playnite-library-eyebrow { color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; max-lines: 1; }
.playnite-library-title { min-height: 38px; padding: 2px 0px 4px; overflow: visible; color: var(--text); font-family: var(--font-display, Segoe UI); font-size: 26px; font-weight: 600; line-height: 1.30; max-lines: 2; }
.playnite-library-status { color: var(--text-muted); font-size: 12px; max-lines: 2; }
.playnite-library-library-menu { min-width: 208px; gap: 6px; }
.playnite-library-library-menu-content { min-width: 0px; align: center; justify: space-between; gap: 10px; }
.playnite-library-menu-label { color: var(--text); font-size: 13px; font-weight: 600; max-lines: 1; }

.playnite-library-summary-title { min-width: 0px; color: var(--text); font-family: var(--font-display, Segoe UI); font-size: 34px; font-weight: 600; line-height: 1.15; max-lines: 2; text-overflow: ellipsis; }

.playnite-library-summary-state { color: var(--accent); font-size: 12px; font-weight: 600; max-lines: 1; }

.playnite-library-filter-control { min-width: 0px; }
.playnite-library-source-status { min-width: 0px; gap: 5px; }
.playnite-library-source-rows { gap: 3px; }
.playnite-library-source-row { color: var(--text); font-size: 13px; }
.playnite-library-source-summary { color: var(--text-muted); font-size: 13px; }
.playnite-library-query { min-width: 0px; flex-grow: 0; gap: 10px; padding: 4px; background: transparent; }
.playnite-library-search { min-width: 0px; min-height: 42px; flex-grow: 1; font-weight: 400; text-align: start; }
.playnite-library-collections,
.playnite-library-filters { align: center; min-width: 0px; gap: 8px; }
.playnite-library-main { width: 100%; min-width: 0px; min-height: 0; }
.playnite-library-content { width: 100%; min-width: 0px; min-height: 0; flex-grow: 1; gap: 10px; }
.playnite-library-empty { width: 100%; min-width: 0px; max-width: 560px; gap: 8px; padding: 16px; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 12px; }
.playnite-library-empty-content { align: center; justify: center; }
.playnite-library-empty-title { color: var(--text); font-family: var(--font-text, Segoe UI); font-size: 20px; font-weight: 700; text-align: start; max-lines: 2; }
.playnite-library-empty-detail { color: var(--text-muted); font-family: var(--font-text, Segoe UI); font-size: 13px; font-weight: 400; text-align: start; max-lines: 3; }
.playnite-library-empty-action { align: center; }
.playnite-library-page-scroll { width: 100%; height: 100%; min-width: 0px; min-height: 0; max-width: 980px; max-height: 680px; flex-grow: 1; gap: 12px; overflow: clip; }
.playnite-library-catalog-scroll { width: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; gap: 10px; overflow: clip; }
.playnite-library-hidden-surface { width: 100%; height: 100%; min-width: 0px; min-height: 0; flex-grow: 1; gap: 12px; align: center; justify: center; padding: 12px; overflow: clip; background: rgba(0, 0, 0, 0); color: var(--text); }
.playnite-library-scroll { width: 100%; min-width: 0px; flex-grow: 1; min-height: 0; gap: 10px; overflow: clip; }
.playnite-library-hero { min-width: 0px; min-height: 126px; gap: 14px; padding: 12px; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 12px; }
.playnite-library-hero-artwork { width: 172px; min-width: 172px; height: 102px; min-height: 102px; corner-radius: 9px; overflow: clip; }
.playnite-library-hero-content { min-width: 0px; gap: 5px; overflow: visible; }
.playnite-library-hero-title { min-height: 33px; padding: 2px 0px 3px; overflow: visible; color: var(--text); font-size: 22px; font-weight: 700; line-height: 1.30; max-lines: 2; }
.playnite-library-hero-source { color: var(--text-muted); }
.playnite-library-hero-state { color: var(--accent); font-weight: 600; }
/* Tile margins contribute 12px of the total gap between posters. */
.playnite-library-grid { width: 100%; min-width: 0px; gap: 0px; }
/* Outer breathing room protects the enlarged border without widening item gaps. */
.playnite-library-browse-scroll { gap: 4px 2px; padding: 8px 4px; }
.playnite-library-rail { width: 100%; min-width: 0px; gap: 0px; padding: 8px 6px 12px; }
/* Preserve compact spacing; focused posters may overlap their neighbours. */
.playnite-library-tile { aspect-ratio: 2/3; min-height: 0px; margin: 6px; scale: 1; transition-duration: 140ms; transition-easing: ease-in-out; background: var(--surface-subtle, var(--surface-muted)); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 12px; }
.playnite-library-fixed-tile { width: 28vh; min-width: 112px; max-width: 150px; flex-grow: 0; }
.playnite-library-browse-tile { min-width: 0px; flex-grow: 0; }
.playnite-library-tile:focused { scale: 1.10; border-color: var(--focus); }
.playnite-library-tile:pressed { scale: 0.96; }
.playnite-library-tile:disabled { background: var(--surface-subtle, var(--surface-muted)); color: var(--text-subdued); }
.wrail-poster-tile__scrim { width: 100%; min-height: 0px; padding: 12px; background: var(--surface-subtle, var(--surface-muted)); corner-radius: 12px; overflow: clip; }
.wrail-poster-tile__content { min-height: 0px; gap: 4px; overflow: clip; }
.wrail-poster-tile__title { color: var(--text); }
.wrail-poster-tile__subtitle,
.wrail-poster-tile__metadata { color: var(--text-muted); }
.wrail-poster-tile__state { color: var(--accent); }
.playnite-library-actions { min-width: 0px; gap: 8px; }
.playnite-library-footer { min-height: 28px; gap: 6px; }
.playnite-library-hint-unavailable { opacity: 0.64; }
.playnite-library-warning { margin: 8px 0 0; }
.playnite-library-details { max-width: 980px; max-height: 720px; }
.playnite-library-details-layout { width: 100%; min-width: 0; min-height: 0; flex-grow: 1; }
.playnite-library-details-scroll { min-width: 0; min-height: 0; padding: 10px 12px; gap: 16px; }
.playnite-library-playnite { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; align: center; justify: center; padding: 12px; background: rgba(0, 0, 0, 0); color: var(--text); }
.playnite-library-playnite-shell { width: 100%; height: 100%; max-width: 900px; max-height: 620px; min-width: 0px; min-height: 0px; gap: 14px; padding: 16px; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 14px; overflow: clip; }
.playnite-library-playnite-header { width: 100%; min-width: 0px; align: center; justify: space-between; gap: 12px; overflow: visible; }
.playnite-library-playnite-heading { min-width: 0px; flex-grow: 1; gap: 2px; overflow: visible; }
.playnite-library-playnite-actions { width: 100%; flex-grow: 0; justify: start; }
.playnite-library-playnite-card { gap: 10px; padding: 14px; background: var(--surface-raised); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 12px; overflow: clip; }
.playnite-library-categories { width: 100%; height: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; align: center; justify: center; padding: 12px; overflow: clip; background: rgba(0, 0, 0, 0); color: var(--text); }
.playnite-library-categories-shell { width: 100%; height: 100%; max-width: 900px; max-height: 620px; min-width: 0px; min-height: 0px; flex-grow: 1; gap: 14px; padding: 16px; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 14px; overflow: clip; }
.playnite-library-categories-header { width: 100%; min-width: 0px; flex-grow: 0; align: center; justify: space-between; gap: 12px; background: rgba(0, 0, 0, 0); overflow: visible; }
.playnite-library-categories-heading { min-width: 0px; flex-grow: 1; gap: 2px; overflow: visible; }
.playnite-library-categories-back { flex-grow: 0; }
.playnite-library-categories-content { width: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; gap: 10px; overflow: clip; }
.playnite-library-category-create { width: 340px; max-width: 340px; min-width: 0px; flex-grow: 0; }
.playnite-library-categories-list { width: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; gap: 8px; overflow: clip; }
.playnite-library-category { width: 100%; min-width: 0px; min-height: 64px; flex-grow: 0; padding: 12px 16px; gap: 16px; background: var(--surface-raised); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 10px; }
.playnite-library-category-row { width: 100%; min-width: 0px; align: center; justify: space-between; gap: 12px; }
.playnite-library-category-copy { min-width: 0px; flex-grow: 1; gap: 2px; }
.playnite-library-category-summary { min-width: 0px; color: var(--text); font-size: 16px; font-weight: 600; max-lines: 2; text-overflow: ellipsis; }
.playnite-library-category-count { min-width: 0px; color: var(--text-muted); font-size: 12px; max-lines: 1; }
.playnite-library-category-open { flex-grow: 0; }
.playnite-library-playnite-token { min-height: 44px; }
.playnite-library-setup-intro { font-size: 20px; font-weight: 600; color: var(--text); max-lines: 2; }
.playnite-library-setup-path { font-size: 14px; color: var(--text-muted); max-lines: 3; overflow-wrap: anywhere; }
.playnite-library-setup-primary { width: 100%; min-height: 44px; background: var(--surface-raised); color: var(--text); }
.playnite-library-setup-actions { min-width: 0; gap: 12px; }
.playnite-library-setup-secondary, .playnite-library-setup-progress { min-width: 0; align: center; gap: 12px; }
.playnite-library-hidden-shell { width: 100%; height: 100%; max-width: 900px; max-height: 620px; min-width: 0px; min-height: 0px; flex-grow: 1; gap: 14px; padding: 16px; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 14px; overflow: clip; }
.playnite-library-hidden-header { width: 100%; min-width: 0px; flex-grow: 0; align: center; justify: space-between; gap: 12px; background: rgba(0, 0, 0, 0); overflow: visible; }
.playnite-library-hidden-heading { min-width: 0px; flex-grow: 1; gap: 2px; overflow: visible; }
.playnite-library-hidden-back { flex-grow: 0; }

/* Readable controller hints remain outside focus navigation. */
.wrail-controller-hint { min-height: 28px; flex-grow: 0; align: center; gap: 6px; padding: 0px; background: transparent; border-width: 0px; }
.wrail-controller-hint__key { font-size: var(--controller-glyph-size, 24px); color: var(--controller-glyph-color, var(--text-muted)); padding: 0px; background: transparent; border-width: 0px; }
.wrail-controller-hint__label { color: var(--text-muted); font-size: 12px; font-weight: 400; max-lines: 1; text-overflow: ellipsis; }
.playnite-library-footer { width: 100%; align: center; justify: start; gap: 24px; }
.playnite-library-install-badge { width: 30px; height: 30px; min-height: 30px; padding: 6px; background: var(--surface-active, var(--surface-muted)); border-top-color: var(--border-strong, var(--text-muted)); border-top-width: 1px; corner-radius: 0px; }
.playnite-library-install-label { width: 18px; height: 18px; color: var(--text); font-size: 12px; font-weight: 600; max-lines: 1; text-align: center; }

/* Shared navigation and focused-game information use the global palette. */

.playnite-library-summary-badge { color: var(--text); background: var(--surface-active, var(--surface-muted)); padding: 4px 8px; corner-radius: 6px; font-size: 12px; font-weight: 600; max-lines: 1; text-overflow: ellipsis; }
.playnite-library-summary-badge-accent { color: var(--accent); }
.playnite-library-category:focused { border-color: var(--focus); outline-color: var(--focus); outline-width: var(--focus-width, 1.5px); outline-offset: var(--focus-offset, -1.5px); }
.playnite-library-category:pressed { background: var(--surface-subtle, var(--surface-muted)); }
.playnite-library-category-chevron { color: var(--text-muted); }
/* Preserve readable labels when no cover is available, including warm rows. */
.playnite-library-poster-fallback { min-height: 0px; padding: 12px; background: var(--surface-subtle, var(--surface-muted)); }
.playnite-library-poster-fallback-content { min-height: 0px; gap: 6px; }
.playnite-library-poster-fallback-title { color: var(--text); font-size: 16px; max-lines: 3; }
.playnite-library-poster-fallback-detail { min-height: 0px; }

.playnite-library-poster-artwork-copy { height: 0px; min-height: 0px; padding: 0px; gap: 0px; background: rgba(0, 0, 0, 0); overflow: clip; }

.playnite-library-summary-expanded { min-width: 0px; gap: 10px; }
.playnite-library-summary-compact { min-width: 0px; gap: 4px; }
.playnite-library-summary-compact-title { color: var(--text); font-family: var(--font-display, Segoe UI); font-size: 22px; font-weight: 600; line-height: 1.2; max-lines: 1; text-overflow: ellipsis; }
.playnite-library-summary-compact-meta { color: var(--text-muted); font-size: 12px; max-lines: 1; text-overflow: ellipsis; }
.playnite-library-playnite-content { width: 100%; min-width: 0px; min-height: 0px; flex-grow: 1; gap: 14px; padding: 2px; overflow: clip; }

.playnite-library-search-group { min-width: 0; }

.playnite-library-details-meta { color: var(--text-muted); max-lines: 3; text-overflow: ellipsis; overflow-wrap: anywhere; }

.playnite-library-tabs { width: 400px; min-width: 0px; max-width: 400px; min-height: 44px; gap: 12px; padding: 0px; background: transparent; border-width: 0px; surface-shading: 0; }
.playnite-library-tab { width: 128px; min-width: 104px; flex-grow: 1; text-align: center; }
.playnite-library-tab-key { font-size: var(--controller-glyph-size, 24px); color: var(--text); }
.playnite-library-nav-hint { color: var(--text); }

.playnite-library-details-toolbar { align: center; gap: 12px; min-width: 0; }

.playnite-library-details-row-title { font-size: 16px; font-weight: 600; color: var(--text); max-lines: 2; }
.playnite-library-details-section-title { margin: 12px 0px 2px 0px; font-size: 20px; font-weight: 600; color: var(--text); max-lines: 2; }

.playnite-library-details-paragraphs { min-width: 0; gap: 12px; }

.playnite-library-common-frame { width: 100%; height: 100%; min-width: 0px; min-height: 0px; max-width: 1180px; padding: 24px 20px; flex-grow: 1; gap: 12px; }
.playnite-library-result-count { color: var(--text); background: var(--surface-subtle, var(--surface-muted)); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 10px; font-size: 13px; font-weight: 600; min-width: 0px; padding: 9px 12px; margin: 0px 0px 0px 8px; }

.playnite-library-details-header-hints { align: center; justify: end; flex-grow: 0; gap: 16px; }

.playnite-library-details-button { width: 100%; min-width: 0; }

.playnite-library-details-source { color: var(--text); font-size: 18px; font-weight: 600; max-lines: 2; overflow-wrap: anywhere; }

.playnite-library-details-source-row { min-width: 0; align: center; gap: 12px; }
.playnite-library-details-completion { color: var(--text); background: var(--surface-subtle, var(--surface-muted)); font-size: 13px; font-weight: 600; padding: 4px 10px; corner-radius: 8px; min-width: 0; max-lines: 2; overflow-wrap: anywhere; }

/* Dense details use tinted acrylic without reducing text opacity. */
.wrail-modal { background-material: acrylic; background-tint-opacity: var(--acrylic-tint-opacity, .35); background-luminosity-opacity: var(--acrylic-luminosity-opacity, .25); width: 900px; height: 720px; padding: 24px; gap: 20px; background: var(--surface-raised); }
/* The shared row header reserves hint width; long titles wrap in the remaining space. */
.wrail-modal__title { font-size: 24px; line-height: 1.2; }

/* Compact browsing: one toolbar, quiet filter chips, and one focused summary. */
.playnite-library-toolbar { width: 100%; min-width: 0; align: center; gap: 10px; }
.playnite-library-search-group { flex-grow: 1; min-width: 0; align: center; gap: 8px; }
.playnite-library-search-clear { flex-grow: 0; min-width: 64px; }
.playnite-library-search { min-width: 0; min-height: 44px; font-size: 16px; }
.playnite-library-sort { width: 170px; min-width: 120px; flex-grow: 0; font-size: 15px; }
.playnite-library-filter-button { min-width: 88px; font-size: 15px; }
.playnite-library-filter-chips { width: 100%; min-width: 0; min-height: 36px; gap: 6px; }
.playnite-library-chip { min-height: 34px; padding: 5px 12px; font-size: 14px; color: var(--text-muted); background: transparent; border-width: 1px; border-color: transparent; corner-radius: 7px; }
.playnite-library-chip.playnite-library-filter-active { color: var(--text); background: var(--surface-active, var(--surface-muted)); border-color: var(--border-strong, var(--text-muted)); }
.playnite-library-chip:focused { color: var(--text); outline-width: var(--focus-width, 2px); outline-color: var(--focus); outline-offset: -2px; }
.playnite-library-filter-tag { font-size: 14px; color: var(--text-muted); background: var(--surface-subtle, var(--surface-muted)); padding: 5px 10px; corner-radius: 7px; }
.playnite-library-filter-dialog { width: 100%; min-width: 0; gap: 12px; padding: 2px; }
.playnite-library-primary { background: var(--surface-raised); color: var(--text); font-weight: 600; }
.playnite-library-primary:focused { outline-color: var(--focus); }
.playnite-library-browse-summary-surface { align: stretch; width: 100%; min-width: 0; min-height: 0; flex-grow: 1; gap: 12px; justify: start; }
.playnite-library-summary-strip { width: 100%; min-width: 0; min-height: 90px; padding: 12px 16px; gap: 14px; align: center; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 12px;  }
.playnite-library-summary-copy { min-width: 0; flex-grow: 1; gap: 6px; }
.playnite-library-summary-title-compact { font-size: 24px; max-lines: 1; }
.playnite-library-summary-meta-row { min-width: 0; gap: 12px; align: center; }
.playnite-library-summary-meta { min-width: 0px; color: var(--text-muted); font-size: 14px; line-height: 1.3; max-lines: 2; text-overflow: ellipsis; }
.playnite-library-summary-badges { min-width: 0; gap: 6px; }
.playnite-library-play-hint { flex-grow: 0; padding: 8px 12px; gap: 8px; background: var(--surface-active, var(--surface-muted)); border-color: var(--border-strong, var(--text-muted)); border-width: 1px; corner-radius: 8px; }
.playnite-library-play-label { font-size: 16px; font-weight: 600; color: var(--accent); }
.playnite-library-play-key { color: var(--accent); }

/* Home keeps bounded rows and uses the existing focus-driven game background. */
.playnite-library-home-summary { width: 100%; min-width: 0px; max-width: 760px; gap: 0px; padding: 16px 20px; overflow: clip; background: alpha(var(--surface), .84); border-color: alpha(var(--border, var(--surface-muted)), .84); border-width: 1px; corner-radius: 16px;  }
.playnite-library-summary-title-home { font-size: 30px; }
.playnite-library-summary-description { min-width: 0px; color: var(--text-muted); font-size: 16px; line-height: 1.4; max-lines: 2; text-overflow: ellipsis; }
.playnite-library-section-heading { width: 100%; min-width: 0; justify: space-between; align: center; gap: 12px; }
.playnite-library-section-title { min-width: 0; font-size: 18px; font-weight: 600; color: var(--text); }
.playnite-library-section-link { min-height: 34px; padding: 4px 10px; color: var(--text); background: var(--surface-active, var(--surface-muted)); border-color: var(--border-strong, var(--text-muted)); border-width: 1px; font-size: 14px; }
.playnite-library-section-link:focused { outline-color: var(--focus); outline-width: var(--focus-width, 2px); outline-offset: -2px; }
.playnite-library-favorites-row { width: 100%; min-width: 0; height: 94px; flex-grow: 0; padding: 4px; }
.playnite-library-favorite-card { min-width: 0; width: 100%; min-height: 64px; margin: 4px 6px; padding: 9px 12px; gap: 10px; align: center; background: var(--surface); border-color: var(--border, var(--surface-muted)); border-width: 1px; corner-radius: 10px; }
.playnite-library-favorite-icon { color: var(--accent); width: 22px; height: 22px; }
.playnite-library-favorite-card:focused { outline-color: var(--focus); outline-width: var(--focus-width, 2px); outline-offset: -2px; }
.playnite-library-favorite-title { font-size: 15px; font-weight: 600; color: var(--text); max-lines: 1; text-overflow: ellipsis; }

/* Details foreground everyday actions; maintenance stays in Game options. */
.playnite-library-details-poster { width: 80px; height: 120px; corner-radius: 8px; overflow: clip; background: var(--surface-muted); }
.playnite-library-details-header { min-width: 0; align: start; gap: 16px; }
.playnite-library-details-controls { align: start; min-width: 0; flex-grow: 1; gap: 8px; }
.playnite-library-details-buttons { max-width: 400px; min-width: 0; gap: 10px; justify: start; direction: row; align: center; }
.playnite-library-details-play { width: 180px; min-width: 140px; min-height: 44px; flex-grow: 0; font-size: 16px; font-weight: 600; background: var(--surface-raised); color: var(--text); }
.playnite-library-details-play:focused { outline-color: var(--focus); }
.playnite-library-details-facts { width: 100%; min-width: 0; gap: 12px 24px; }
.playnite-library-details-value { align: start; gap: 3px; min-width: 0; padding: 8px 0; direction: column; border-bottom-width: 1px; border-bottom-color: var(--border, var(--surface-muted)); }
.playnite-library-details-label { color: var(--text-muted); font-size: 14px; font-weight: 400; min-width: 0; flex-grow: 0; max-lines: 2; overflow-wrap: anywhere; }
.playnite-library-details-field { color: var(--text); font-size: 16px; font-weight: 400; min-width: 0; flex-grow: 0; max-lines: 4; overflow-wrap: anywhere; }
.playnite-library-details-description { color: var(--text); font-size: 16px; font-weight: 400; line-height: 1.45; max-lines: 128; text-overflow: ellipsis; overflow-wrap: anywhere; }
.playnite-library-details-tabs { width: 100%; min-width: 0; gap: 6px; padding: 5px 8px; }
.playnite-library-details-content { gap: 12px; min-width: 0; }
.playnite-library-details-row { direction: column; min-width: 0; padding: 10px 12px; gap: 4px; background: var(--surface-subtle, var(--surface-muted)); corner-radius: 10px; }
.playnite-library-rich-preview { min-width: 0; gap: 10px; }
.playnite-library-achievement-page, .playnite-library-achievement-list { width: 100%; height: 100%; min-width: 0; min-height: 0; }
.playnite-library-achievement-list { gap: 6px; }
.playnite-library-achievement-summary-row { min-width: 0; align: center; gap: 12px; }
.playnite-library-achievement-summary { color: var(--text); font-size: 18px; font-weight: 600; }
.playnite-library-achievement-total-progress { flex-grow: 1; min-width: 48px; }
.playnite-library-achievement-tools { min-width: 0; align: center; gap: 8px; }
.playnite-library-achievement-search { min-width: 100px; flex-grow: 1; font-size: 15px; }
.playnite-library-achievement-search-group { min-width: 0; flex-grow: 1; align: center; gap: 8px; }
.playnite-library-achievement-filter { width: 150px; min-width: 120px; }
.playnite-library-achievement-sort { width: 170px; min-width: 120px; font-size: 15px; }
.playnite-library-achievement-row { direction: row; align: center; justify: start; text-align: start; min-width: 0; min-height: 64px; padding: 8px 12px; gap: 12px; corner-radius: 8px; background: var(--surface-subtle, var(--surface-muted)); }
.playnite-library-achievement-row-icon { width: 44px; height: 44px; flex-grow: 0; corner-radius: 6px; }
.playnite-library-achievement-row-text { min-width: 0; flex-grow: 1; gap: 2px; align: stretch; }
.playnite-library-achievement-name { color: var(--text); text-align: start; font-size: 17px; font-weight: 600; max-lines: 2; }
.playnite-library-achievement-meta { color: var(--text-muted); text-align: start; font-size: 14px; max-lines: 2; }
.playnite-library-achievement-progress-label { color: var(--text); font-size: 15px; }
.playnite-library-preview-title { color: var(--text); font-size: 20px; font-weight: 600; max-lines: 3; }
.playnite-library-preview-state { color: var(--text-muted); font-size: 14px; }
.playnite-library-positive { color: var(--data-green, var(--accent)); }
.playnite-library-preview-description { color: var(--text); font-size: 16px; line-height: 1.45; max-lines: 12; overflow-wrap: anywhere; }

.playnite-library-details-completion-select { max-width: 400px; min-width: 240px; }

.playnite-library-section-tools { min-width: 0; align: center; gap: 18px; }

/* One material per foreground panel; covers, badges and inner rows keep ordinary fills. */
.playnite-library-home-actions, .playnite-library-home-summary,
.playnite-library-home-content, .playnite-library-browse-foreground {
  background-material: acrylic;
  background-tint-opacity: var(--acrylic-tint-opacity, .35);
  background-luminosity-opacity: var(--acrylic-luminosity-opacity, .25);
}

.playnite-library-achievement-description { color: var(--text); text-align: start; font-size: 16px; line-height: 1.35; max-lines: 128; overflow-wrap: anywhere; }
