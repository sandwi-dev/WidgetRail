.playnite-library-widget { padding: 18px; gap: 14px; min-height: 0; background: #11151b; color: #f4f7fa; }
.playnite-library-fixed { flex-shrink: 0; }
.playnite-library-header { gap: 4px; }
.playnite-library-header-expanded { gap: 4px; }
.playnite-library-eyebrow { color: #75b9ff; font-size: 12px; }
.playnite-library-title { font-size: 26px; font-weight: 700; }
.playnite-library-status { color: #aeb9c6; }
.playnite-library-source-status { gap: 6px; }
.playnite-library-source-rows { gap: 3px; }
.playnite-library-source-row { color: #d6dee8; font-size: 13px; }
.playnite-library-source-summary { color: #aeb9c6; font-size: 13px; }
.playnite-library-query { gap: 10px; }
.playnite-library-search { flex-shrink: 0; }
.playnite-library-filters { flex-shrink: 0; gap: 10px; }
.playnite-library-main { flex-grow: 1; min-height: 0; }
.playnite-library-content { flex-grow: 1; min-height: 0; gap: 12px; }
.playnite-library-scroll { flex-grow: 1; min-height: 0; gap: 12px; }
.playnite-library-hero { flex-shrink: 0; min-height: 150px; gap: 14px; }
.playnite-library-hero-artwork { min-width: 220px; min-height: 128px; }
.playnite-library-hero-content { gap: 6px; }
.playnite-library-hero-title { font-size: 24px; font-weight: 700; }
.playnite-library-hero-source { color: #d6dee8; }
.playnite-library-hero-state { color: #aeb9c6; }
.playnite-library-rail { flex-shrink: 0; min-height: 150px; gap: 12px; }
.playnite-library-grid { gap: 12px; }
.playnite-library-tile { min-height: 150px; }
.playnite-library-actions { flex-shrink: 0; gap: 10px; }
.playnite-library-footer { flex-shrink: 0; flex-wrap: wrap; gap: 6px; }
.playnite-library-warning { flex-shrink: 0; margin: 8px 0 0; }
.playnite-library-playnite { gap: 14px; }
.playnite-library-playnite-card { gap: 10px; padding: 14px; background: #18202a; }
.playnite-library-playnite-token { min-height: 44px; }
