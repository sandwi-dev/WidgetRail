{
  "manifestVersion": 1,
  "id": "widgetrail.samples.playnite-library",
  "publisher": "widgetrail.samples",
  "name": "Playnite Library",
  "version": "0.4.108",
  "pinningSupported": true,
  "hostApi": {
    "minimum": "1.0",
    "maximumMajor": 1
  },
  "entrypoint": {
    "runtime": "full-trust-application-v1",
    "executable": "payload/PlayniteLibraryApplication.exe"
  },
  "presentation": {
    "icon": "play",
    "packageIcon": {
      "assetId": "playnite-library.mark",
      "colorMode": "originalColor"
    }
  },
  "iconAssets": {
    "playnite.home": {
      "path": "assets/icons/house.svg"
    },
    "playnite.library": {
      "path": "assets/icons/library-big.svg"
    },
    "playnite.overview": {
      "path": "assets/icons/info.svg"
    },
    "playnite.information": {
      "path": "assets/icons/list.svg"
    },
    "playnite.links": {
      "path": "assets/icons/link.svg"
    },
    "playnite.achievements": {
      "path": "assets/icons/trophy.svg"
    },
    "playnite.activity": {
      "path": "assets/icons/history.svg"
    },
    "playnite.game-help": {
      "path": "assets/icons/game-help.svg"
    },
    "playnite.discord": { "path": "assets/icons/discord.svg" },
    "playnite.game": {
      "path": "assets/icons/gamepad-2.svg"
    },
    "playnite.back": {
      "path": "assets/icons/arrow-left.svg"
    },
    "playnite.hidden": {
      "path": "assets/icons/eye-off.svg"
    },
    "playnite-library.mark": {
      "path": "assets/icons/playnite-library.svg"
    },
    "playnite.install": {
      "path": "assets/icons/install.svg"
    },
    "playnite.favorite.outline": {
      "path": "assets/icons/heart-outline.svg"
    },
    "playnite.favorite.filled": {
      "path": "assets/icons/heart-filled.svg"
    },
    "playnite.captures": {
      "path": "assets/icons/camera.svg"
    }
  },
  "permissions": [],
  "optionalPermissions": [
    "widgets.summary.read.v1:widgetrail.samples.discord-controls",
    "system.apps.windows.switch.v1",
    "media.capture-library.read.v1",
    "media.capture-library.manage.v1"
  ],
  "intents": {
    "requests": [
      {"id":"widgetrail.summary.action","version":2,"payloadSchema":{"type":"object","additionalProperties":false,"properties":{"token":{"type":"string","minLength":32,"maxLength":32},"reader":{"type":"string","minLength":32,"maxLength":32},"pin":{"type":"boolean"},"microphone":{"type":"boolean"}},"required":["token","reader","pin","microphone"]}},
      {"id":"widgetrail.summary.open","version":1,"payloadSchema":{"type":"object","additionalProperties":false,"properties":{"packageId":{"type":"string","minLength":3,"maxLength":128}},"required":["packageId"]}},
      {"id": "widgetrail.game.help", "version": 1, "payloadSchema": {"type": "object", "additionalProperties": false, "properties": {"gameName": {"type": "string", "minLength": 1, "maxLength": 256}}, "required": ["gameName"]}},
      {
        "id": "widgetrail.web.open",
        "version": 1,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": [
            "url"
          ]
        }
      },
      {
        "id": "widgetrail.captures.browse",
        "payloadSchema": {
          "additionalProperties": false,
          "required": [
            "originPackageId",
            "referenceKind",
            "referenceId",
            "referenceLabel"
          ],
          "properties": {
            "referenceKind": {
              "minLength": 1,
              "type": "string",
              "maxLength": 48
            },
            "originPackageId": {
              "minLength": 3,
              "type": "string",
              "maxLength": 128
            },
            "referenceId": {
              "minLength": 1,
              "type": "string",
              "maxLength": 256
            },
            "referenceLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "type": "object"
        },
        "version": 2
      }
    ],
    "handles": [
      {
        "id": "widgetrail.captures.associate",
        "version": 1,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "captures": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 32
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  }
                },
                "required": [
                  "id",
                  "revision"
                ]
              }
            }
          },
          "required": [
            "captures"
          ]
        },
        "hasDynamicAvailability": true
      },
      {
        "id": "widgetrail.related-item.open",
        "payloadSchema": {
          "additionalProperties": false,
          "required": [
            "packageId",
            "kind",
            "id"
          ],
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string",
              "maxLength": 256
            },
            "packageId": {
              "minLength": 3,
              "type": "string",
              "maxLength": 128
            },
            "kind": {
              "minLength": 1,
              "type": "string",
              "maxLength": 48
            }
          },
          "type": "object"
        },
        "version": 1,
        "hasDynamicAvailability": true
      }
    ]
  },
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "unload-after-idle",
    "idleSeconds": 300
  },
  "resourceRequest": {
    "memoryMb": 48,
    "updateHz": 4
  },
  "architectures": [
    "x64"
  ]
}
