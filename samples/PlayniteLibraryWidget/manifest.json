{
  "manifestVersion": 1,
  "id": "widgetrail.samples.playnite-library",
  "publisher": "widgetrail.samples",
  "name": "Playnite Library",
  "version": "0.2.146",
  "hostApi": { "minimum": "1.0", "maximumMajor": 1 },
  "entrypoint": {
    "runtime": "full-trust-application-v1",
    "executable": "payload/PlayniteLibraryApplication.exe"
  },
  "presentation": {
    "icon": "play",
    "packageIcon": { "assetId": "playnite-library.mark", "colorMode": "originalColor" }
  },
  "iconAssets": {
    "playnite.home": { "path": "assets/icons/house.svg" },
    "playnite.library": { "path": "assets/icons/library-big.svg" },
    "playnite.overview": { "path": "assets/icons/info.svg" },
    "playnite.information": { "path": "assets/icons/list.svg" },
    "playnite.links": { "path": "assets/icons/link.svg" },
    "playnite.achievements": { "path": "assets/icons/trophy.svg" },
    "playnite.activity": { "path": "assets/icons/history.svg" },
    "playnite.game": { "path": "assets/icons/gamepad-2.svg" },
    "playnite.back": { "path": "assets/icons/arrow-left.svg" },
    "playnite.hidden": { "path": "assets/icons/eye-off.svg" },
    "playnite-library.mark": { "path": "assets/icons/playnite-library.svg" },
    "playnite.install": { "path": "assets/icons/install.svg" },
    "playnite.favorite.outline": { "path": "assets/icons/heart-outline.svg" },
    "playnite.favorite.filled": { "path": "assets/icons/heart-filled.svg" }
  },
  "permissions": [],
  "optionalPermissions": [],
  "intents": {
    "requests": [{
      "id": "widgetrail.web.open",
      "version": 1,
      "payloadSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "url": { "type": "string", "minLength": 1, "maxLength": 2048 } },
        "required": ["url"]
      }
    }]
  },
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "unload-after-idle",
    "idleSeconds": 300
  },
  "resourceRequest": { "memoryMb": 48, "updateHz": 4 },
  "architectures": [ "x64" ]
}
