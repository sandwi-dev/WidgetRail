{
  "manifestVersion": 1,
  "id": "widgetrail.samples.playnite-library",
  "publisher": "widgetrail.samples",
  "name": "Playnite Library",
  "version": "0.2.83",
  "hostApi": { "minimum": "1.0", "maximumMajor": 1 },
  "entrypoint": {
    "runtime": "full-trust-application-v1",
    "executable": "payload/PlayniteLibraryApplication.exe"
  },
  "presentation": {
    "icon": "play",
    "packageIcon": { "assetId": "playnite-library.mark", "colorMode": "originalColor" }
  },
  "iconAssets": {
    "playnite-library.mark": { "path": "assets/icons/playnite-library.svg" }
  },
  "permissions": [],
  "optionalPermissions": [],
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "unload-after-idle",
    "idleSeconds": 300
  },
  "resourceRequest": { "memoryMb": 48, "updateHz": 4 },
  "architectures": [ "x64" ]
}
