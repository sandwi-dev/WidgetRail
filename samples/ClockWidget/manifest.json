{
  "manifestVersion": 1,
  "id": "widgetrail.samples.clock",
  "publisher": "widgetrail.samples",
  "name": "Clock",
  "version": "0.1.0",
  "hostApi": {
    "minimum": "1.0",
    "maximumMajor": 1
  },
  "entrypoint": {
    "runtime": "dotnet-worker",
    "assembly": "payload/ClockWidget.dll",
    "type": "WidgetRail.Samples.ClockWidget.ClockWidget"
  },
  "permissions": [],
  "optionalPermissions": [],
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "unload-after-idle",
    "idleSeconds": 300
  },
  "resourceRequest": {
    "memoryMb": 32,
    "updateHz": 1
  },
  "architectures": [
    "x64",
    "arm64"
  ]
}
