.background-surface-test-root {
  width: 100%;
  height: 100%;
  min-width: 0px;
  min-height: 0px;
  object-fit: cover;
  object-position: center;
  corner-radius: 14px;
}

.background-surface-test-foreground {
  width: 100%;
  height: 100%;
  min-width: 0px;
  min-height: 0px;
  padding: 24px;
  gap: 10px;
  justify: end;
  background: transparent;
  color: var(--text);
}

.background-surface-test-text {
  max-lines: 2;
}
