{
  "manifestVersion": 1,
  "id": "widgetrail.samples.discord-controls",
  "publisher": "widgetrail.samples",
  "name": "Discord",
  "version": "0.1.0.20",
  "pinningSupported": true,
  "hostApi": {
    "minimum": "1.0",
    "maximumMajor": 1
  },
  "entrypoint": {
    "runtime": "full-trust-application-v1",
    "executable": "payload/DiscordWebViewWidget.exe"
  },
  "presentation": {
    "packageIcon": {
      "assetId": "discord.mark",
      "colorMode": "originalColor"
    },
    "icon": "connection"
  },
  "permissions": [],
  "optionalPermissions": [
    "system.apps.windows.capture.v1"
  ],
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "keep-alive"
  },
  "architectures": [
    "x64"
  ],
  "iconAssets": {
    "discord.mark": {
      "path": "assets/icons/discord.svg"
    },
    "discord.manage-pin": {
      "path": "assets/icons/manage-pin.svg"
    },
    "discord.info": {
      "path": "assets/icons/info.svg"
    },
    "discord.refresh": {
      "path": "assets/icons/refresh.svg"
    },
    "discord.latest": {
      "path": "assets/icons/latest.svg"
    },
    "discord.pin": {
      "path": "assets/icons/pin.svg"
    },
    "discord.channels": {
      "path": "assets/icons/channels.svg"
    },
    "discord.share": {
      "path": "assets/icons/share.svg"
    },
    "discord.microphone": {
      "path": "assets/icons/microphone.svg"
    },
    "discord.person": {
      "path": "assets/icons/person.svg"
    },
    "discord.muted": {
      "path": "assets/icons/muted.svg"
    },
    "discord.voice": {
      "path": "assets/icons/voice.svg"
    },
    "discord.screen": {
      "path": "assets/icons/screen.svg"
    },
    "discord.watching": {
      "path": "assets/icons/watching.svg"
    },
    "discord.activity": {
      "path": "assets/icons/activity.svg"
    },
    "discord.home": {
      "path": "assets/icons/home.svg"
    },
    "discord.account": {
      "path": "assets/icons/account.svg"
    },
    "discord.leave": {
      "path": "assets/icons/leave.svg"
    }
  },
  "intents": {
    "handles": [
      {
        "id": "widgetrail.web.notification.open",
        "version": 1,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sessionId": { "type": "string", "minLength": 32, "maxLength": 32 },
            "tag": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          "required": [ "sessionId", "tag" ]
        },
        "hasDynamicAvailability": false
      },
      {
        "id": "widgetrail.files.share",
        "version": 1,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "offerId": {
              "type": "string",
              "minLength": 32,
              "maxLength": 32
            }
          },
          "required": [
            "offerId"
          ]
        },
        "hasDynamicAvailability": false
      }
    ],
    "requests": [
      {
        "id": "widgetrail.web.open",
        "version": 1,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": [
            "url"
          ]
        }
      }
    ]
  }
}
