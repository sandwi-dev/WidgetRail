/* The host supplies palette and material fallbacks, including high contrast. */
.discord-root { width:100%; height:100%; min-width:0px; min-height:0px; padding:20px; gap:16px; color:var(--text); background:transparent; }
.discord-body, .discord-list { width:100%; min-width:0px; min-height:0px; flex-grow:1; }
.discord-page { width:100%; min-width:0px; min-height:0px; flex-grow:1; gap:8px; }
.discord-header { width:100%; min-width:0px; align:center; gap:10px; padding:0px 2px 14px; border-bottom-width:1px; border-bottom-color:var(--border, var(--surface-muted)); }
.discord-brand { width:32px; height:32px; color:var(--data-purple); flex-grow:0; }
.discord-title { font-family:var(--font-display, Segoe UI); font-size:24px; font-weight:700; color:var(--text); line-height:1.25; max-lines:1; }
.discord-copy { min-width:0px; flex-grow:1; gap:3px; }
.discord-card { width:100%; min-width:0px; padding:14px; gap:12px; background:var(--surface-raised); border-color:var(--border, var(--surface-muted)); border-width:1px; corner-radius:14px; }
.discord-actions { min-width:0px; align:center; gap:8px; flex-grow:0; }
.discord-section-header { width:100%; min-width:0px; align:center; gap:8px; padding:0px 2px; }
.discord-section-title { color:var(--text); font-size:18px; font-weight:600; line-height:1.3; max-lines:2; }
.discord-secondary { color:var(--text-muted); font-size:13px; line-height:1.35; max-lines:2; text-overflow:ellipsis; }
.discord-row-title { color:var(--text); font-size:15px; font-weight:600; line-height:1.3; max-lines:1; text-overflow:ellipsis; }
.discord-row { width:100%; min-width:0px; min-height:60px; padding:10px 14px; margin:3px 2px; gap:12px; align:center; background:var(--surface-raised); border-color:var(--border, var(--surface-muted)); border-width:1px; corner-radius:10px; }
.discord-row:selected { background:var(--surface-active, var(--surface-muted)); border-color:var(--accent); }
.discord-row:focused { outline-color:var(--focus); outline-width:var(--focus-width, 2px); outline-offset:-2px; border-color:var(--text); }
.discord-row:pressed { background:var(--surface-active, var(--surface-muted)); }
.discord-row-icon { width:24px; height:24px; flex-grow:0; color:var(--text-muted); }
.discord-avatar { width:32px; height:32px; min-width:32px; min-height:32px; flex-grow:0; color:var(--text-muted); corner-radius:16px; overflow:clip; }
.discord-row-state { color:var(--text-muted); font-size:12px; font-weight:600; max-width:96px; max-lines:2; text-align:end; }
.discord-control { min-width:0px; min-height:40px; flex-grow:0; padding:8px 10px; font-size:13px; font-weight:600; background:var(--surface-raised); color:var(--text); border-color:var(--border, var(--surface-muted)); border-width:1px; corner-radius:9px; }
.discord-control:selected { background:var(--surface-active, var(--surface-muted)); border-color:var(--accent); }
.discord-control:focused, .discord-toolbar-button:focused { outline-color:var(--focus); outline-width:var(--focus-width, 2px); outline-offset:-2px; border-color:var(--text); }
.discord-control:pressed { background:var(--surface-active, var(--surface-muted)); }
.discord-control:disabled { color:var(--text-subdued, var(--text-muted)); border-color:var(--border, var(--surface-muted)); }
.discord-primary { background:alpha(var(--data-purple), .14); border-color:alpha(var(--data-purple), .65); color:var(--data-purple); }
.discord-primary:pressed { background:alpha(var(--data-purple), .24); }
.discord-primary:disabled { background:var(--surface-muted); color:var(--text-muted); border-color:var(--border, var(--surface-muted)); }
.discord-toolbar-button { width:38px; min-width:38px; height:38px; min-height:38px; padding:8px; flex-grow:0; background:transparent; color:var(--text-muted); border-width:1px; border-color:transparent; corner-radius:9px; }
.discord-empty { width:100%; min-width:0px; padding:22px 18px; gap:8px; background:var(--surface-raised); border-color:var(--border, var(--surface-muted)); border-width:1px; corner-radius:12px; }
.discord-empty-icon { width:30px; height:30px; color:var(--text-muted); }
.discord-page-scroll { width:100%; min-width:0px; min-height:0px; flex-grow:1; gap:16px; padding:4px; }
.discord-search { min-width:0px; flex-grow:1; min-height:40px; }
.discord-notice { color:var(--text); font-size:13px; padding:8px 12px; background:var(--surface-raised); border-color:var(--border, var(--surface-muted)); border-width:1px; corner-radius:8px; max-lines:3; }
.discord-pin { width:100%; height:100%; min-width:0px; min-height:0px; gap:10px; padding:12px; justify:center; background:transparent; }
.discord-video { width:100%; height:100%; min-width:0px; min-height:0px; }
.discord-stream-pin { width:100%; height:100%; min-width:0px; min-height:0px; gap:0px; background:transparent; color:var(--text); }
.discord-video-pane { width:100%; min-width:0px; min-height:0px; flex-grow:1; }
.discord-audio-row { width:100%; min-width:0px; gap:8px; align:center; }
.discord-audio-volume { min-width:0px; min-height:36px; padding:0px; flex-grow:1; }
.discord-audio-mute { width:32px; min-width:32px; height:32px; min-height:32px; padding:4px; flex-grow:0; color:var(--text); background:transparent; border-width:0px; corner-radius:6px; }
.discord-audio-mute:focused { outline-color:var(--focus); outline-width:var(--focus-width, 2px); outline-offset:-2px; }
.discord-audio-mute:selected { color:var(--text-muted); }
.discord-audio-value { min-width:34px; flex-grow:0; color:var(--text-muted); font-size:12px; text-align:end; max-lines:1; }
.discord-columns { gap:24px; }
.discord-primary-pane { min-width:0px; min-height:0px; flex-grow:1; gap:20px; padding:4px 16px 4px 4px; }
.discord-main-content { min-width:0px; min-height:0px; flex-grow:0; }
.discord-call-content { width:100%; min-width:0px; gap:16px; }
.discord-activity-pane { width:260px; min-width:0px; min-height:0px; gap:14px; padding:4px 0px 0px 18px; border-left-width:1px; border-left-color:var(--border, var(--surface-muted)); }
.discord-activity-compact { width:100%; min-width:0px; min-height:0px; flex-grow:0; gap:8px; padding:16px 0px 0px; border-top-width:1px; border-top-color:var(--border, var(--surface-muted)); }
.discord-activity-compact-list { min-width:0px; min-height:0px; height:240px; }
.discord-call-heading { gap:4px; min-width:0px; }
.discord-call-title { font-family:var(--font-display, Segoe UI); font-size:26px; font-weight:700; color:var(--text); max-lines:1; text-overflow:ellipsis; }
.discord-connected { font-size:12px; font-weight:600; color:var(--data-green); }
.discord-call-actions { width:100%; min-width:0px; gap:8px; }
.discord-participants { width:100%; min-width:0px; height:88px; min-height:88px; gap:10px; padding:4px 0px; }
.discord-person { padding:10px; gap:10px; align:center; min-width:168px; corner-radius:12px; width:168px; height:72px; min-height:72px; margin:0px 6px 0px 0px; background:var(--surface-raised); border-width:1px; border-color:var(--border, var(--surface-muted)); }
.discord-avatar-frame, .discord-avatar-speaking { width:40px; min-width:40px; height:40px; min-height:40px; padding:2px; corner-radius:20px; border-width:2px; border-color:transparent; align:center; justify:center; flex-grow:0; }
.discord-avatar-speaking { border-color:var(--data-green); }
.discord-person-state { width:16px; min-width:16px; height:16px; min-height:16px; margin:0px 2px 0px 0px; flex-grow:0; color:var(--text-muted); }
.discord-person:focused, .discord-stream-action:focused, .discord-activity-row:focused { outline-color:var(--focus); outline-width:var(--focus-width, 2px); outline-offset:-2px; }
.discord-stream-card { width:100%; min-width:0px; padding:14px; gap:10px; background:var(--surface-raised); border-width:1px; border-color:var(--border, var(--surface-muted)); corner-radius:12px; }
.discord-stream-action { min-width:0px; flex-grow:1; gap:12px; padding:4px; align:center; corner-radius:8px; border-width:0px; background:transparent; }
.discord-stream-header { width:100%; min-width:0px; gap:8px; align:center; }
.discord-stream-tools { width:100%; min-width:0px; justify:end; }
.discord-stream-stop { min-height:28px; padding:4px 8px; font-size:12px; }
.discord-pin-toggle:selected { color:var(--data-purple); background:alpha(var(--data-purple), .12); border-color:alpha(var(--data-purple), .3); }
.discord-stream-icon { width:32px; height:32px; color:var(--data-purple); }
.discord-stream-audio { width:100%; min-width:0px; gap:6px; padding:8px 0px 0px; border-top-width:1px; border-top-color:var(--border, var(--surface-muted)); }
.discord-activity-row { width:100%; min-width:0px; padding:10px; gap:6px; corner-radius:10px; align:stretch; text-align:start; }
.discord-activity-header, .discord-activity-copy { width:100%; min-width:0px; text-align:start; }
.discord-activity-row:selected, .discord-activity-row:pressed, .discord-stream-action:pressed { background:var(--surface-active, var(--surface-muted)); }
.discord-activity-action { font-size:13px; font-weight:600; color:var(--data-purple); }
.discord-quiet { background:transparent; border-color:transparent; }
.discord-leave { color:var(--data-red); background:alpha(var(--data-red), .06); border-color:alpha(var(--data-red), .25); }
.discord-server { width:100%; min-width:0px; }
.discord-voice-pin { width:100%; height:100%; min-width:0px; min-height:0px; padding:12px; gap:10px; justify:space-between; color:var(--text); background:transparent; }
.discord-voice-heading { width:100%; min-width:0px; gap:10px; align:start; }
.discord-voice-icon { width:24px; height:24px; color:var(--data-purple); min-width:24px; margin:2px 0px 0px; }
.discord-voice-title { font-size:18px; font-weight:600; max-lines:1; text-overflow:ellipsis; }
.discord-voice-count { font-size:11px; color:var(--text-muted); max-lines:1; flex-grow:0; padding:3px 0px; }
.discord-voice-list { width:100%; min-width:0px; padding:0px; }
.discord-people-overlay { width:100%; min-width:0px; min-height:0px; padding:4px; gap:8px; align:start; background:transparent; }
.discord-overlay-person { max-width:100%; min-width:0px; min-height:40px; align:center; gap:8px; }
.discord-overlay-label { min-width:0px; max-width:100%; min-height:28px; padding:4px 10px; align:center; gap:6px; background:rgba(20, 20, 23, .88); corner-radius:16px; }
.discord-overlay-name { min-width:0px; max-width:150px; font-family:Segoe UI; font-size:16px; font-weight:600; line-height:1.25; color:#f2f3f5; max-lines:1; text-overflow:ellipsis; }
.discord-overlay-status { width:16px; min-width:16px; height:16px; min-height:16px; flex-grow:0; color:#c4c5c9; }
.discord-overlay-live { padding:2px 5px; corner-radius:5px; background:#d83c3e; flex-grow:0; }
.discord-overlay-live-label { font-size:10px; font-weight:700; color:#ffffff; max-lines:1; }
.discord-overlay-watching { width:18px; min-width:18px; height:18px; color:#f2f3f5; flex-grow:0; }
.discord-voice-avatar-frame { width:30px; min-width:30px; height:30px; min-height:30px; padding:2px; corner-radius:15px; border-width:2px; border-color:transparent; align:center; justify:center; flex-grow:0; }
.discord-voice-speaking { border-color:var(--data-green); }
.discord-overlay-avatar { width:40px; min-width:40px; height:40px; min-height:40px; padding:0px; border-width:2px; corner-radius:20px; background:transparent; }
.discord-overlay-avatar-image { width:36px; min-width:36px; height:36px; min-height:36px; corner-radius:18px; }
.discord-voice-actions { width:100%; min-width:0px; }
.discord-voice-button { width:100%; min-width:0px; min-height:40px; padding:8px 4px; font-size:12px; }
.discord-voice-toggle:selected { color:var(--data-purple); background:alpha(var(--data-purple), .12); border-color:alpha(var(--data-purple), .45); }

.discord-voice-dialog { width:100%; min-width:0px; gap:14px; padding:4px; }
.discord-voice-select, .discord-voice-volume { width:100%; min-width:0px; gap:6px; }
.discord-connection-ready { color:var(--data-green); }
.discord-connection-pending { color:var(--text-muted); }
.discord-connection-history { width:100%; height:90px; min-height:90px; color:var(--data-green); }

/* Unified call surface: destination, call actions, then a bounded people rail. */
.discord-call-panel { width:100%; min-width:0px; padding:16px; gap:12px; background:var(--surface-raised); border-width:1px; border-color:alpha(var(--data-purple), .24); corner-radius:16px; }
.discord-call-header { width:100%; min-width:0px; align:center; gap:12px; }
.discord-call-emblem { width:32px; height:32px; min-width:32px; color:var(--data-purple); }
.discord-call-toggle:selected { color:var(--data-purple); background:alpha(var(--data-purple), .14); border-color:alpha(var(--data-purple), .5); }
.discord-person-self { font-size:11px; color:var(--text-muted); max-lines:1; }
.discord-leave:pressed { background:alpha(var(--data-red), .14); }
.discord-voice-summary { width:100%; min-width:0px; gap:8px; }
.discord-voice-guild { font-size:11px; color:var(--text-muted); max-lines:1; text-overflow:ellipsis; }

.discord-participant-preview { gap: 12px; min-width: 0px; }
.discord-participant-preview-heading { gap: 10px; align: center; }
