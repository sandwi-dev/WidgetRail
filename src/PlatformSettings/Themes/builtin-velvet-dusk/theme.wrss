/* Velvet Dusk — A quiet evening library: desaturated violet surfaces, lavender interaction, and Georgia display headings. Compact labels remain sentence-case Segoe UI so expressive type never crowds controller controls.

   Global defaults only: explicit widget styles and host accessibility policy
   remain authoritative. Inherit the baseline's spacing, target sizes, state
   fills and motion; do not replace them with broad role declarations. */

:root {
  --canvas: #191622;
  --canvas-veil: rgba(15, 10, 24, 0.72);
  --surface: #252030;
  --surface-raised: #302a3d;
  --modal-surface: #302a3d;
  --surface-subtle: #3a3248;
  --surface-active: #493f59;
  --surface-muted: #3a3248;
  --border: #72647f;
  --border-strong: #9a89ab;
  --text: #f6f0fa;
  --text-muted: #d0c2da;
  --text-subdued: #a99ab5;
  --accent: #d9c0ff;
  --focus: var(--accent);
  --controller-glyph-color: #cbbbe2;
  --scrollbar-track: #3a3248;
  --scrollbar-thumb: #d0c2da;
  --success: #ade4c5;
  --info: #b9ddff;
  --warning: #f6d79d;
  --danger: #ffb9cf;
  --error: var(--danger);
  --scrim: rgba(15, 10, 24, 0.72);
  --poster-scrim: rgba(25, 22, 34, 0.94);
  --font-text: Segoe UI;
  --font-display: Georgia, Times New Roman, Segoe UI;
  --panel-shading: .015;
  --control-shading: .020;
  --focus-shading: .025;
  --inset-shading: -.020;
  --depth-shadow: rgba(14, 7, 25, 0.24);
  --depth-highlight: rgba(242, 222, 255, 0.08);
  --depth-lowlight: rgba(10, 4, 20, 0.22);
  --focus-width: 2px;
  --focus-offset: -2px;
  /* Categorical data ink; independent of status and focus meanings. */
  --data-red: #ffb9cf;
  --data-blue: #b9ddff;
  --data-green: #ade4c5;
  --data-gold: #f6d79d;
  --data-purple: #dbc1fa;
  --data-orange: #efc09c;

}

/* Three nested radius levels give containers and controls distinct roles. */
panel, tray,
.wrail-dialog, .wrail-action-sheet, .wrail-picker, .wrail-modal { corner-radius: 18px; }

tray-item, button, select, slider,
.wrail-icon-button, .wrail-icon-button--small, .wrail-icon-button--large,
.wrail-card, .wrail-switch, .wrail-stepper__button { corner-radius: 8px; }

.wrail-segmented-tabs, .wrail-navigation-shell__compact,
.wrail-navigation-shell__rail, .wrail-alert, .wrail-empty-state,
.wrail-toast, .wrail-action-surface,
.wrail-poster-tile, .wrail-poster-tile__artwork { corner-radius: 8px; }

.wrail-segmented-tabs__tab, .wrail-navigation-shell__compact-item,
.wrail-navigation-shell__rail-item, .wrail-settings-row__action,
.wrail-action-sheet__item, .wrail-picker__option, .wrail-choice-row,
.wrail-scrubber__slider, .wrail-badge, .wrail-tile__artwork,
.wrail-code-text { corner-radius: 4px; }

/* Retain the type scale and line limits; hierarchy comes from family/weight. */
title, .wrail-section-header__title, .wrail-dialog__title,
.wrail-action-sheet__title, .wrail-picker__title, .wrail-modal__title {
  font-family: var(--font-display);
  font-weight: 400;
  letter-spacing: 0em;
}

/* Selection keeps its fill; the short edge survives when focus moves away. */
.wrail-segmented-tabs__tab--selected {
  border-bottom-color: var(--accent);
  border-bottom-width: 2px;
}
.wrail-navigation-shell__item--selected,
.wrail-choice-row--selected, .wrail-picker__option--selected {
  border-left-color: var(--accent);
  border-left-width: 2px;
}
