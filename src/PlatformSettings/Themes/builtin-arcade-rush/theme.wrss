/* Arcade Rush keeps its plum ground and pink interaction. Rounded rectangles
   replace pill-shaped text controls; circular icon buttons remain playful.
   State fills, controller targets and motion stay inherited from the baseline. */

:root {
  --panel-shading: .040;
  --control-shading: .035;
  --focus-shading: .045;
  --inset-shading: -0.035;
  --depth-shadow: rgba(11, 4, 17, 0.36);
  --depth-highlight: rgba(255, 211, 241, 0.10);
  --depth-lowlight: rgba(0, 0, 0, 0.18);
  --focus-width: 2px;
  --focus-offset: -2px;

  /* A plum ground, not a black one: the shell reads as warm even before any
     accent lands on it. The four-step surface ramp keeps its separation. */
  --canvas: #1a1020;
  --canvas-veil: rgba(14, 8, 18, 0.72);
  --surface: rgba(36, 23, 48, 0.98);
  --surface-raised: rgba(46, 30, 60, 0.98);
  --modal-surface: rgba(46, 30, 60, 0.96);
  --surface-subtle: rgba(56, 37, 72, 0.94);
  --surface-active: rgba(72, 48, 92, 0.98);
  --surface-muted: rgba(56, 37, 72, 0.92);

  /* Hairlines pick up the warm cast rather than a cool one. */
  --border: rgba(255, 226, 245, 0.14);
  --border-strong: rgba(255, 226, 245, 0.28);

  --text: #f6eef8;
  --text-muted: #d5c1dd;
  --controller-glyph-color: #dba6cf;
  --scrollbar-track: #463149;
  --scrollbar-thumb: #d58dba;
  --text-subdued: #ac96b8;

  /* The accent edge reinforces the raised focused surface. */
  --focus: var(--accent);

  /* A readable pink carries progress, sliders, primary
     icon buttons, and tile state; nothing else in the theme shouts, so the
     semantic trio below stays readable as status rather than decoration. */
  --accent: #ffa6d2;

  --success: #a2e7c2;
  --info: #aad9ff;
  --warning: #f5d493;
  --danger: #ffb4a1;
  --error: var(--danger);

  --scrim: rgba(14, 8, 18, 0.62);
  --poster-scrim: rgba(20, 12, 24, 0.86);

  --font-text: Segoe UI Variable Text, Segoe UI;
  --font-display: Segoe UI Variable Display, Segoe UI;
  /* Categorical data ink; independent of status and focus meanings. */
  --data-red: #ffb4a1;
  --data-blue: #aad9ff;
  --data-green: #a2e7c2;
  --data-gold: #f5d493;
  --data-purple: #ddbbff;
  --data-orange: #ffc49d;

}

/* Soft control corners preserve the 44 DIP hit targets and focus geometry. */
panel,
tray,
.wrail-dialog,
.wrail-action-sheet,
.wrail-picker { corner-radius: 14px; }

tray-item,
button,
select,
slider,
.wrail-switch,
.wrail-stepper__button,
.wrail-segmented-tabs__tab,
.wrail-navigation-shell__compact-item,
.wrail-navigation-shell__rail-item,
.wrail-settings-row__action,
.wrail-action-sheet__item,
.wrail-picker__option,
.wrail-choice-row,
.wrail-scrubber__slider { corner-radius: 12px; }

.wrail-icon-button { corner-radius: 23px; }
.wrail-icon-button--small { corner-radius: 22px; }
.wrail-icon-button--large { corner-radius: 26px; }

/* Nested control containers add their padding to the inner radius. */
.wrail-segmented-tabs,
.wrail-navigation-shell__compact { corner-radius: 15px; }
.wrail-navigation-shell__rail { corner-radius: 14px; }

.wrail-card,
.wrail-alert,
.wrail-empty-state,
.wrail-toast,
.wrail-action-surface { corner-radius: 16px; }

.wrail-tile__artwork,
.wrail-poster-tile,
.wrail-poster-tile__artwork { corner-radius: 14px; }

.wrail-badge { corner-radius: 12px; }
.wrail-code-text { corner-radius: 12px; }
progress { corner-radius: 2px; }

/* Sentence-case typography stays quiet so pink interaction carries emphasis. */
title { font-weight: 600; letter-spacing: -0.005em; }
.wrail-section-header__title,
.wrail-dialog__title,
.wrail-action-sheet__title,
.wrail-picker__title { font-weight: 600; letter-spacing: -0.005em; }

.wrail-section-header__eyebrow {
  font-weight: 700;
  letter-spacing: 0.02em;
  text-transform: none;
}

.wrail-badge__label { font-weight: 600; letter-spacing: 0.02em; }
.wrail-window-preview {
  width: 100%; min-width: 0; overflow: clip;
  background: var(--surface); color: var(--text-muted);
  corner-radius: 6px; font-size: 12px; text-align: center;
}
.wrail-preview-poster { gap: 8px; min-width: 0; }

/* Widget modal: host-clamped geometry, theme-owned colors and typography. */
.wrail-modal-layer { background: var(--canvas-veil); }
.wrail-modal {
  width: 760px; height: 640px; padding: 20px; gap: 16px;
  background: var(--modal-surface); color: var(--text);
  border-color: var(--border-strong); border-width: 1px; corner-radius: 16px;
  shadow-color: rgba(0, 0, 0, 0.45); shadow-blur: 20px; overflow: clip;
}
.wrail-modal__header { direction: row; align: center; gap: 20px; }
.wrail-modal__title { font-size: 26px; font-weight: 600; flex-grow: 1; min-width: 0; max-lines: 2; text-overflow: ellipsis; overflow-wrap: anywhere; }
.wrail-modal__scroll { flex-grow: 1; min-height: 0; min-width: 0; gap: 12px; padding: 4px; }
