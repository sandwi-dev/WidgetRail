:root {
  --canvas: #080d14;
  --canvas-veil: rgba(2, 6, 12, 0.72);
  --surface: rgba(15, 23, 34, 0.98);
  --surface-raised: rgba(22, 32, 45, 0.98);
  --surface-subtle: rgba(30, 42, 58, 0.94);
  --surface-active: rgba(39, 54, 72, 0.98);
  --border: rgba(219, 230, 240, 0.12);
  --border-strong: rgba(219, 230, 240, 0.22);
  --text: #edf2f7;
  --controller-glyph-color: #9fb7d0;
  --text-muted: #a3afbd;
  --scrollbar-track: #303b49;
  --scrollbar-thumb: #a3afbd;
  --text-subdued: #74808d;
  --focus: #f1f4f7;
  --accent: #8ca9c4;
  --success: #8eb19f;
  --info: #8ca9c4;
  --warning: #c1a36f;
  --danger: #c9868b;
  --font-text: Segoe UI Variable Text, Segoe UI;
  --font-display: Segoe UI Variable Display, Segoe UI;
}
