:root {
  --panel-shading: .030;
  --control-shading: .035;
  --focus-shading: .045;
  --inset-shading: -0.035;
  --depth-shadow: rgba(0, 7, 20, 0.32);
  --depth-highlight: rgba(210, 230, 255, 0.09);
  --depth-lowlight: rgba(0, 0, 0, 0.18);
  --focus-width: 2px;
  --focus-offset: -2px;

  --canvas: #080d14;
  --canvas-veil: rgba(2, 6, 12, 0.72);
  --surface: rgba(15, 23, 34, 0.98);
  --surface-raised: rgba(22, 32, 45, 0.98);
  --modal-surface: rgba(22, 32, 45, 0.96);
  --surface-subtle: rgba(30, 42, 58, 0.94);
  --surface-active: rgba(39, 54, 72, 0.98);
  --border: rgba(219, 230, 240, 0.12);
  --border-strong: rgba(219, 230, 240, 0.22);
  --text: #edf2f7;
  --controller-glyph-color: #9fb7d0;
  --text-muted: #bfccd9;
  --scrollbar-track: #303b49;
  --scrollbar-thumb: #a3afbd;
  --text-subdued: #92a2b3;
  --focus: var(--accent);
  --accent: #acc9df;
  --success: #aad4bf;
  --info: #acc9df;
  --warning: #e4c58a;
  --danger: #e8adb5;
  --surface-muted: var(--surface-subtle);
  --error: var(--danger);
  --scrim: var(--canvas-veil);
  --font-text: Segoe UI Variable Text, Segoe UI;
  --font-display: Segoe UI Variable Display, Segoe UI;
  /* Categorical data ink; independent of status and focus meanings. */
  --data-red: #e8adb5;
  --data-blue: #acc9df;
  --data-green: #aad4bf;
  --data-gold: #e4c58a;
  --data-purple: #c4b4e4;
  --data-orange: #e8b78f;

}

/* Widget modal: host-clamped geometry, theme-owned colors and typography. */
.wrail-modal-layer { background: var(--canvas-veil); }
.wrail-modal {
  width: 760px; height: 640px; padding: 20px; gap: 16px;
  background: var(--modal-surface); color: var(--text);
  border-color: var(--border-strong); border-width: 1px; corner-radius: 16px;
  shadow-color: rgba(0, 0, 0, 0.45); shadow-blur: 20px; overflow: clip;
}
.wrail-modal__header { direction: row; align: center; gap: 20px; }
.wrail-modal__title { font-size: 26px; font-weight: 600; flex-grow: 1; min-width: 0; max-lines: 2; text-overflow: ellipsis; overflow-wrap: anywhere; }
.wrail-modal__scroll { flex-grow: 1; min-height: 0; min-width: 0; gap: 12px; padding: 4px; }
