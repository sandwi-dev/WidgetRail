/* Canopy — A low-distraction woodland instrument panel: evergreen surfaces, pale sage interaction, and soft rectangular controls. Teal status ink stays separate from the sage accent.

   Global defaults only: explicit widget styles and host accessibility policy
   remain authoritative. Inherit the baseline's spacing, target sizes, state
   fills and motion; do not replace them with broad role declarations. */

:root {
  --canvas: #0c1713;
  --canvas-veil: rgba(4, 14, 9, 0.72);
  --surface: #14261e;
  --surface-raised: #1b3026;
  --modal-surface: #1b3026;
  --surface-subtle: #22392e;
  --surface-active: #304b3e;
  --surface-muted: #22392e;
  --border: #50685a;
  --border-strong: #829b88;
  --text: #eef5ec;
  --text-muted: #bfcebf;
  --text-subdued: #93a797;
  --accent: #b4deb0;
  --focus: var(--accent);
  --controller-glyph-color: #c6d9b5;
  --scrollbar-track: #22392e;
  --scrollbar-thumb: #bfcebf;
  --success: #6fe9cf;
  --info: #a8d5f2;
  --warning: #eed38a;
  --danger: #ffb6b5;
  --error: var(--danger);
  --scrim: rgba(4, 14, 9, 0.72);
  --poster-scrim: rgba(12, 23, 19, 0.94);
  --font-text: Segoe UI;
  --font-display: Segoe UI;
  --panel-shading: .015;
  --control-shading: .020;
  --focus-shading: .025;
  --inset-shading: -.020;
  --depth-shadow: rgba(0, 10, 5, 0.24);
  --depth-highlight: rgba(219, 246, 219, 0.08);
  --depth-lowlight: rgba(0, 8, 3, 0.24);
  --focus-width: 2px;
  --focus-offset: -2px;
  /* Categorical data ink; independent of status and focus meanings. */
  --data-red: #ffb6b5;
  --data-blue: #a8d5f2;
  --data-green: #6fe9cf;
  --data-gold: #eed38a;
  --data-purple: #d0b9ed;
  --data-orange: #edbd94;

}

/* Three nested radius levels give containers and controls distinct roles. */
panel, tray,
.wrail-dialog, .wrail-action-sheet, .wrail-picker, .wrail-modal { corner-radius: 16px; }

tray-item, button, select, slider, scroll,
.wrail-icon-button, .wrail-icon-button--small, .wrail-icon-button--large,
.wrail-card, .wrail-switch, .wrail-stepper__button { corner-radius: 10px; }

.wrail-segmented-tabs, .wrail-navigation-shell__compact,
.wrail-navigation-shell__rail, .wrail-alert, .wrail-empty-state,
.wrail-toast, .wrail-action-surface,
.wrail-poster-tile, .wrail-poster-tile__artwork { corner-radius: 10px; }

.wrail-segmented-tabs__tab, .wrail-navigation-shell__compact-item,
.wrail-navigation-shell__rail-item, .wrail-settings-row__action,
.wrail-action-sheet__item, .wrail-picker__option, .wrail-choice-row,
.wrail-scrubber__slider, .wrail-badge, .wrail-tile__artwork,
.wrail-code-text { corner-radius: 6px; }

/* Retain the type scale and line limits; hierarchy comes from family/weight. */
title, .wrail-section-header__title, .wrail-dialog__title,
.wrail-action-sheet__title, .wrail-picker__title, .wrail-modal__title {
  font-family: var(--font-display);
  font-weight: 600;
  letter-spacing: 0em;
}

/* Selection keeps its fill; the short edge survives when focus moves away. */
.wrail-segmented-tabs__tab--selected {
  border-bottom-color: var(--accent);
  border-bottom-width: 2px;
}
.wrail-navigation-shell__item--selected,
.wrail-choice-row--selected, .wrail-picker__option--selected {
  border-left-color: var(--accent);
  border-left-width: 2px;
}
