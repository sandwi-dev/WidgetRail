:root {
  --canvas: #090908;
  --canvas-veil: rgba(0, 0, 0, 0.70);
  --surface: rgba(21, 21, 20, 0.98);
  --surface-raised: rgba(29, 29, 27, 0.98);
  --surface-subtle: rgba(39, 39, 36, 0.92);
  --surface-active: rgba(48, 47, 43, 0.98);
  --border: rgba(246, 240, 226, 0.12);
  --border-strong: rgba(246, 240, 226, 0.22);
  --text: #f2efe8;
  --text-muted: #aaa69d;
  --text-subdued: #7d7a72;
  --focus: #f4f0e8;
  --accent: #b8ae92;
  --success: #8eb49a;
  --info: #96aeb8;
  --warning: #c8a66a;
  --danger: #c98181;
  --font-text: Segoe UI Variable Text, Segoe UI;
  --font-display: Segoe UI Variable Display, Segoe UI;
}

canvas {
  background: var(--canvas);
  color: var(--text);
  font-family: var(--font-text);
}
backdrop { background: var(--canvas-veil); }
panel,
tray {
  background: var(--surface);
  color: var(--text);
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 12px;
}
tray-item {
  min-width: 44px;
  min-height: 44px;
  background: transparent;
  color: var(--text-muted);
  corner-radius: 10px;
}
tray-item:selected { background: var(--surface-active); color: var(--text); }
tray-item:focused {
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

title {
  color: var(--text);
  font-family: var(--font-display);
  font-size: 28px;
  font-weight: 500;
  line-height: 1.12;
}
body {
  color: var(--text);
  font-family: var(--font-text);
  font-size: 15px;
  font-weight: 400;
  line-height: 1.35;
}
hint {
  color: var(--text-muted);
  font-family: var(--font-text);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.3;
}

button {
  min-height: 44px;
  padding: 10px 14px;
  background: var(--surface-raised);
  color: var(--text);
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 10px;
  font-family: var(--font-text);
  font-size: 15px;
  font-weight: 400;
  scale: 0.99;
  transition-duration: 90ms;
  transition-easing: ease-out;
}
button:selected {
  background: var(--surface-active);
  border-color: var(--border-strong);
}
button:focused {
  background: var(--surface-active);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
  scale: 1;
}
progress {
  min-height: 4px;
  background: var(--surface-active);
  color: var(--accent);
  corner-radius: 2px;
}
slider {
  min-height: 44px;
  padding: 8px 10px;
  background: var(--surface-subtle);
  color: var(--accent);
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 10px;
  scale: 0.99;
  transition-duration: 90ms;
  transition-easing: ease-out;
}
slider:focused {
  background: var(--surface-active);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
  scale: 1;
}

.gbar-scrubber {
  min-width: 0;
  gap: 2px;
  background: transparent;
  border-width: 0;
}
.gbar-scrubber__slider {
  width: 100%;
  min-width: 0;
  min-height: 44px;
  padding: 8px 4px;
  background: transparent;
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
}
.gbar-scrubber__slider:focused {
  background: var(--surface-subtle);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.gbar-scrubber__times {
  width: 100%;
  min-width: 0;
  gap: 8px;
  padding: 0px 4px;
  align: center;
}
.gbar-scrubber__elapsed,
.gbar-scrubber__duration {
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.2;
  max-lines: 1;
  text-overflow: ellipsis;
}
.gbar-scrubber__elapsed {
  flex-grow: 1;
  flex-shrink: 1;
}
.gbar-scrubber__duration {
  text-align: end;
  flex-shrink: 0;
}

.gbar-icon-button {
  width: 46px;
  height: 46px;
  min-width: 44px;
  min-height: 44px;
  padding: 10px;
  background: var(--surface-raised);
  color: var(--text);
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 10px;
  flex-shrink: 0;
}
.gbar-icon-button--small { width: 44px; height: 44px; padding: 10px; }
.gbar-icon-button--large { width: 52px; height: 52px; padding: 12px; corner-radius: 12px; }
.gbar-icon-button--primary { background: var(--accent); color: var(--canvas); border-color: transparent; }
.gbar-icon-button--danger { background: var(--surface-raised); color: var(--danger); border-color: rgba(201, 129, 129, 0.34); }
.gbar-icon-button--quiet { background: transparent; color: var(--text-muted); border-color: transparent; }

.gbar-card {
  gap: 8px;
  padding: 12px;
  background: var(--surface-raised);
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 10px;
}
.gbar-card--subtle { background: var(--surface-subtle); }
.gbar-card--transparent { background: transparent; border-width: 0; padding: 0; }

.gbar-section-header { gap: 4px; }
.gbar-section-header__content { gap: 10px; align: center; justify: space-between; }
.gbar-section-header__text { min-width: 0; flex-grow: 1; flex-shrink: 1; gap: 2px; }
.gbar-section-header__eyebrow {
  color: var(--text-muted);
  font-family: var(--font-text);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.03em;
  text-transform: none;
  max-lines: 1;
}
.gbar-section-header__title {
  color: var(--text);
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 500;
  line-height: 1.2;
  max-lines: 1;
  text-overflow: ellipsis;
}
.gbar-section-header__description {
  color: var(--text-muted);
  font-family: var(--font-text);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.35;
  max-lines: 2;
}
.gbar-section-header__trailing { flex-shrink: 0; }

.gbar-badge {
  gap: 5px;
  align: center;
  padding: 4px 8px;
  background: transparent;
  color: var(--text-muted);
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 10px;
}
.gbar-badge__icon { width: 14px; height: 14px; flex-shrink: 0; }
.gbar-badge__label {
  color: var(--text-muted);
  font-family: var(--font-text);
  font-size: 11px;
  font-weight: 500;
  max-lines: 1;
}
.gbar-badge__icon--info,
.gbar-badge__label--info { color: var(--info); }
.gbar-badge__icon--success,
.gbar-badge__label--success { color: var(--success); }
.gbar-badge__icon--warning,
.gbar-badge__label--warning { color: var(--warning); }
.gbar-badge__icon--danger,
.gbar-badge__label--danger { color: var(--danger); }

.gbar-divider { height: 1px; min-height: 1px; background: var(--border); }

.gbar-alert,
.gbar-empty-state {
  gap: 7px;
  padding: 12px;
  background: var(--surface-subtle);
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 10px;
}
.gbar-alert__icon,
.gbar-empty-state__icon { width: 22px; height: 22px; color: var(--info); }
.gbar-alert__title,
.gbar-empty-state__title {
  color: var(--text);
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 500;
  line-height: 1.25;
  max-lines: 2;
}
.gbar-alert__message,
.gbar-empty-state__message {
  color: var(--text-muted);
  font-family: var(--font-text);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.4;
  max-lines: 4;
}
.gbar-alert__action,
.gbar-empty-state__action { min-height: 44px; padding: 10px 14px; }
.gbar-alert__icon--success { color: var(--success); }
.gbar-alert__icon--warning { color: var(--warning); }
.gbar-alert__icon--danger { color: var(--danger); }

.gbar-segmented-tabs {
  gap: 2px;
  padding: 3px;
  min-height: 50px;
  background: var(--surface-subtle);
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 10px;
  flex-shrink: 0;
}
.gbar-segmented-tabs__tab {
  min-width: 96px;
  min-height: 44px;
  padding: 9px 14px;
  background: transparent;
  color: var(--text-muted);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  flex-grow: 1;
}
.gbar-segmented-tabs__tab--selected {
  background: var(--surface-active);
  color: var(--text);
  border-color: var(--border);
}

.gbar-navigation-shell {
  width: 100%;
  min-width: 0;
  min-height: 0;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 10px;
  overflow: clip;
}
.gbar-navigation-shell__compact {
  width: 100%;
  min-width: 0;
  min-height: 50px;
  flex-shrink: 0;
  gap: 2px;
  padding: 3px;
  background: var(--surface-subtle);
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 10px;
  overflow: clip;
}
.gbar-navigation-shell__compact-item {
  min-width: 0;
  min-height: 44px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 7px;
  padding: 9px 10px;
  background: transparent;
  color: var(--text-muted);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-size: 12px;
  font-weight: 400;
  max-lines: 1;
  text-overflow: ellipsis;
}
.gbar-navigation-shell__body {
  width: 100%;
  min-width: 0;
  min-height: 0;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 10px;
  align: stretch;
  overflow: clip;
}
.gbar-navigation-shell__rail {
  width: 156px;
  min-height: 0;
  flex-shrink: 0;
  gap: 4px;
  padding: 8px;
  background: var(--surface-subtle);
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 10px;
  overflow: clip;
}
.gbar-navigation-shell__rail-item {
  width: 100%;
  min-width: 0;
  min-height: 44px;
  flex-shrink: 0;
  justify: start;
  gap: 9px;
  padding: 9px 11px;
  background: transparent;
  color: var(--text-muted);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-size: 12px;
  font-weight: 400;
  max-lines: 1;
  text-overflow: ellipsis;
}
.gbar-navigation-shell__compact-item:focused,
.gbar-navigation-shell__rail-item:focused {
  color: var(--text);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.gbar-navigation-shell__compact-item:pressed,
.gbar-navigation-shell__rail-item:pressed { opacity: 0.72; }
.gbar-navigation-shell__item--selected {
  background: var(--surface-active);
  color: var(--text);
  border-color: var(--border);
}
.gbar-navigation-shell__persistent {
  width: 320px;
  min-width: 240px;
  max-width: 360px;
  min-height: 0;
  flex-shrink: 1;
  overflow: clip;
}
.gbar-navigation-shell__content {
  min-width: 0;
  min-height: 0;
  flex-grow: 1;
  flex-shrink: 1;
  overflow: clip;
}

.gbar-switch {
  min-height: 44px;
  padding: 10px 14px;
  background: var(--surface-raised);
  color: var(--text-muted);
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 10px;
}
.gbar-switch--on { background: var(--surface-active); color: var(--text); }

.gbar-dialog {
  gap: 12px;
  padding: 16px;
  background: var(--surface);
  border-color: var(--border-strong);
  border-width: 1px;
  corner-radius: 12px;
}
.gbar-dialog__title {
  color: var(--text);
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 500;
  line-height: 1.2;
  max-lines: 2;
}
.gbar-dialog__content { gap: 8px; min-width: 0; min-height: 0; }

.gbar-settings-row {
  min-width: 0;
  gap: 7px;
  padding: 12px 2px;
  background: transparent;
  border-width: 0;
}
.gbar-settings-row__content {
  min-width: 0;
  gap: 10px;
  align: start;
}
.gbar-settings-row__icon {
  width: 20px;
  height: 20px;
  color: var(--text-muted);
  flex-shrink: 0;
}
.gbar-settings-row__copy {
  min-width: 0;
  gap: 3px;
  flex-grow: 1;
  flex-shrink: 1;
}
.gbar-settings-row__label {
  color: var(--text);
  font-size: 15px;
  font-weight: 500;
  line-height: 1.25;
  max-lines: 2;
  text-overflow: ellipsis;
}
.gbar-settings-row__description {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.35;
  max-lines: 4;
  text-overflow: ellipsis;
}
.gbar-settings-row__metadata { min-width: 0; gap: 5px; padding: 0px 0px 1px 30px; }
.gbar-settings-row__value {
  color: var(--text-muted);
  font-size: 14px;
  font-weight: 400;
  line-height: 1.3;
  max-lines: 3;
  text-overflow: ellipsis;
}
.gbar-settings-row__status { align: start; }
.gbar-settings-row__action {
  min-height: 44px;
  padding: 10px 12px;
  background: transparent;
  color: var(--text);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-size: 14px;
  font-weight: 400;
  text-align: start;
}
.gbar-settings-row__action:focused {
  background: var(--surface-active);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.gbar-action-sheet {
  min-width: 0;
  min-height: 0;
  gap: 10px;
  padding: 16px;
  background: var(--surface);
  border-color: var(--border-strong);
  border-width: 1px;
  corner-radius: 12px;
}
.gbar-action-sheet__title {
  color: var(--text);
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 500;
  line-height: 1.2;
  max-lines: 2;
  text-overflow: ellipsis;
  flex-shrink: 0;
}
.gbar-action-sheet__description {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.35;
  max-lines: 4;
  text-overflow: ellipsis;
  flex-shrink: 0;
}
.gbar-action-sheet__list {
  min-width: 0;
  min-height: 44px;
  max-height: 440px;
  gap: 4px;
  flex-grow: 1;
  flex-shrink: 1;
}
.gbar-action-sheet__item {
  min-height: 44px;
  padding: 10px 12px;
  background: transparent;
  color: var(--text);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-size: 15px;
  font-weight: 400;
  text-align: start;
  flex-shrink: 0;
}
.gbar-action-sheet__item--danger { color: var(--danger); }
.gbar-action-sheet__item:focused {
  background: var(--surface-active);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.gbar-picker {
  min-width: 0;
  min-height: 0;
  gap: 10px;
  padding: 16px;
  background: var(--surface);
  border-color: var(--border-strong);
  border-width: 1px;
  corner-radius: 12px;
}
.gbar-picker__title {
  color: var(--text);
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 500;
  line-height: 1.2;
  max-lines: 2;
  text-overflow: ellipsis;
  flex-shrink: 0;
}
.gbar-picker__description {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.35;
  max-lines: 4;
  text-overflow: ellipsis;
  flex-shrink: 0;
}
.gbar-picker__options {
  min-width: 0;
  min-height: 44px;
  max-height: 440px;
  gap: 4px;
  flex-grow: 1;
  flex-shrink: 1;
}
.gbar-picker__option {
  min-height: 44px;
  padding: 10px 12px;
  background: transparent;
  color: var(--text);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-size: 15px;
  font-weight: 400;
  text-align: start;
  flex-shrink: 0;
}
.gbar-picker__option--selected { background: var(--surface-subtle); }
.gbar-picker__option:focused {
  background: var(--surface-active);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.gbar-value-row {
  min-height: 44px;
  gap: 12px;
  align: center;
  padding: 8px 2px;
  background: transparent;
  border-width: 0;
}
.gbar-value-row__icon {
  width: 20px;
  height: 20px;
  color: var(--text-muted);
  flex-shrink: 0;
}
.gbar-value-row__text {
  min-width: 0;
  gap: 2px;
  flex-grow: 1;
  flex-shrink: 1;
}
.gbar-value-row__label {
  color: var(--text);
  font-size: 15px;
  font-weight: 400;
  max-lines: 1;
  text-overflow: ellipsis;
}
.gbar-value-row__description {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.3;
  max-lines: 2;
  text-overflow: ellipsis;
}
.gbar-value-row__value {
  color: var(--text-muted);
  font-size: 14px;
  font-weight: 400;
  text-align: end;
  max-lines: 1;
  text-overflow: ellipsis;
  flex-shrink: 0;
}

.gbar-choice-row {
  min-height: 44px;
  padding: 10px 12px;
  background: transparent;
  color: var(--text);
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-size: 15px;
  font-weight: 400;
  text-align: start;
}
.gbar-choice-row--selected { background: var(--surface-subtle); }
.gbar-choice-row:focused {
  background: var(--surface-active);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.gbar-controller-hint {
  min-height: 24px;
  gap: 6px;
  align: center;
  flex-shrink: 1;
}
.gbar-controller-hint__key {
  min-width: 24px;
  padding: 3px 6px;
  background: var(--surface-active);
  color: var(--text);
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 6px;
  font-size: 11px;
  font-weight: 500;
  text-align: center;
  max-lines: 1;
  flex-shrink: 0;
}
.gbar-controller-hint__label {
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 400;
  max-lines: 1;
  text-overflow: ellipsis;
}

/* Non-modal notifications remain compact and presentational. Widgets own the
   lifecycle of a toast; the component never creates a focus stop. */
.gbar-toast {
  min-width: 0;
  gap: 10px;
  align: center;
  padding: 10px 12px;
  background: var(--surface-raised);
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 10px;
  flex-shrink: 0;
}
.gbar-toast__icon {
  width: 20px;
  height: 20px;
  color: var(--text-muted);
  flex-shrink: 0;
}
.gbar-toast__icon--info { color: var(--accent); }
.gbar-toast__icon--success { color: var(--success); }
.gbar-toast__icon--warning { color: var(--warning); }
.gbar-toast__icon--danger { color: var(--danger); }
.gbar-toast__copy {
  min-width: 0;
  gap: 2px;
  flex-grow: 1;
  flex-shrink: 1;
}
.gbar-toast__title {
  color: var(--text);
  font-size: 14px;
  font-weight: 500;
  line-height: 1.25;
  max-lines: 2;
  text-overflow: ellipsis;
}
.gbar-toast__message {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.3;
  max-lines: 3;
  text-overflow: ellipsis;
}

/* Rich tiles are one ActionSurface focus/hit target. Their descendants are
   presentation-only, so focus and pressed treatment always follows the full
   visible tile instead of an inner label. */
.gbar-action-surface {
  min-width: 0;
  min-height: 72px;
  gap: 12px;
  align: center;
  padding: 10px;
  background: transparent;
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 10px;
  flex-shrink: 0;
}
.gbar-action-surface:focused {
  background: var(--surface-active);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.gbar-action-surface:pressed { background: var(--surface-raised); }
.gbar-action-surface:selected { border-color: var(--accent); }
.gbar-action-surface:disabled { color: var(--text-muted); }
.gbar-tile { flex-wrap: wrap; }
.gbar-tile__artwork {
  width: 56px;
  height: 56px;
  corner-radius: 8px;
  flex-grow: 0;
  flex-shrink: 0;
}
.gbar-tile__content {
  min-width: 0;
  gap: 2px;
  flex-grow: 1;
  flex-shrink: 1;
}
.gbar-tile__title {
  color: var(--text);
  font-size: 15px;
  font-weight: 500;
  line-height: 1.25;
  max-lines: 2;
  text-overflow: ellipsis;
}
.gbar-tile__subtitle {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.25;
  max-lines: 2;
  text-overflow: ellipsis;
}
.gbar-tile__metadata {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.25;
  max-lines: 2;
  text-overflow: ellipsis;
}
.gbar-tile__state {
  color: var(--accent);
  font-size: 12px;
  font-weight: 500;
  max-lines: 1;
  text-overflow: ellipsis;
}

/* Diagnostics and commands remain presentational and controller-neutral.
   Consolas is the single stable monospace family in the supported Windows
   baseline; the native font field does not currently implement CSS stacks. */
.gbar-code-text {
  min-width: 0;
  padding: 8px 10px;
  background: var(--surface-subtle);
  color: var(--text);
  border-color: var(--border);
  border-width: 1px;
  corner-radius: 8px;
  font-family: Consolas;
  font-size: 13px;
  font-weight: 400;
  line-height: 1.4;
  max-lines: 8;
  text-overflow: clip;
  text-align: start;
}

.gbar-responsive-grid {
  min-width: 0;
  min-height: 0;
  gap: 8px 10px;
}
