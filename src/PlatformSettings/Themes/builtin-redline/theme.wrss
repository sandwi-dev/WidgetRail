/* Redline keeps its oxblood ground. A scarlet tray edge anchors the shell;
   a lighter coral carries focus and small text. Avoid underlining every card.
   Rose error ink stays distinct from coral interaction, with text/icon semantics
   still required. Theme tokens preserve state fills and widget precedence. */

:root {
  --panel-shading: .035;
  --control-shading: .035;
  --focus-shading: .045;
  --inset-shading: -0.035;
  --depth-shadow: rgba(16, 2, 4, 0.36);
  --depth-highlight: rgba(255, 222, 214, 0.09);
  --depth-lowlight: rgba(0, 0, 0, 0.18);
  --focus-width: 2px;
  --focus-offset: -2px;

  --canvas: #160b0d;
  --canvas-veil: rgba(12, 5, 7, 0.72);
  --surface: rgba(36, 18, 20, 0.98);
  --surface-raised: rgba(46, 23, 25, 0.98);
  --modal-surface: rgba(46, 23, 25, 0.96);
  --surface-subtle: rgba(59, 30, 33, 0.94);
  --surface-active: rgba(77, 40, 43, 0.98);
  --surface-muted: rgba(59, 30, 33, 0.92);

  /* Hairlines take a warm blush cast so they belong to the oxblood ground. */
  --border: rgba(255, 214, 208, 0.14);
  --border-strong: rgba(255, 214, 208, 0.30);

  --text: #fbeeec;
  --controller-glyph-color: #e8a299;
  --text-muted: #dec4bf;
  --scrollbar-track: #49312e;
  --scrollbar-thumb: #d99389;
  --text-subdued: #b59a94;

  /* The accent edge reinforces the raised focused surface. */
  --focus: var(--accent);

  --accent: #ffab91;
  --structural-accent: #e06a5d;

  --success: #a2e7c2;
  --info: #aad9ff;
  --warning: #f5d493;
  --danger: #ffc0d8;
  --error: var(--danger);

  --scrim: rgba(12, 5, 7, 0.62);
  --poster-scrim: rgba(18, 9, 11, 0.86);

  --font-text: Segoe UI Variable Text, Segoe UI;
  --font-display: Segoe UI Variable Display, Segoe UI;
}

/* One structural edge on the tray, leaving content panels and cards quiet. */
tray {
  border-bottom-color: var(--structural-accent);
  border-bottom-width: 2px;
}

/* Medium-weight headings; readable sentence-case metadata without tracking. */
title { font-weight: 600; letter-spacing: -0.005em; }
.wrail-section-header__title,
.wrail-dialog__title,
.wrail-action-sheet__title,
.wrail-picker__title { font-weight: 600; letter-spacing: -0.005em; }

.wrail-section-header__eyebrow {
  color: var(--text-muted);
  font-weight: 600;
  letter-spacing: 0.02em;
  text-transform: none;
}

.wrail-tile__state,
.wrail-poster-tile__state {
  font-weight: 600;
  letter-spacing: 0em;
  text-transform: none;
}

/* Widget modal: host-clamped geometry, theme-owned colors and typography. */
.wrail-modal-layer { background: var(--canvas-veil); }
.wrail-modal {
  width: 760px; height: 640px; padding: 20px; gap: 16px;
  background: var(--modal-surface); color: var(--text);
  border-color: var(--border-strong); border-width: 1px; corner-radius: 16px;
  shadow-color: rgba(0, 0, 0, 0.45); shadow-blur: 20px; overflow: clip;
}
.wrail-modal__header { direction: row; align: center; gap: 20px; }
.wrail-modal__title { font-size: 26px; font-weight: 600; flex-grow: 1; min-width: 0; max-lines: 2; text-overflow: ellipsis; overflow-wrap: anywhere; }
.wrail-modal__scroll { flex-grow: 1; min-height: 0; min-width: 0; gap: 12px; padding: 4px; }
