/* Neon Circuit keeps its indigo ground, cyan interaction and angular edges.
   Quiet sentence-case labels replace competing magenta/uppercase decoration.
   Tokens preserve platform states; explicit widget styles still win. */

:root {
  --panel-shading: .025;
  --control-shading: .035;
  --focus-shading: .045;
  --inset-shading: -0.035;
  --depth-shadow: rgba(0, 3, 12, 0.38);
  --depth-highlight: rgba(174, 234, 255, 0.09);
  --depth-lowlight: rgba(0, 0, 0, 0.18);
  --focus-width: 2px;
  --focus-offset: -2px;

  /* Deep indigo-black instead of warm graphite. Surfaces keep the platform's
     four-step ramp so raised/subtle/active separation still reads at 720p. */
  --canvas: #05070e;
  --canvas-veil: rgba(2, 4, 10, 0.74);
  --surface: rgba(12, 16, 28, 0.98);
  --surface-raised: rgba(19, 24, 41, 0.98);
  --modal-surface: rgba(19, 24, 41, 0.96);
  --surface-subtle: rgba(26, 32, 54, 0.94);
  --surface-active: rgba(35, 45, 74, 0.98);
  --surface-muted: rgba(26, 32, 54, 0.92);

  /* Hairlines carry a faint cyan cast so panel edges belong to the palette
     without becoming visible chrome. */
  --border: rgba(122, 214, 255, 0.16);
  --border-strong: rgba(122, 214, 255, 0.34);

  --text: #e8f1fb;
  --controller-glyph-color: #83c6d8;
  --text-muted: #bcc9de;
  --scrollbar-track: #232d4a;
  --scrollbar-thumb: #67bbd0;
  --text-subdued: #8e9bb2;

  /* The accent edge reinforces the raised focused surface. */
  --focus: var(--accent);

  /* Electric cyan is the single interactive accent: progress, sliders, primary
     icon buttons, and tile state. Secondary labels stay neutral so they do not
     compete with focus. */
  --accent: #3fe0ff;

  --success: #91e0b7;
  --info: #a3d6ff;
  --warning: #f2d18a;
  --danger: #ff9fb4;
  --error: var(--danger);

  --scrim: rgba(3, 5, 12, 0.66);
  --poster-scrim: rgba(5, 7, 14, 0.86);

  --font-text: Segoe UI Variable Text, Segoe UI;
  --font-display: Segoe UI Variable Display, Segoe UI;
  /* Categorical data ink; independent of status and focus meanings. */
  --data-red: #ff9fb4;
  --data-blue: #a3d6ff;
  --data-green: #91e0b7;
  --data-gold: #f2d18a;
  --data-purple: #d4b3ff;
  --data-orange: #ffbb91;

}

/* Geometry: tighter, more angular rounding than the soft default. Radius is
   never state-dependent in the platform layer, so overriding it here is safe
   and does not touch hit-target sizes, padding, or focus geometry. */
panel,
tray,
.wrail-dialog,
.wrail-action-sheet,
.wrail-picker { corner-radius: 8px; }

tray-item,
button,
select,
slider,
.wrail-icon-button,
.wrail-card,
.wrail-switch,
.wrail-stepper__button,
.wrail-segmented-tabs,
.wrail-navigation-shell__compact,
.wrail-navigation-shell__rail,
.wrail-alert,
.wrail-empty-state,
.wrail-toast,
.wrail-action-surface { corner-radius: 6px; }

.wrail-icon-button--large,
.wrail-poster-tile,
.wrail-poster-tile__artwork { corner-radius: 8px; }

.wrail-segmented-tabs__tab,
.wrail-navigation-shell__compact-item,
.wrail-navigation-shell__rail-item,
.wrail-settings-row__action,
.wrail-action-sheet__item,
.wrail-picker__option,
.wrail-choice-row,
.wrail-scrubber__slider,
.wrail-badge,
.wrail-tile__artwork,
.wrail-controller-hint__key,
.wrail-code-text { corner-radius: 4px; }

progress { corner-radius: 1px; }

/* Selection marks: one accent edge instead of extra chrome. Per-edge borders
   are additive overrides, so the inherited uniform border and the neutral
   focus ring both survive on the same element. */
.wrail-segmented-tabs__tab--selected {
  border-bottom-color: var(--accent);
  border-bottom-width: 2px;
}
.wrail-navigation-shell__item--selected,
.wrail-choice-row--selected,
.wrail-picker__option--selected {
  border-left-color: var(--accent);
  border-left-width: 2px;
}

/* Strong headings establish hierarchy; compact labels retain word shapes. */
title { font-weight: 600; letter-spacing: -0.01em; }
.wrail-section-header__title,
.wrail-dialog__title,
.wrail-action-sheet__title,
.wrail-picker__title { font-weight: 600; letter-spacing: -0.01em; }

.wrail-section-header__eyebrow {
  color: var(--text-muted);
  font-weight: 700;
  letter-spacing: 0.02em;
  text-transform: none;
}

.wrail-badge__label,
.wrail-tile__state,
.wrail-poster-tile__state,
.wrail-poster-tile__subtitle {
  font-weight: 600;
  letter-spacing: 0em;
  text-transform: none;
}

.wrail-window-preview {
  width: 100%; min-width: 0; overflow: clip;
  background: var(--surface); color: var(--text-muted);
  corner-radius: 6px; font-size: 12px; text-align: center;
}
.wrail-preview-poster { gap: 8px; min-width: 0; }

/* Widget modal: host-clamped geometry, theme-owned colors and typography. */
.wrail-modal-layer { background: var(--canvas-veil); }
.wrail-modal {
  width: 760px; height: 640px; padding: 20px; gap: 16px;
  background: var(--modal-surface); color: var(--text);
  border-color: var(--border-strong); border-width: 1px; corner-radius: 16px;
  shadow-color: rgba(0, 0, 0, 0.45); shadow-blur: 20px; overflow: clip;
}
.wrail-modal__header { direction: row; align: center; gap: 20px; }
.wrail-modal__title { font-size: 26px; font-weight: 600; flex-grow: 1; min-width: 0; max-lines: 2; text-overflow: ellipsis; overflow-wrap: anywhere; }
.wrail-modal__scroll { flex-grow: 1; min-height: 0; min-width: 0; gap: 12px; padding: 4px; }
