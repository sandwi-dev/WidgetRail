<ResourceDictionary
    x:Class="WidgetRail.OverlayFrontend.WinUI.Presentation.WidgetCollectionTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:collections="using:WidgetRail.OverlayFrontend.WinUI.Collections"
    xmlns:local="using:WidgetRail.OverlayFrontend.WinUI.Presentation">
    <DataTemplate x:Key="WidgetIndexedRowTemplate" x:DataType="collections:IndexedItem">
        <local:WidgetIndexedRowView Row="{x:Bind Content, Mode=OneWay}" />
    </DataTemplate>
    <DataTemplate x:Key="WidgetIndexedGroupHeaderTemplate" x:DataType="collections:WidgetIndexedGroup">
        <TextBlock Text="{x:Bind Header, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="8,12,8,8" />
    </DataTemplate>
    <ItemsPanelTemplate x:Key="WidgetIndexedVerticalPanel"><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="WidgetIndexedHorizontalPanel"><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="WidgetIndexedGridPanel"><ItemsWrapGrid Orientation="Horizontal" GroupHeaderPlacement="Top" /></ItemsPanelTemplate>
</ResourceDictionary>
