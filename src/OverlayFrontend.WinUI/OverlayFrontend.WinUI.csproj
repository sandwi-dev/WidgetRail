<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\WinUiNativeInputs.targets" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- C#/WinRT 2.3.1 projections for .NET 9/10, including trim-safe ABI support. -->
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <RootNamespace>WidgetRail.OverlayFrontend.WinUI</RootNamespace>
    <AssemblyTitle>WidgetRail</AssemblyTitle>
    <Product>WidgetRail</Product>
    <Description>Controller-first Windows widgets</Description>
    <Version>$(WidgetRailReleaseVersion)</Version>
    <FileVersion>$(WidgetRailFileVersion)</FileVersion>
    <AssemblyVersion>$(WidgetRailFileVersion)</AssemblyVersion>
    <OverlayPlatformInteropPath Condition="'$(OverlayPlatformInteropPath)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\winui-platform\Release\OverlayPlatformInterop.dll</OverlayPlatformInteropPath>
    <WindowPreviewNativePath Condition="'$(WindowPreviewNativePath)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\winui-preview\Release\WinUiWindowPreviewNative.dll</WindowPreviewNativePath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\branding\widgetrail.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- Explicit unpackaged/Inno distribution: no app identity or app certificate. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- SDK XAML/PRI compilation also uses this tooling for unpackaged WinExe. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKBootstrapInitialize>false</WindowsAppSDKBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Trimmed Release needs generated WinRT interfaces even without Native AOT. -->
    <CsWinRTAotWarningLevel>1</CsWinRTAotWarningLevel>
    <EnableWidgetValidation Condition="'$(EnableWidgetValidation)' == '' and '$(Configuration)' == 'Debug'">true</EnableWidgetValidation>
    <EnableWidgetValidation Condition="'$(EnableWidgetValidation)' == ''">false</EnableWidgetValidation>
    <DefineConstants Condition="'$(EnableWidgetValidation)' == 'true'">$(DefineConstants);ENABLE_WIDGET_VALIDATION</DefineConstants>
    <DefineConstants Condition="'$(EnableTrimmedControlValidation)' == 'true'">$(DefineConstants);ENABLE_TRIMMED_CONTROL_VALIDATION</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableWidgetValidation)' != 'true'">
    <Compile Remove="Validation\**\*.cs;MainPage.xaml.cs;Presentation\WidgetViewPresenter.FocusDiagnostics.cs" />
    <Page Remove="Validation\**\*.xaml;MainPage.xaml" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableTrimmedControlValidation)' == 'true' And '$(EnableWidgetValidation)' != 'true'">
    <Compile Include="Validation\CapturedMediaView.Validation.cs" />
  </ItemGroup>
  <!-- Small trim-safe native smoke test; excluded from shipping and ordinary fixtures. -->
  <ItemGroup Condition="'$(EnableTrimmedControlValidation)' != 'true' Or '$(EnableWidgetValidation)' == 'true'">
    <Compile Remove="TrimValidation\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="..\..\assets\branding\widgetrail.svg" Link="Assets\WidgetRail.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\branding\widgetrail.ico" Link="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="..\..\assets\fonts\winui-controller\xbox.ttf" Link="Assets\Fonts\xbox.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\winui-controller\playstation.ttf" Link="Assets\Fonts\playstation.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\winui-controller\guide.ttf" Link="Assets\Fonts\guide.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\winui-controller\NOTICE.txt" Link="licenses\ControllerFonts-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\kenney\LICENSE.txt" Link="licenses\Kenney.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\kenney\NOTICE.txt" Link="licenses\Kenney-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\promptfont\LICENSE.txt" Link="licenses\PromptFont.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\promptfont\NOTICE.txt" Link="licenses\PromptFont-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\WidgetSdk\EmbeddedMediaAdapterRuntime.js" LogicalName="WidgetRail.MediaValidation.AdapterRuntime.js" Condition="'$(EnableWidgetValidation)' == 'true'" />
    <Manifest Include="$(ApplicationManifest)" />
    <ProjectReference Include="..\OverlayPlatformClient\OverlayPlatformClient.csproj" />
    <ProjectReference Include="..\WindowsWindowActivation\WindowsWindowActivation.csproj" />
    <ProjectReference Include="..\WidgetUi.State\WidgetUi.State.csproj" />
    <ProjectReference Include="..\PlatformSettings\PlatformSettings.csproj" />
    <ProjectReference Include="..\WindowsDisplayProvider\WindowsDisplayProvider.csproj" />
    <ProjectReference Include="..\WidgetPresentationSession\WidgetPresentationSession.csproj" />
    <Content Include="$(OverlayPlatformInteropPath)"
             Condition="Exists('$(OverlayPlatformInteropPath)')"
             Link="OverlayPlatformInterop.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(WindowPreviewNativePath)"
             Condition="Exists('$(WindowPreviewNativePath)')"
             Link="WinUiWindowPreviewNative.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\third_party\WinUIEx\LICENSE" Link="licenses\WinUIEx.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- WinApp project-mode run supports the explicit unpackaged configuration. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.7.0" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
  </ItemGroup>
  <!-- Publish Properties -->
  <PropertyGroup>
    <!-- ILLink 10.0.10 can remove Monitor.Exit in nested async finally blocks.
         Keep trimming/R2R, but disable the affected optimization until the pinned
         SDK includes https://github.com/dotnet/runtime/pull/131236.
         Published cleanup is verified against the emitted assembly. -->
    <_TrimmerIPConstProp>false</_TrimmerIPConstProp>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>
</Project>
