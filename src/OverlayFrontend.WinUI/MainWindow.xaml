<Window
    x:Class="WidgetRail.OverlayFrontend.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WidgetRail — WinUI frontend">
    <Grid x:Name="ShellRoot" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="ValidationShellCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="ProductionShellCardStyle" TargetType="Border" BasedOn="{StaticResource ValidationShellCardStyle}">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            </Style>
        </Grid.Resources>
        <Border x:Name="ShellCard" Margin="32" Padding="24" CornerRadius="16"
                Style="{StaticResource ValidationShellCardStyle}" BorderThickness="1">
            <Grid x:Name="ShellLayout" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="ShellHeader" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="WidgetRail" Style="{ThemeResource TitleTextBlockStyle}" />
                    <Button Grid.Column="1" AutomationProperties.AutomationId="Shell.Close"
                            AutomationProperties.Name="Close WidgetRail frontend"
                            Content="Close" Click="CloseClicked" />
                </Grid>
                <Frame x:Name="RootFrame" Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</Window>
