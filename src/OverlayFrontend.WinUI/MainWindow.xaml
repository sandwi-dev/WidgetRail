<Window
    x:Class="WidgetRail.OverlayFrontend.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WidgetRail — WinUI frontend">
    <Grid x:Name="ShellRoot" Background="Transparent">
        <Border Margin="32" Padding="24" CornerRadius="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="WidgetRail" Style="{ThemeResource TitleTextBlockStyle}" />
                    <Button Grid.Column="1" AutomationProperties.AutomationId="Shell.Close"
                            AutomationProperties.Name="Close WidgetRail frontend"
                            Content="Close" Click="CloseClicked" />
                </Grid>
                <Frame x:Name="RootFrame" Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</Window>
