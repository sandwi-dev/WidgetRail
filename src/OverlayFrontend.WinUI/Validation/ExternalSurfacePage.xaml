<Page
    x:Class="WidgetRail.OverlayFrontend.WinUI.Validation.ExternalSurfacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="Media.Status"
                   Text="Initializing external surface" Style="{StaticResource BodyTextBlockStyle}" />
        <Grid Grid.Row="1">
            <WebView2 x:Name="Browser" AutomationProperties.AutomationId="Media.Browser"
                      AutomationProperties.Name="External surface validation content" />
            <Button x:Name="OverlayCommand" Margin="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                    AutomationProperties.AutomationId="Media.OpenDialog" Content="Open overlay dialog"
                    IsEnabled="False" Click="OpenDialogClicked" />
        </Grid>
    </Grid>
</Page>
