<Page
    x:Class="WidgetRail.OverlayFrontend.WinUI.Validation.IndexedCollectionValidationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <DataTemplate x:Key="RowTemplate">
            <StackPanel Height="72" Padding="12,8" Spacing="4">
                <TextBlock Text="{Binding Value.Title, Mode=OneWay, FallbackValue='Loading item', TargetNullValue='Loading item'}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{Binding Value.Subtitle, Mode=OneWay, FallbackValue='Waiting for data', TargetNullValue='Waiting for data'}"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Indexed source: F5 jump deep; F6 inspect; F7 return to first item" />
        <ListView x:Name="CollectionView" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="ItemClicked" ContainerContentChanging="ContainerChanging"
                  AutomationProperties.AutomationId="Indexed.View" AutomationProperties.Name="Indexed collection"
                  ItemTemplate="{StaticResource RowTemplate}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>
        <TextBlock Grid.Row="2" x:Name="StatusText" AutomationProperties.AutomationId="Indexed.Status"
                   Height="24" TextTrimming="CharacterEllipsis" />
    </Grid>
</Page>
