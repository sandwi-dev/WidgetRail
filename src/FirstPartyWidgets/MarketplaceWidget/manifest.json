{
  "manifestVersion": 1, "id": "widgetrail.firstparty.marketplace", "publisher": "widgetrail.firstparty",
  "name": "WidgetRail Catalogue", "version": "0.1.1", "hostApi": { "minimum": "1.0", "maximumMajor": 1 },
