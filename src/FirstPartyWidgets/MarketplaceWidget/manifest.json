    "requests": [{ "id": "widgetrail.settings.widget.open", "version": 1,
      "payloadSchema": { "type": "object", "additionalProperties": false, "properties": { "packageId": { "type": "string", "minLength": 3, "maxLength": 128 } }, "required": ["packageId"] } }],
    "handles": [{ "id": "widgetrail.marketplace.open", "version": 1,
      "payloadSchema": { "type": "object", "additionalProperties": false, "properties": {} } }]
