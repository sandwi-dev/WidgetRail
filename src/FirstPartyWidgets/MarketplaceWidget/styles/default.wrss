.marketplace-widget { padding: 16px; gap: 12px; color: var(--text); background: var(--surface); }
.page-heading { font-size: 24px; font-weight: 600; }
.section-heading { font-size: 17px; font-weight: 600; text-align: start; }
.page-help { font-size: 13px; color: var(--text-muted); text-align: start; }
.marketplace-card { padding: 16px; gap: 8px; corner-radius: 8px; background: var(--surface-raised); }
.marketplace-preview { height: 280px; }
.diagnostic-line { font-size: 14px; text-align: start; }
.diagnostic-error { color: var(--danger, #c98181); text-align: start; }
.diagnostic-ok { color: var(--text); text-align: start; }
.marketplace-review-actions { gap: 8px; }
