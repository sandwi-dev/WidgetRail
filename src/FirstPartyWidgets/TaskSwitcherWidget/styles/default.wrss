.tasks-widget { padding: 16px; gap: 12px; background: var(--surface); color: var(--text); }
.tasks-header { gap: 12px; align: center; flex-shrink: 0; }
.tasks-heading { flex-grow: 1; min-width: 0; gap: 3px; }
.tasks-title { font-size: 24px; font-weight: 600; max-lines: 1; }
.tasks-count { font-size: 12px; color: var(--text-muted); }
.tasks-refresh { padding: 10px 14px; flex-shrink: 0; }
.tasks-list { flex-grow: 1; flex-basis: 0; min-height: 48px; gap: 8px; }
.tasks-row { gap: 8px; align: stretch; flex-shrink: 0; }
.tasks-window { flex-grow: 1; min-width: 0; padding: 12px; gap: 12px; corner-radius: 10px; background: var(--surface-raised); border-width: 1px; border-color: var(--border, rgba(246, 240, 226, 0.12)); }
.tasks-window:focused { border-color: var(--accent); background: var(--surface-selected, var(--surface-raised)); }
.tasks-icon { width: 24px; height: 24px; color: var(--accent); flex-shrink: 0; }
.tasks-copy { flex-grow: 1; min-width: 0; gap: 3px; }
.tasks-app { font-size: 15px; font-weight: 600; max-lines: 1; text-overflow: ellipsis; }
.tasks-window-title { font-size: 12px; color: var(--text-muted); max-lines: 2; text-overflow: ellipsis; }
.tasks-state { font-size: 10px; color: var(--text-muted); max-lines: 1; }
.tasks-close { color: var(--warning); padding: 10px 14px; flex-shrink: 0; }
.tasks-help { font-size: 14px; color: var(--text-muted); max-lines: 3; flex-shrink: 0; }

.tasks-grid { gap: 12px; }
.tasks-row { min-width: 0; gap: 6px; }
.tasks-window { padding: 8px; gap: 8px; flex-grow: 1; }
.tasks-preview { width: 100%; aspect-ratio: 1.777778; flex-shrink: 0; background: var(--surface); color: var(--text-muted); corner-radius: 6px; font-size: 12px; text-align: center; }
.tasks-close { min-height: 36px; padding: 6px 12px; }
