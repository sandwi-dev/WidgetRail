{
  "manifestVersion": 1,
  "id": "widgetrail.firstparty.network-controls",
  "publisher": "widgetrail.firstparty",
  "name": "Network Controls",
  "version": "0.1.1",
  "hostApi": {
    "minimum": "1.0",
    "maximumMajor": 1
  },
  "entrypoint": {
    "runtime": "dotnet-worker",
    "assembly": "payload/NetworkControlsWidget.dll",
    "type": "WidgetRail.FirstPartyWidgets.NetworkControls.NetworkControlsWidget"
  },
  "presentation": {
    "icon": "wifi",
    "packageIcon": { "assetId": "network-controls.mark", "colorMode": "originalColor" }
  },
  "iconAssets": {
    "network-controls.mark": { "path": "assets/icons/network-controls.svg" }
  },
  "permissions": [
    "system.network.read.v1",
    "system.network.wifi.read.v1",
    "system.network.wifi.radio.read.v1"
  ],
  "optionalPermissions": [
    "system.network.details.read.v1",
    "system.network.wifi.connect.v1",
    "system.network.wifi.radio.control.v1",
    "system.network.bluetooth.read.v1",
    "system.network.bluetooth.radio.control.v1",
    "system.network.bluetooth.pair.v1",
    "system.network.bluetooth.unpair.v1",
    "system.network.bluetooth.manage.v1"
  ],
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "unload-after-idle",
    "idleSeconds": 120
  },
  "resourceRequest": {
    "memoryMb": 64,
    "updateHz": 10
  },
  "architectures": [
    "x64"
  ]
}
