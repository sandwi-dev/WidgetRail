:root {
  --network-accent: #68d7ff;
  --network-accent-strong: #2dbde9;
  --network-focus: #7acbe5;
  --network-surface: rgba(14, 18, 26, 0.98);
  --network-card: rgba(34, 41, 54, 0.94);
  --network-card-selected: rgba(36, 55, 70, 0.98);
  --network-control: rgba(48, 58, 73, 0.96);
  --network-control-focus: rgba(65, 80, 99, 0.99);
  --network-error: #ff7c91;
  --network-warning: #ffc76a;
}

.network-controls-widget {
  width: 100vw;
  min-width: 0px;
  max-width: 560px;
  gap: 8px;
  padding: 14px;
  background: var(--network-surface);
  color: var(--text);
  overflow: clip;
}

.network-view-scroll {
  min-height: 120px;
  min-width: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 8px;
  padding: 2px 4px 2px 2px;
  overflow: clip;
}

.network-header {
  gap: 1px;
  flex-shrink: 0;
}

.network-eyebrow {
  color: var(--network-accent);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.11em;
  max-lines: 1;
  text-transform: uppercase;
}

.network-title {
  color: var(--text);
  font-size: 23px;
  font-weight: 600;
  max-lines: 1;
  text-overflow: ellipsis;
}

.network-status,
.network-card-detail,
.network-profile-detail,
.network-help {
  color: var(--text-muted);
  font-size: 12px;
  max-lines: 2;
}

.network-status.is-live,
.network-card-state.is-online,
.network-profile-state.is-connected {
  color: var(--success);
}

.network-status.is-error,
.network-card-state.is-error,
.network-profile-state.is-error,
.network-notice-icon.is-error {
  color: var(--network-error);
}

.network-card-state.is-warning,
.network-profile-state.is-connecting,
.network-notice-icon.is-warning {
  color: var(--network-warning);
}

.network-connection-card,
.network-state-card,
.network-wifi-note {
  gap: 7px;
  padding: 9px 10px;
  background: var(--network-card);
  border-width: 0;
  corner-radius: 10px;
  flex-shrink: 0;
}

.network-connection-card {
  align: center;
  justify: space-between;
}

.network-connection-top,
.network-wifi-note,
.network-radio-row,
.network-section-heading,
.network-profile-meta {
  gap: 8px;
  align: center;
  justify: space-between;
}

.network-connection-top {
  min-height: 44px;
}

.network-connection-icon,
.network-notice-icon {
  width: 32px;
  height: 32px;
  padding: 6px;
  color: var(--network-accent);
  background: var(--network-control);
  shape: circle;
  flex-shrink: 0;
}

.network-notice-icon {
  width: 30px;
  height: 30px;
  padding: 6px;
  background: rgba(255, 199, 106, 0.10);
}

.network-connection-copy,
.network-notice-copy,
.network-radio-copy,
.network-section-copy {
  min-width: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 1px;
}

.network-radio-row {
  gap: 10px;
  padding: 7px 10px;
  min-height: 48px;
  background: var(--network-card);
  border-width: 0;
  corner-radius: 10px;
  flex-shrink: 0;
}

.network-radio-toggle {
  min-width: 136px;
  min-height: 36px;
  padding: 5px 9px;
  color: var(--text);
  background: var(--network-control);
  border-width: 0;
  corner-radius: 8px;
  flex-shrink: 0;
  font-size: 12px;
}

.network-radio-toggle.is-on {
  color: var(--success);
}

.network-bluetooth-row {
  min-height: 50px;
}

.network-bluetooth-toggle {
  min-width: 146px;
}

.network-bluetooth-list {
  min-height: 74px;
  max-height: 168px;
  flex-grow: 0;
}

.network-bluetooth-device-row {
  min-height: 66px;
}

.network-bluetooth-state {
  min-height: 68px;
}

.network-section-summary.is-error {
  color: var(--network-error);
}

.network-radio-toggle:focused {
  color: var(--text);
  background: var(--network-control-focus);
  outline-color: var(--network-focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.network-connection-meta {
  gap: 8px;
  align: center;
}

.network-card-title,
.network-state-title {
  color: var(--text);
  font-size: 16px;
  font-weight: 600;
  max-lines: 1;
  text-overflow: ellipsis;
}

.network-card-state,
.network-profile-state,
.network-section-label,
.network-section-count {
  color: var(--text-muted);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.07em;
  max-lines: 1;
  text-transform: uppercase;
}

.network-section-label {
  color: var(--text-muted);
}

.network-section-count {
  color: var(--network-accent);
  letter-spacing: 0.02em;
}

.network-section-heading {
  flex-shrink: 0;
}

.network-section-summary {
  color: var(--text-muted);
  font-size: 11px;
  max-lines: 1;
}

.network-signal-row {
  gap: 10px;
  align: center;
}

.network-signal-progress {
  height: 5px;
  min-width: 100px;
  flex-grow: 1;
  color: var(--network-accent-strong);
  background: rgba(103, 113, 133, 0.38);
}

.network-signal-value {
  width: 42px;
  color: var(--text);
  font-size: 12px;
  font-weight: 600;
  text-align: end;
}

.network-signal-value.is-empty {
  color: transparent;
}

.network-profile-list {
  min-height: 156px;
  max-height: 292px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 6px;
  padding: 1px 3px 1px 1px;
  overflow: clip;
}

.network-profile-row {
  gap: 1px;
  padding: 2px 3px 5px;
  background: var(--network-card);
  border-width: 0;
  corner-radius: 10px;
  flex-shrink: 0;
}

.network-profile-row.is-pending {
  background: rgba(42, 56, 71, 0.99);
}

.network-profile-button,
.network-retry-action,
.network-scan-action {
  min-height: 44px;
  padding: 7px 9px;
  color: var(--text);
  background: transparent;
  border-width: 0;
  corner-radius: 8px;
  transition-duration: 90ms;
  transition-easing: ease-out;
}

.network-profile-button {
  min-width: 0px;
  flex-grow: 1;
  max-lines: 1;
  text-overflow: ellipsis;
}

.network-profile-button.is-connected {
  color: var(--success);
}

.network-profile-button:focused,
.network-retry-action:focused,
.network-scan-action:focused {
  color: var(--text);
  background: var(--network-control-focus);
  outline-color: var(--network-focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.network-profile-meta {
  padding: 0px 10px;
  flex-shrink: 0;
}

.network-profile-detail {
  max-lines: 1;
  text-align: end;
  flex-shrink: 0;
}

.network-retry-action {
  background: var(--network-control);
}

.network-scan-action {
  min-width: 132px;
  flex-shrink: 0;
  background: var(--network-control);
  font-size: 12px;
}

.network-state-card {
  min-height: 88px;
}
