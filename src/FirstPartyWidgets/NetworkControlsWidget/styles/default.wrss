.network-controls-widget {
  width: 100vw;
  min-width: 0px;
  gap: 8px;
  padding: 14px;
  background: var(--surface);
  color: var(--text);
  overflow: clip;
}

.network-view-scroll {
  min-height: 120px;
  min-width: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 8px;
  padding: 2px 4px 2px 2px;
  overflow: clip;
}

.network-header { gap: 1px; flex-shrink: 0; }
.network-eyebrow {
  color: var(--text-muted);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.03em;
  max-lines: 1;
  text-transform: none;
}

.network-title {
  color: var(--text);
  font-size: 23px;
  font-weight: 500;
  max-lines: 1;
  text-overflow: ellipsis;
}

.network-status,
.network-card-detail,
.network-profile-detail,
.network-help {
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 400;
  max-lines: 2;
}

.network-status.is-live,
.network-card-state.is-online,
.network-profile-state.is-connected { color: var(--success); }

.network-status.is-error,
.network-card-state.is-error,
.network-profile-state.is-error,
.network-notice-icon.is-error { color: var(--danger, #c98181); }

.network-card-state.is-warning,
.network-profile-state.is-connecting,
.network-notice-icon.is-warning { color: var(--warning); }

.network-connection-card,
.network-state-card,
.network-wifi-note,
.network-radio-row {
  gap: 7px;
  padding: 9px 10px;
  background: var(--surface-raised);
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  border-width: 1px;
  corner-radius: 10px;
  flex-shrink: 0;
}

.network-connection-card { align: center; justify: space-between; }

.network-connection-top,
.network-wifi-note,
.network-radio-row,
.network-section-heading,
.network-profile-meta {
  gap: 8px;
  align: center;
  justify: space-between;
}

.network-connection-top { min-height: 44px; }

.network-connection-icon,
.network-notice-icon {
  width: 22px;
  height: 22px;
  padding: 1px;
  color: var(--text-muted);
  background: transparent;
  flex-shrink: 0;
}

.network-notice-icon { color: var(--warning); }

.network-connection-copy,
.network-notice-copy,
.network-radio-copy,
.network-section-copy {
  min-width: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 1px;
}

.network-radio-row {
  gap: 10px;
  min-height: 48px;
}

.network-radio-toggle {
  min-width: 136px;
  min-height: 44px;
  padding: 8px 11px;
  color: var(--text);
  background: var(--surface-subtle, rgba(39, 39, 36, 0.92));
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  border-width: 1px;
  corner-radius: 8px;
  flex-shrink: 0;
  font-size: 12px;
  font-weight: 400;
}

.network-radio-toggle.is-on { color: var(--success); }
.network-bluetooth-row { min-height: 50px; }
.network-bluetooth-toggle { min-width: 146px; }
.network-bluetooth-list { min-height: 74px; max-height: 168px; flex-grow: 0; }
.network-bluetooth-device-row { min-height: 66px; }
.network-bluetooth-state { min-height: 68px; }
.network-section-summary.is-error { color: var(--danger, #c98181); }

.network-radio-toggle:focused {
  color: var(--text);
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.network-connection-meta { gap: 8px; align: center; }

.network-card-title,
.network-state-title {
  color: var(--text);
  font-size: 16px;
  font-weight: 500;
  max-lines: 1;
  text-overflow: ellipsis;
}

.network-card-state,
.network-profile-state,
.network-section-label,
.network-section-count {
  color: var(--text-muted);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.03em;
  max-lines: 1;
  text-transform: none;
}

.network-section-count { color: var(--text-subdued); }
.network-section-heading { flex-shrink: 0; }
.network-section-summary { color: var(--text-muted); font-size: 11px; max-lines: 1; }
.network-signal-row { gap: 10px; align: center; }

.network-signal-progress {
  height: 4px;
  min-width: 100px;
  flex-grow: 1;
  color: var(--accent);
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
}

.network-signal-value {
  width: 42px;
  color: var(--text);
  font-size: 12px;
  font-weight: 500;
  text-align: end;
}

.network-signal-value.is-empty { color: transparent; }

.network-profile-list {
  min-height: 156px;
  max-height: 292px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 2px;
  padding: 1px 3px 1px 1px;
  overflow: clip;
}

.network-profile-row {
  gap: 1px;
  padding: 2px 3px 5px;
  background: transparent;
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  flex-shrink: 0;
}

.network-profile-row.is-pending { background: var(--surface-subtle, rgba(39, 39, 36, 0.92)); }

.network-profile-button,
.network-retry-action,
.network-scan-action {
  min-height: 44px;
  padding: 7px 9px;
  color: var(--text);
  background: transparent;
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-weight: 400;
  transition-duration: 90ms;
  transition-easing: ease-out;
}

.network-profile-button {
  min-width: 0px;
  flex-grow: 1;
  max-lines: 1;
  text-overflow: ellipsis;
}

.network-profile-button.is-connected { color: var(--success); }

.network-profile-button:focused,
.network-retry-action:focused,
.network-scan-action:focused {
  color: var(--text);
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.network-profile-meta { padding: 0px 10px; flex-shrink: 0; }
.network-profile-detail { max-lines: 1; text-align: end; flex-shrink: 0; }

.network-retry-action,
.network-scan-action {
  background: var(--surface-raised);
  border-color: var(--border, rgba(246, 240, 226, 0.12));
}

.network-scan-action { min-width: 132px; flex-shrink: 0; font-size: 12px; }
.network-state-card { min-height: 88px; }

/* Full-width cards keep long IPv6 and DNS values within the available width. */
.network-details-scroll { gap: 8px; }
.network-details-row {
  min-width: 0px;
  flex-shrink: 0;
  gap: 4px;
  padding: 10px 12px;
  background: var(--surface-subtle, rgba(39, 39, 36, 0.92));
  corner-radius: 8px;
}
.network-details-label {
  max-lines: 2;
  min-width: 0px;
  color: var(--text-muted);
  font-size: 11px;
  font-weight: 500;
}
.network-details-value {
  max-lines: 8;
  min-width: 0px;
  color: var(--text);
  font-size: 14px;
  overflow-wrap: anywhere;
}
.network-details-message {
  max-lines: 3;
  min-width: 0px;
  color: var(--text-muted);
  font-size: 12px;
  overflow-wrap: anywhere;
}
.network-secondary-action {
  min-width: 0px;
  min-height: 40px;
  flex-shrink: 0;
  padding: 8px 12px;
  background: var(--surface-subtle, rgba(39, 39, 36, 0.92));
  color: var(--text);
  corner-radius: 8px;
  font-size: 14px;
  text-overflow: ellipsis;
}
.network-secondary-action:focused { background: var(--accent); color: var(--accent-contrast, #ffffff); }
.network-secondary-action:disabled { opacity: 0.55; }
