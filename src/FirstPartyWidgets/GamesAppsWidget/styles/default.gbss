:root {
  --games-accent: #72d8ff;
  --games-focus: #86dfff;
  --games-surface: rgba(14, 18, 26, 0.98);
  --games-card: rgba(34, 41, 54, 0.94);
  --games-card-selected: rgba(36, 58, 74, 0.98);
  --games-control: rgba(48, 58, 73, 0.96);
  --games-control-focus: rgba(65, 82, 101, 0.99);
  --games-error: #ff7c91;
}

.games-apps-widget {
  width: 100vw;
  min-width: 0px;
  max-width: 820px;
  gap: 10px;
  padding: 16px;
  background: var(--games-surface);
  color: var(--text);
  overflow: clip;
}

.games-header {
  gap: 2px;
  flex-shrink: 0;
}

.games-eyebrow,
.games-section-label,
.games-section-count,
.games-card-kind,
.games-card-hint {
  color: var(--text-muted);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  max-lines: 1;
  text-transform: uppercase;
}

.games-eyebrow,
.games-section-count {
  color: var(--games-accent);
}

.games-title {
  color: var(--text);
  font-size: 26px;
  font-weight: 600;
  max-lines: 1;
  text-overflow: ellipsis;
}

.games-status,
.games-state-help {
  color: var(--text-muted);
  font-size: 12px;
  max-lines: 2;
}

.games-status.is-ready { color: var(--success); }
.games-status.is-error { color: var(--games-error); }

.games-section-heading,
.games-card-meta {
  gap: 8px;
  align: center;
  justify: space-between;
  flex-shrink: 0;
}

.games-library-scroll {
  min-height: 168px;
  max-height: 244px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 10px;
  padding: 3px 4px 4px 3px;
  overflow: clip;
}

.games-card {
  width: 184px;
  min-width: 184px;
  min-height: 158px;
  gap: 7px;
  padding: 7px;
  background: var(--games-card);
  corner-radius: 12px;
  flex-grow: 0;
  flex-shrink: 0;
}

.games-card-action {
  width: 170px;
  min-width: 170px;
  min-height: 116px;
  padding: 14px;
  background: var(--games-control);
  color: var(--text);
  corner-radius: 9px;
  max-lines: 3;
  text-overflow: ellipsis;
  transition-duration: 90ms;
  transition-easing: ease-out;
}

.games-card-action:selected {
  background: var(--games-card-selected);
}

.games-card-action:focused,
.games-retry:focused {
  background: var(--games-control-focus);
  outline-color: var(--games-focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.games-card-action:busy { opacity: 0.72; }
.games-card-meta { padding: 0px 4px 2px; }
.games-card-hint { color: var(--games-accent); letter-spacing: 0.03em; }
.games-card.is-load-more { background: rgba(30, 37, 49, 0.94); }
.games-load-more { color: var(--games-accent); }

.games-state-card {
  min-height: 168px;
  gap: 10px;
  padding: 20px;
  align: center;
  justify: center;
  background: var(--games-card);
  corner-radius: 12px;
  flex-grow: 1;
}

.games-state-icon {
  width: 42px;
  height: 42px;
  padding: 9px;
  color: var(--games-accent);
  background: var(--games-control);
  shape: circle;
}

.games-state-title {
  color: var(--text);
  font-size: 18px;
  font-weight: 600;
  max-lines: 2;
}

.games-state-help {
  max-lines: 3;
}

.games-retry {
  min-width: 150px;
  min-height: 44px;
  padding: 10px 14px;
  background: var(--games-control);
  color: var(--text);
  corner-radius: 9px;
}
