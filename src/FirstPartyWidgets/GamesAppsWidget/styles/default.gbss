.games-apps-widget {
  width: 100vw;
  height: 100vh;
  min-width: 0px;
  min-height: 0px;
  max-width: 820px;
  gap: 10px;
  padding: 12px 14px;
  background: var(--surface);
  color: var(--text);
  overflow: clip;
}

.games-header {
  min-width: 0px;
  gap: 2px;
  flex-grow: 0;
  flex-shrink: 0;
}

.games-eyebrow,
.games-card-kind,
.games-card-hint {
  color: var(--text-muted);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.03em;
  max-lines: 1;
  text-transform: none;
}

.games-title {
  min-width: 0px;
  color: var(--text);
  font-size: 23px;
  font-weight: 500;
  line-height: 1.2;
  max-lines: 1;
  text-overflow: ellipsis;
}

.games-status {
  min-width: 0px;
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.3;
  max-lines: 2;
  text-overflow: ellipsis;
}

.games-status.is-ready { color: var(--success); }
.games-status.is-error { color: var(--danger, #c98181); }

.games-refresh-catalog {
  width: 100%;
  min-width: 0px;
  min-height: 38px;
  margin-top: 6px;
  flex-grow: 0;
  flex-shrink: 0;
}

.games-content {
  min-width: 0px;
  min-height: 0px;
  gap: 8px;
  flex-grow: 1;
  flex-shrink: 1;
  overflow: clip;
}

.games-section-heading {
  min-width: 0px;
  flex-grow: 0;
  flex-shrink: 0;
}

.games-catalog {
  min-width: 0px;
  min-height: 0px;
  gap: 8px;
  flex-grow: 1;
  flex-shrink: 1;
  overflow: clip;
}

.games-library-scroll {
  min-width: 0px;
  min-height: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 6px;
  padding: 3px;
  overflow: clip;
}

.games-card-action {
  width: 100%;
  min-width: 0px;
  min-height: 72px;
  padding: 7px 12px;
  background: var(--surface-raised);
  color: var(--text);
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  border-width: 1px;
  corner-radius: 9px;
  font-size: 15px;
  font-weight: 400;
  max-lines: 2;
  text-overflow: ellipsis;
  flex-grow: 0;
  flex-shrink: 0;
  transition-duration: 90ms;
  transition-easing: ease-out;
}

.games-card-action:selected {
  color: var(--success);
  background: var(--surface-subtle, rgba(39, 39, 36, 0.92));
}

.games-card-action:focused,
.games-primary-action:focused {
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.games-card-action:busy { opacity: 0.72; }
.games-load-more { color: var(--text-muted); background: transparent; min-height: 48px; }
.games-load-more:focused { color: var(--text); }

.games-state-shell {
  align: center;
  justify: center;
}

.games-state-surface {
  width: 100%;
  min-width: 0px;
  max-width: 580px;
  flex-grow: 0;
  flex-shrink: 1;
}

.games-state-progress {
  gap: 8px;
  padding: 18px;
  align: center;
  justify: center;
}

.games-state-loading,
.games-state-icon {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  padding: 4px;
  color: var(--text-muted);
  background: transparent;
}

.games-state-title {
  width: 100%;
  flex-shrink: 0;
  color: var(--text);
  font-size: 18px;
  font-weight: 500;
  line-height: 1.25;
  max-lines: 2;
  text-align: center;
  text-overflow: ellipsis;
}

.games-state-help {
  width: 100%;
  flex-shrink: 0;
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.35;
  max-lines: 4;
  text-align: center;
}

.games-primary-action {
  min-width: 176px;
  min-height: 48px;
  padding: 10px 14px;
  flex-shrink: 0;
}
