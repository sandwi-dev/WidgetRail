.games-apps-widget {
  width: 100vw;
  min-width: 0px;
  max-width: 780px;
  gap: 6px;
  padding: 12px 14px;
  background: var(--surface);
  color: var(--text);
  overflow: clip;
}

.games-header { gap: 1px; flex-shrink: 0; }

.games-eyebrow,
.games-section-label,
.games-section-count,
.games-card-kind,
.games-card-hint {
  color: var(--text-muted);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.03em;
  max-lines: 1;
  text-transform: none;
}

.games-section-count { color: var(--text-subdued); }

.games-title {
  color: var(--text);
  font-size: 23px;
  font-weight: 500;
  max-lines: 1;
  text-overflow: ellipsis;
}

.games-status,
.games-state-help {
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 400;
  max-lines: 2;
}

.games-status.is-ready { color: var(--success); }
.games-status.is-error { color: var(--danger, #c98181); }

.games-section-heading,
.games-card-meta {
  gap: 8px;
  align: center;
  justify: space-between;
  flex-shrink: 0;
}

.games-library-scroll {
  min-height: 112px;
  max-height: 132px;
  flex-grow: 0;
  flex-shrink: 1;
  gap: 8px;
  padding: 3px 4px 4px 3px;
  overflow: clip;
}

.games-card {
  width: 158px;
  min-width: 158px;
  min-height: 104px;
  gap: 4px;
  padding: 2px;
  background: transparent;
  border-color: transparent;
  border-width: 1px;
  corner-radius: 10px;
  flex-grow: 0;
  flex-shrink: 0;
}

.games-card-body {
  width: 154px;
  min-width: 154px;
  min-height: 70px;
  gap: 8px;
  padding: 8px;
  align: center;
  background: var(--surface-raised);
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  border-width: 1px;
  corner-radius: 9px;
}

.games-card-icon {
  width: 44px;
  height: 44px;
  min-width: 44px;
  padding: 9px;
  color: var(--text-muted);
  background: var(--surface-subtle, rgba(39, 39, 36, 0.92));
  corner-radius: 8px;
  flex-grow: 0;
  flex-shrink: 0;
}

.games-card-art {
  width: 44px;
  height: 44px;
  min-width: 44px;
  background: var(--surface-subtle, rgba(39, 39, 36, 0.92));
  corner-radius: 8px;
  flex-grow: 0;
  flex-shrink: 0;
}

.games-card-icon.is-saved { color: var(--success); }
.games-card-icon.is-add { color: var(--focus); }

.games-card-action {
  min-width: 0px;
  min-height: 50px;
  padding: 7px 6px;
  background: transparent;
  color: var(--text);
  border-color: transparent;
  border-width: 0px;
  corner-radius: 7px;
  font-size: 14px;
  font-weight: 400;
  max-lines: 2;
  text-overflow: ellipsis;
  flex-grow: 1;
  flex-shrink: 1;
  transition-duration: 90ms;
  transition-easing: ease-out;
}

.games-card-action:selected { color: var(--success); }

.games-card-action:focused,
.games-retry:focused {
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.games-card-action:busy { opacity: 0.72; }
.games-card-meta { padding: 0px 3px 1px; }
.games-card-hint { color: var(--text-muted); }
.games-card.is-load-more { background: transparent; }
.games-load-more { color: var(--text-muted); }

.games-state-card {
  min-height: 168px;
  gap: 8px;
  padding: 20px;
  align: center;
  justify: center;
  background: var(--surface-raised);
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  border-width: 1px;
  corner-radius: 10px;
  flex-grow: 1;
}

.games-state-icon {
  width: 32px;
  height: 32px;
  padding: 4px;
  color: var(--text-muted);
  background: transparent;
}

.games-state-title {
  color: var(--text);
  font-size: 18px;
  font-weight: 500;
  max-lines: 2;
}

.games-state-help { max-lines: 3; }

.games-retry {
  min-width: 150px;
  min-height: 44px;
  padding: 10px 14px;
  background: var(--surface-raised);
  color: var(--text);
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  border-width: 1px;
  corner-radius: 10px;
  font-weight: 400;
}
