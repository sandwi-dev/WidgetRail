{
  "manifestVersion": 1,
  "id": "widgetrail.firstparty.games-apps",
  "publisher": "widgetrail.firstparty",
  "name": "Games & Apps",
  "version": "0.1.4",
  "hostApi": {
    "minimum": "1.0",
    "maximumMajor": 1
  },
  "entrypoint": {
    "runtime": "dotnet-worker",
    "assembly": "payload/GamesAppsWidget.dll",
    "type": "WidgetRail.FirstPartyWidgets.GamesApps.GamesAppsWidget"
  },
  "presentation": {
    "icon": "play",
    "packageIcon": { "assetId": "games-apps.mark", "colorMode": "originalColor" }
  },
  "iconAssets": {
    "games-apps.mark": { "path": "assets/icons/games-apps.svg" },
    "games-apps.library": { "path": "assets/icons/library-big.svg" },
    "games-apps.add": { "path": "assets/icons/plus.svg" },
    "games-apps.running": { "path": "assets/icons/windows.svg" },
    "games-apps.application": { "path": "assets/icons/app-window.svg" },
    "games-apps.previous-page": { "path": "assets/icons/chevron-left.svg" },
    "games-apps.next-page": { "path": "assets/icons/chevron-right.svg" }
  },
  "permissions": [
    "system.apps.library.read.v1"
  ],
  "optionalPermissions": [
    "system.apps.library.launch.v1",
    "system.apps.running.read.v1",
    "system.apps.running.register.v1"
  ],
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "unload-after-idle",
    "idleSeconds": 120
  },
  "resourceRequest": {
    "memoryMb": 48,
    "updateHz": 4
  },
  "architectures": [
    "x64"
  ]
}
