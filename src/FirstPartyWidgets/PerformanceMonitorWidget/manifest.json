{
  "manifestVersion": 1,
  "id": "widgetrail.firstparty.performance-monitor",
  "publisher": "widgetrail.firstparty",
  "name": "Performance Monitor",
  "version": "0.1.2",
  "pinningSupported": true,
  "hostApi": { "minimum": "1.0", "maximumMajor": 1 },
  "entrypoint": { "runtime": "dotnet-worker", "assembly": "payload/PerformanceMonitorWidget.dll", "type": "WidgetRail.FirstPartyWidgets.PerformanceMonitor.PerformanceMonitorWidget" },
  "presentation": { "icon": "settings", "packageIcon": { "assetId": "performance.mark", "colorMode": "themeTint" } },
  "iconAssets": { "performance.mark": { "path": "assets/icons/performance.svg" } },
  "permissions": ["system.performance.read.v1"],
  "optionalPermissions": ["system.performance.fps.control.v1"],
  "residencyPolicy": { "schemaVersion": 1, "mode": "unload-after-idle", "idleSeconds": 120 },
  "resourceRequest": { "memoryMb": 32, "updateHz": 1 },
  "architectures": ["x64"]
}
