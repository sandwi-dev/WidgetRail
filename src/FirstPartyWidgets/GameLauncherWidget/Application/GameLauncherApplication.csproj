<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseAppHost>true</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>GameLauncherApplication</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\WidgetApplicationRuntime\WidgetApplicationRuntime.csproj" />
    <ProjectReference Include="..\GameLauncherWidget.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\WindowsAppLibraryProvider\*.cs"
             Exclude="..\..\..\WindowsAppLibraryProvider\AssemblyInfo.cs"
             Link="Backend\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
