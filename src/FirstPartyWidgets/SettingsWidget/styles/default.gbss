:root {
  --settings-accent: #8f80ff;
  --settings-danger: #ff5d73;
  --settings-surface: rgba(23, 26, 34, 0.98);
  --settings-row: rgba(44, 49, 62, 0.92);
}

.settings-widget {
  gap: 12px;
  padding: 20px 24px;
  background: var(--settings-surface);
  color: var(--text);
}

.settings-header,
.settings-page,
.category-list,
.theme-picker {
  gap: 10px;
}

.settings-header {
  flex-shrink: 0;
}

.settings-page,
.category-list {
  flex-grow: 1;
  flex-basis: 0;
  min-height: 44px;
}

.settings-title,
.page-heading {
  color: var(--text);
  font-size: 21px;
  font-weight: 600;
  max-lines: 1;
}

.settings-status,
.settings-summary,
.page-help,
.diagnostic-line,
.page-counter {
  color: var(--text-muted);
  font-size: 13px;
  max-lines: 2;
}

.settings-status.is-error,
.diagnostic-error,
.theme-item.is-invalid {
  color: var(--settings-danger);
}

.settings-status.is-busy {
  color: var(--warning);
}

.category-card,
.setting-row,
.setting-toggle,
.theme-item,
.primary-button,
.secondary-button,
.danger-button,
.setting-stepper-button {
  min-height: 44px;
  padding: 10px 13px;
  background: var(--settings-row);
  border-width: 0;
  corner-radius: 9px;
  transition-duration: 100ms;
  transition-easing: ease-out;
}

.category-card:focused,
.setting-row:focused,
.setting-toggle:focused,
.theme-item:focused,
.primary-button:focused,
.secondary-button:focused,
.setting-stepper-button:focused {
  background: var(--surface-raised);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -3px;
}

.setting-toggle:selected,
.theme-item.is-selected,
.setting-row.is-enabled {
  color: var(--settings-accent);
}

.primary-button {
  background: var(--settings-accent);
  color: #ffffff;
}

.primary-button:focused {
  background: #a99eff;
  color: #ffffff;
}

.setting-stepper,
.reset-actions {
  gap: 10px;
  align: center;
}

.setting-stepper-label {
  min-width: 180px;
  color: var(--text);
}

.setting-stepper-value {
  min-width: 64px;
  color: var(--text-muted);
  text-align: center;
}

.setting-stepper-button {
  width: 44px;
  height: 44px;
}

.danger-card,
.danger-button {
  color: var(--settings-danger);
}

.danger-button:focused {
  background: var(--settings-danger);
  color: var(--text);
  outline-color: #ff9aaa;
  outline-width: 2px;
  outline-offset: -3px;
}
