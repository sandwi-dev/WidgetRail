.settings-widget {
  gap: 10px;
  padding: 18px 20px;
  background: var(--surface);
  color: var(--text);
}

.settings-header,
.settings-page,
.root-category-list,
.theme-picker { gap: 8px; }

.settings-header { flex-shrink: 0; }
.theme-row {
  min-height: 52px;
  min-width: 0;
  flex-shrink: 0;
  padding: 10px 14px;
  gap: 12px;
  align: center;
  background: var(--surface-raised);
  border-width: 1px;
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  corner-radius: 8px;
}
.theme-row:selected { border-color: var(--accent); }
.theme-row:focused {
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.theme-name {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 0;
  font-size: 16px;
  font-weight: 600;
  max-lines: 2;
}
.theme-version { color: var(--text-muted); font-size: 13px; flex-shrink: 0; max-lines: 1; }
.theme-status { flex-shrink: 0; padding: 3px 8px; }
.settings-toast { flex-shrink: 0; }
.settings-header-row { gap: 8px; }
.header-title { flex-grow: 1; min-width: 0; }
.header-action { flex-shrink: 0; padding: 8px 14px; }
.header-quit { color: var(--warning); border-color: var(--warning); }
.header-restart { color: var(--accent); border-color: var(--accent); }

.section-heading {
  font-size: 16px;
  font-weight: 600;
  padding: 14px 0 2px;
  max-lines: 2;
}

.controller-driver { gap: 4px; padding: 4px 0; }

.settings-page {
  flex-grow: 1;
  flex-basis: 0;
  min-height: 44px;
}

.root-category-list { min-height: 44px; flex-grow: 1; flex-basis: 0; }


.category-grid {
  gap: 8px 10px;
  min-width: 0;
}

.settings-title,
.page-heading {
  color: var(--text);
  font-size: 21px;
  font-weight: 500;
  max-lines: 1;
}

.settings-status,
.settings-summary,
.page-help,
.diagnostic-line,
.page-counter {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 400;
  max-lines: 2;
}

.controllers-help { max-lines: 6; }
.widget-switcher-help { max-lines: 10; }
.controllers-status { color: var(--accent); font-weight: 600; max-lines: 6; }
.controllers-warning { color: var(--warning); }

.settings-status.is-error,
.diagnostic-error {
  color: var(--danger, #c98181);
  border-left-width: 2px;
  border-left-color: var(--danger, #c98181);
  padding: 0 0 0 8px;
}
.settings-status.is-busy { color: var(--warning); }

.diagnostic-area {
  width: 100%;
  min-width: 0px;
  max-lines: 8;
  overflow-wrap: anywhere;
}

.diagnostic-metric {
  width: 100%;
  min-width: 0px;
  max-lines: 2;
  overflow-wrap: anywhere;
}

.category-card,
.setting-row,
.wrail-switch,
.primary-button,
.secondary-button,
.danger-button,
.wrail-stepper__button {
  min-height: 44px;
  padding: 10px 12px;
  background: transparent;
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-weight: 400;
  transition-duration: 90ms;
  transition-easing: ease-out;
}

.category-card {
  padding: 16px;
  gap: 16px;
  align: center;
  height: 20vh;
  min-height: 88px;
  max-height: 128px;
  background: var(--surface-raised);
  border-width: 1px;
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  corner-radius: 10px;
}


.category-card:focused,
.setting-row:focused,
.wrail-switch:focused,
.primary-button:focused,
.secondary-button:focused,
.wrail-stepper__button:focused {
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.wrail-switch:selected,
.setting-row.is-enabled { color: var(--accent); }

.primary-button,
.secondary-button,
.wrail-stepper__button {
  background: var(--surface-raised);
  border-color: var(--border, rgba(246, 240, 226, 0.12));
}

.primary-button { color: var(--text); }
.primary-button:focused { color: var(--text); }

.wrail-stepper,
.reset-actions { gap: 10px; align: center; }
.wrail-stepper__label { min-width: 180px; color: var(--text); }
.wrail-stepper__value { min-width: 64px; color: var(--text-muted); text-align: center; }
.wrail-stepper__button { width: 44px; height: 44px; padding: 10px; }

.danger-card,
.danger-button { color: var(--danger, #c98181); }

.danger-button:focused {
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
  color: var(--danger, #c98181);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.home-header { align: center; gap: 14px; }
.home-mark { width: 38px; height: 38px; flex-shrink: 0; color: var(--accent); }
.home-title { font-size: 26px; font-weight: 600; max-lines: 1; }
.home-body { flex-grow: 1; flex-basis: 0; min-height: 0; gap: 12px; }
.home-loading { flex-grow: 1; flex-basis: 0; min-height: 0; align: start; justify: start; }
.home-loading-content { align: start; gap: 12px; }
.home-loading-message { color: var(--text-muted); font-size: 13px; max-lines: 1; }
.home-card-icon { width: 34px; height: 34px; flex-shrink: 0; color: var(--accent); }
.home-card-copy { flex-grow: 1; min-width: 0; gap: 6px; }
.home-card-title { color: var(--text); font-size: 18px; font-weight: 600; max-lines: 1; }
.home-card-description { color: var(--text-muted); font-size: 13px; max-lines: 2; }
.home-utilities { flex-shrink: 0; gap: 8px; }
.home-utility { min-height: 40px; padding: 8px 12px; font-size: 13px; color: var(--text-muted); }
.home-utility.danger-card { color: var(--danger, #c98181); }
.home-utility:focused { background: var(--surface-active, rgba(48, 47, 43, 0.98)); color: var(--text); outline-color: var(--focus); outline-width: 2px; outline-offset: -2px; }
