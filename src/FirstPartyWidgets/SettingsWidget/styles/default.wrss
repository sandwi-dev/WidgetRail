.settings-widget {
  gap: 10px;
  padding: 18px 20px;
  background: var(--surface);
  color: var(--text);
}

.settings-header,
.settings-page,
.root-category-list,
.theme-picker { gap: 8px; }

.settings-page-motion { flex-grow: 1; min-height: 0; min-width: 0; }
.theme-row {
  min-height: 52px;
  min-width: 0;
  padding: 10px 14px;
  gap: 12px;
  align: center;
  background: var(--surface-raised);
  border-width: 1px;
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  corner-radius: 8px;
}
.theme-row:selected { border-color: var(--accent); }
.theme-row:focused {
  outline-color: var(--focus);
  outline-width: var(--focus-width, 1.5px);
  outline-offset: var(--focus-offset, -1.5px);
}
.theme-name {
  flex-grow: 1;
  min-width: 0;
  font-size: 16px;
  font-weight: 600;
  max-lines: 2;
}
.theme-version { color: var(--text-muted); font-size: 13px; max-lines: 1; }
.theme-status { padding: 3px 8px; }
.settings-header-row { gap: 8px; }
.header-title { flex-grow: 1; min-width: 0; }
.header-action { padding: 8px 14px; }
.header-quit { color: var(--warning); border-color: var(--warning); }
.header-restart { color: var(--accent); border-color: var(--accent); }

.section-heading {
  font-size: 16px;
  font-weight: 600;
  padding: 14px 0 2px;
  max-lines: 2;
}

.controller-driver { gap: 4px; padding: 4px 0; }

.settings-page {
  flex-grow: 1;
  min-height: 44px;
}

.root-category-list { min-height: 44px; flex-grow: 1; }


.category-grid {
  /* The cards' margins already provide 12px between items. */
  gap: 0px;
  min-width: 0;
}

.settings-title,
.page-heading {
  color: var(--text);
  font-size: 21px;
  font-weight: 500;
  max-lines: 2;
}

.settings-status,
.settings-summary,
.page-help,
.diagnostic-line,
.page-counter {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 400;
  max-lines: 2;
}

.controllers-help { max-lines: 6; }
.widget-switcher-help { max-lines: 10; }
.controllers-status { color: var(--accent); font-weight: 600; max-lines: 6; }
.controllers-warning { color: var(--warning); }
.text-size-warning { color: var(--warning); max-lines: 8; }

.settings-status.is-error,
.diagnostic-error {
  color: var(--danger, #c98181);
  border-left-width: 2px;
  border-left-color: var(--danger, #c98181);
  padding: 0 0 0 8px;
}
.settings-status.is-busy { color: var(--warning); }

.diagnostic-area {
  width: 100%;
  min-width: 0px;
  max-lines: 8;
  overflow-wrap: anywhere;
}

.diagnostic-metric {
  width: 100%;
  min-width: 0px;
  max-lines: 2;
  overflow-wrap: anywhere;
}

.category-card,
.setting-row,
.wrail-switch,
.primary-button,
.secondary-button,
.danger-button,
.wrail-stepper__button {
  min-height: 44px;
  padding: 10px 12px;
  background: transparent;
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-weight: 400;
  transition-duration: 90ms;
  transition-easing: ease-out;
}

.category-card {
  padding: 16px;
  margin: 6px;
  scale: 1;
  transition-duration: 140ms;
  transition-easing: ease-in-out;
  gap: 16px;
  align: center;
  min-height: 88px;
  background: var(--surface-raised);
  border-width: 1px;
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  corner-radius: 10px;
}

.category-card:focused { scale: 1.025; }
.category-card:pressed { scale: 0.96; }


.category-card:focused,
.setting-row:focused,
.wrail-switch:focused,
.primary-button:focused,
.secondary-button:focused,
.wrail-stepper__button:focused {
  outline-color: var(--focus);
  outline-width: var(--focus-width, 1.5px);
  outline-offset: var(--focus-offset, -1.5px);
}

.wrail-switch:selected,
.setting-row.is-enabled { color: var(--accent); }

.wrail-switch--on,
.wrail-switch:selected,
.setting-row:selected { background: var(--surface-active, rgba(48, 47, 43, 0.98)); }
.wrail-switch:disabled,
.setting-row:disabled { background: var(--surface-subtle, rgba(39, 39, 36, 0.92)); }

.primary-button,
.secondary-button,
.wrail-stepper__button {
  background: var(--surface-raised);
  border-color: var(--border, rgba(246, 240, 226, 0.12));
}

.primary-button { color: var(--text); }
.primary-button:focused { color: var(--text); }

.wrail-stepper,
.reset-actions { gap: 10px; align: center; }
.wrail-stepper__label { min-width: 180px; color: var(--text); }
.wrail-stepper__value { min-width: 64px; color: var(--text-muted); text-align: center; }
.wrail-stepper__button { width: 44px; height: 44px; padding: 10px; }

.danger-card,
.danger-button { color: var(--danger, #c98181); }

.danger-button:focused {
  color: var(--danger, #c98181);
  outline-color: var(--focus);
  outline-width: var(--focus-width, 1.5px);
  outline-offset: var(--focus-offset, -1.5px);
}

.home-header { align: center; gap: 14px; }
.home-mark { width: 38px; height: 38px; color: var(--accent); }
.home-title { font-size: 26px; font-weight: 600; max-lines: 1; }
.home-body { flex-grow: 1; min-height: 0; gap: 12px; }
.home-loading { flex-grow: 1; min-height: 0; align: start; justify: start; }
.home-loading-content { align: start; gap: 12px; }
.home-loading-message { color: var(--text-muted); font-size: 13px; max-lines: 1; }
.home-card-icon { width: 34px; height: 34px; color: var(--accent); }
.home-card-copy { flex-grow: 1; min-width: 0; gap: 6px; }
.home-card-title { color: var(--text); font-size: 18px; font-weight: 600; max-lines: 2; }
.home-card-description { color: var(--text-muted); font-size: 13px; max-lines: 2; }
.home-utilities { gap: 8px; }
.home-utility { min-height: 40px; padding: 8px 12px; font-size: 13px; color: var(--text-muted); }
.home-utility.danger-card { color: var(--danger, #c98181); }
.home-utility:focused { color: var(--text); outline-color: var(--focus); outline-width: var(--focus-width, 1.5px); outline-offset: var(--focus-offset, -1.5px); }

/* One shared reading rhythm; controls retain stable IDs during responsive reflow. */
.wrail-setting-row { gap: 12px; padding: 12px 14px; min-width: 0; background: var(--surface-raised); border-width: 1px; border-color: var(--border, rgba(246, 240, 226, 0.12)); corner-radius: 8px; }
.wrail-setting-row__copy { gap: 4px; min-width: 0; justify: center; }
.wrail-setting-row__label { font-size: 15px; font-weight: 500; color: var(--text); }
.wrail-setting-row__description { font-size: 13px; color: var(--text-muted); }
.wrail-setting-row__control { min-width: 0; justify: center; }
.setting-control { width: 100%; min-height: 44px; text-align: start; background: var(--surface); border-width: 1px; border-color: var(--border, rgba(246, 240, 226, 0.12)); }
.wrail-stepper { width: 100%; justify: end; }
.wrail-stepper__value { flex-grow: 1; }
.setting-row, .primary-button, .secondary-button, .danger-button { text-align: start; }
.section-heading { padding: 16px 0 4px; }
.settings-header-row { align: center; }
.home-utilities { justify: end; }
