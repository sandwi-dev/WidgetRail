.settings-widget {
  gap: 10px;
  padding: 18px 20px;
  background: var(--surface);
  color: var(--text);
}

.settings-header,
.settings-page,
.root-category-list,
.theme-picker { gap: 8px; }

.settings-header { flex-shrink: 0; }

.settings-page {
  flex-grow: 1;
  flex-basis: 0;
  min-height: 44px;
}

.root-category-list { min-height: 44px; }

.category-grid {
  gap: 8px 10px;
  min-width: 0;
}

.settings-title,
.page-heading {
  color: var(--text);
  font-size: 21px;
  font-weight: 500;
  max-lines: 1;
}

.settings-status,
.settings-summary,
.page-help,
.diagnostic-line,
.page-counter {
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 400;
  max-lines: 2;
}

.settings-status.is-error,
.diagnostic-error {
  color: var(--danger, #c98181);
  border-left-width: 2px;
  border-left-color: var(--danger, #c98181);
  padding: 0 0 0 8px;
}
.settings-status.is-busy { color: var(--warning); }

.category-card,
.setting-row,
.wrail-toggle,
.primary-button,
.secondary-button,
.danger-button,
.wrail-stepper__button {
  min-height: 44px;
  padding: 10px 12px;
  background: transparent;
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-weight: 400;
  transition-duration: 90ms;
  transition-easing: ease-out;
}

.category-card:focused,
.setting-row:focused,
.wrail-toggle:focused,
.primary-button:focused,
.secondary-button:focused,
.wrail-stepper__button:focused {
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.wrail-toggle:selected,
.setting-row.is-enabled { color: var(--accent); }

.primary-button,
.secondary-button,
.wrail-stepper__button {
  background: var(--surface-raised);
  border-color: var(--border, rgba(246, 240, 226, 0.12));
}

.primary-button { color: var(--text); }
.primary-button:focused { color: var(--text); }

.wrail-stepper,
.reset-actions { gap: 10px; align: center; }
.wrail-stepper__label { min-width: 180px; color: var(--text); }
.wrail-stepper__value { min-width: 64px; color: var(--text-muted); text-align: center; }
.wrail-stepper__button { width: 44px; height: 44px; padding: 10px; }

.danger-card,
.danger-button { color: var(--danger, #c98181); }

.danger-button:focused {
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
  color: var(--danger, #c98181);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
