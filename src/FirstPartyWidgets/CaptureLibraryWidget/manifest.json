{
  "manifestVersion": 1,
  "id": "widgetrail.firstparty.capture-library",
  "publisher": "widgetrail.firstparty",
  "name": "Capture Library",
  "version": "0.2.10",
  "trayActions": [
    { "id": "screenshot", "label": "Take screenshot", "wakeOnInvoke": true },
    { "id": "record-clip", "label": "Record clip", "wakeOnInvoke": true },
    { "id": "save-replay", "label": "Save replay", "wakeOnInvoke": true, "statusOperation": "capture.replay.save", "fallbackId": "start-replay" },
    { "id": "start-replay", "label": "Start replay", "wakeOnInvoke": true, "statusOperation": "capture.replay.start" },
    { "id": "stop-replay", "label": "Stop replay", "wakeOnInvoke": true, "statusOperation": "capture.replay.stop" }
  ],
  "hostApi": {
    "minimum": "1.0",
    "maximumMajor": 1
  },
  "entrypoint": {
    "runtime": "dotnet-worker",
    "assembly": "payload/CaptureLibraryWidget.dll",
    "type": "WidgetRail.FirstPartyWidgets.CaptureLibrary.CaptureLibraryWidget"
  },
  "presentation": {
    "icon": "fullscreen",
    "packageIcon": {
      "assetId": "captures.mark",
      "colorMode": "themeTint"
    }
  },
  "iconAssets": {
    "captures.mark": {
      "path": "assets/icons/captures.svg"
    },
    "captures.record": {
      "path": "assets/icons/record.svg"
    },
    "captures.replay": {
      "path": "assets/icons/replay.svg"
    },
    "captures.filter": {
      "path": "assets/icons/filter.svg"
    },
    "captures.select": {
      "path": "assets/icons/select.svg"
    },
    "captures.view": {
      "path": "assets/icons/view.svg"
    },
    "captures.show": {
      "path": "assets/icons/show.svg"
    },
    "captures.hide": {
      "path": "assets/icons/hide.svg"
    }
  },
  "permissions": [
    "system.apps.windows.capture.v1",
    "media.capture-library.read.v1",
    "media.capture-library.save.v1"
  ],
  "optionalPermissions": [
    "media.capture-library.manage.v1",
    "media.capture-library.recycle-linked.v1"
  ],
  "intents": {
    "requests": [
      {
        "id": "widgetrail.captures.associate",
        "version": 1,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "captures": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 32,
                    "maxLength": 32
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  }
                },
                "required": [
                  "id",
                  "revision"
                ]
              }
            }
          },
          "required": [
            "captures"
          ]
        }
      },
      {
        "id": "widgetrail.settings.permissions.open",
        "version": 1,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "packageId": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128
            }
          },
          "required": [
            "packageId"
          ]
        }
      },
      {
        "id": "widgetrail.related-item.open",
        "version": 1,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "packageId": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "packageId",
            "kind",
            "id"
          ]
        }
      },
      {
        "id": "widgetrail.files.share",
        "version": 1,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "offerId": {
              "type": "string",
              "minLength": 32,
              "maxLength": 32
            }
          },
          "required": [
            "offerId"
          ]
        }
      }
    ],
    "handles": [
      {
        "id": "widgetrail.captures.browse",
        "version": 1,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "originPackageId": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128
            },
            "referenceKind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            },
            "referenceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "originPackageId",
            "referenceKind",
            "referenceId"
          ]
        }
      },
      {
        "id": "widgetrail.captures.browse",
        "version": 2,
        "payloadSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "originPackageId": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128
            },
            "referenceKind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            },
            "referenceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "referenceLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "originPackageId",
            "referenceKind",
            "referenceId",
            "referenceLabel"
          ]
        }
      }
    ]
  },
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "unload-after-idle",
    "idleSeconds": 120
  },
  "resourceRequest": {
    "memoryMb": 48,
    "updateHz": 2
  },
  "architectures": [
    "x64"
  ]
}
