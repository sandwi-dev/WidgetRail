.capture-library { padding: 16px; gap: 12px; background: var(--surface); color: var(--text); }
.capture-title { font-size: 24px; font-weight: 600; }
.capture-heading { font-size: 17px; font-weight: 600; }
.capture-help { font-size: 13px; color: var(--text-muted); }
.capture-entry { padding: 12px; corner-radius: 8px; background: var(--surface-raised); }
.capture-entry-copy { gap: 4px; }
.capture-preview { height: 320px; }
