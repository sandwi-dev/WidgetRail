.audio-shell {
  width: 100%;
  min-width: 0;
  min-height: 0;
  gap: 0;
  background: var(--surface);
}

.audio-toast {
  margin: 0px 14px 14px 14px;
}

.audio-mixer-widget {
  flex-grow: 1;
  min-height: 0;
  width: 100%;
  min-width: 280px;
  gap: 8px;
  padding: 14px;
  background: var(--surface);
  color: var(--text);
  overflow: clip;
}

.audio-header {
  gap: 1px;
  flex-shrink: 0;
}

.audio-eyebrow {
  color: var(--text-muted);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.03em;
  max-lines: 1;
  text-transform: none;
}

.audio-title {
  color: var(--text);
  font-size: 23px;
  font-weight: 500;
  max-lines: 1;
  text-overflow: ellipsis;
}

.audio-status,
.audio-help,
.audio-session-state {
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 400;
  max-lines: 2;
}

.audio-status.is-error { color: var(--danger, #c98181); }
.audio-status.is-live,
.audio-session-state.is-active { color: var(--success); }

.audio-state-card,
.audio-master-card,
.audio-device-card,
.audio-session-card {
  width: 100%;
  gap: 6px;
  padding: 9px 10px;
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  border-width: 1px;
  corner-radius: 10px;
}

.audio-state-card,
.audio-master-card,
.audio-device-card {
  background: var(--surface-raised);
}

.audio-master-card,
.audio-input-card,
.audio-device-card,
.audio-state-card,
.audio-session-card { flex-shrink: 0; }

.audio-device-card {
  gap: 5px;
  padding: 8px 10px;
}

.audio-device-row {
  width: 100%;
  gap: 8px;
  min-height: 44px;
  align: center;
}

.audio-device-icon {
  width: 22px;
  height: 22px;
  padding: 1px;
  color: var(--text-muted);
  background: transparent;
  flex-shrink: 0;
}

.audio-device-copy {
  min-width: 0px;
  gap: 0px;
  flex-grow: 1;
  flex-shrink: 1;
}

.audio-device-label {
  color: var(--text-muted);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.03em;
  max-lines: 1;
}

.audio-device-name {
  color: var(--text);
  font-size: 12px;
  font-weight: 400;
  max-lines: 1;
  text-overflow: ellipsis;
}

.audio-master-heading,
.audio-sessions-heading,
.audio-session-heading,
.audio-volume-control-row {
  width: 100%;
  gap: 8px;
  align: center;
  justify: space-between;
}

.audio-master-label,
.audio-master-state,
.audio-sessions-label,
.audio-sessions-count {
  color: var(--text-muted);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.03em;
  max-lines: 1;
  text-transform: none;
}

.audio-master-state.is-muted { color: var(--danger, #c98181); }
.audio-sessions-count { color: var(--text-subdued); }
.audio-sessions-heading { flex-shrink: 0; }

.audio-session-list {
  width: 100%;
  flex-shrink: 0;
  gap: 2px;
  padding: 1px 3px 1px 1px;
}

.audio-session-card {
  padding: 9px 6px;
  background: transparent;
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
}

.audio-session-name {
  color: var(--text);
  font-size: 15px;
  font-weight: 500;
  min-width: 0px;
  max-lines: 1;
  text-overflow: ellipsis;
  flex-grow: 1;
  flex-shrink: 1;
}

.audio-mute-icon {
  width: 28px;
  height: 28px;
  padding: 3px;
  color: var(--text-muted);
  background: transparent;
  flex-shrink: 0;
}

.audio-mute-icon.is-muted { color: var(--danger, #c98181); }

.audio-volume-slider {
  height: 44px;
  min-width: 0px;
  flex-grow: 1;
  flex-shrink: 1;
  color: var(--accent);
  background: var(--surface-subtle, rgba(39, 39, 36, 0.92));
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  border-width: 1px;
  corner-radius: 10px;
  outline-color: transparent;
  outline-width: 0;
  transition-duration: 90ms;
  transition-easing: ease-out;
}

.audio-volume-slider:focused {
  color: var(--accent);
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.audio-volume-value {
  width: 42px;
  color: var(--text);
  font-size: 13px;
  font-weight: 500;
  text-align: end;
  flex-shrink: 0;
}

.audio-session-state {
  width: 48px;
  max-lines: 1;
  text-align: end;
  flex-shrink: 0;
}

.audio-state-title {
  color: var(--text);
  font-size: 17px;
  font-weight: 500;
  max-lines: 1;
}

.audio-retry-action {
  min-height: 44px;
  padding: 10px 14px;
  color: var(--text);
  background: var(--surface-raised);
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  border-width: 1px;
  corner-radius: 10px;
  font-weight: 400;
  transition-duration: 90ms;
  transition-easing: ease-out;
}

.audio-retry-action:focused {
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.audio-session-card.is-pending { background: var(--surface-subtle, rgba(39, 39, 36, 0.92)); }

.audio-device-selector {
  width: 100%;
  min-height: 44px;
  font-size: 14px;
}
