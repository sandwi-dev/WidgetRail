:root {
  --audio-accent: #59d5ff;
  --audio-accent-strong: #27bfea;
  --audio-focus: #c8f2ff;
  --audio-surface: rgba(14, 18, 26, 0.98);
  --audio-card: rgba(34, 41, 54, 0.94);
  --audio-master: rgba(27, 45, 58, 0.97);
  --audio-track: rgba(106, 119, 140, 0.38);
  --audio-error: #ff7c91;
}

.audio-mixer-widget {
  width: 100vw;
  min-width: 280px;
  max-width: 560px;
  gap: 10px;
  padding: 16px;
  background: var(--audio-surface);
  color: var(--text);
  overflow: clip;
}

.audio-header {
  gap: 2px;
}

.audio-eyebrow {
  color: var(--audio-accent);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.11em;
  max-lines: 1;
  text-transform: uppercase;
}

.audio-title {
  color: var(--text);
  font-size: 25px;
  font-weight: 700;
  max-lines: 1;
  text-overflow: ellipsis;
}

.audio-status,
.audio-help,
.audio-session-count,
.audio-session-state {
  color: var(--text-muted);
  font-size: 12px;
  max-lines: 2;
}

.audio-status.is-error {
  color: var(--audio-error);
}

.audio-status.is-live,
.audio-session-state.is-active {
  color: var(--success);
}

.audio-state-card,
.audio-master-card,
.audio-session-card {
  gap: 8px;
  padding: 11px 12px;
  background: var(--audio-card);
  border-width: 0;
  corner-radius: 13px;
}

.audio-master-card {
  background: var(--audio-master);
}

.audio-master-heading,
.audio-sessions-heading,
.audio-session-heading,
.audio-volume-control-row {
  gap: 10px;
  align: center;
  justify: space-between;
}

.audio-master-label,
.audio-master-state,
.audio-sessions-label,
.audio-sessions-count {
  color: var(--audio-accent);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  max-lines: 1;
  text-transform: uppercase;
}

.audio-master-state.is-muted {
  color: var(--audio-error);
}

.audio-sessions-label {
  color: var(--text-muted);
}

.audio-sessions-count {
  letter-spacing: 0.02em;
}

.audio-session-list {
  min-height: 156px;
  max-height: 340px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 8px;
  padding: 2px 4px 2px 2px;
  overflow: clip;
}

.audio-session-details {
  min-width: 80px;
  flex-grow: 1;
  gap: 1px;
}

.audio-session-name {
  color: var(--text);
  font-size: 16px;
  font-weight: 700;
  max-lines: 1;
  text-overflow: ellipsis;
}

.audio-mute-icon {
  width: 30px;
  height: 30px;
  padding: 4px;
  color: var(--audio-accent);
  background: rgba(75, 91, 111, 0.30);
  shape: circle;
  flex-shrink: 0;
}

.audio-mute-icon.is-muted {
  color: var(--audio-error);
  background: rgba(255, 124, 145, 0.13);
}

.audio-volume-slider {
  height: 44px;
  min-width: 132px;
  flex-grow: 1;
  color: var(--audio-accent-strong);
  background: var(--audio-track);
  outline-color: transparent;
  outline-width: 0;
  transition-duration: 90ms;
  transition-easing: ease-out;
}

.audio-volume-slider:focused {
  color: var(--audio-focus);
  background: rgba(106, 119, 140, 0.54);
  outline-color: var(--audio-focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.audio-volume-value {
  width: 42px;
  color: var(--text);
  font-size: 14px;
  font-weight: 700;
  text-align: end;
  flex-shrink: 0;
}

.audio-state-title {
  color: var(--text);
  font-size: 18px;
  font-weight: 700;
  max-lines: 1;
}

.audio-retry-action {
  min-height: 44px;
  padding: 11px 16px;
  color: var(--text);
  background: rgba(49, 58, 73, 0.96);
  border-width: 0;
  corner-radius: 11px;
  transition-duration: 90ms;
  transition-easing: ease-out;
}

.audio-retry-action:focused {
  background: rgba(67, 81, 101, 0.98);
  outline-color: var(--audio-focus);
  outline-width: 2px;
  outline-offset: -2px;
}

.audio-session-card.is-pending {
  background: rgba(40, 53, 68, 0.98);
}
