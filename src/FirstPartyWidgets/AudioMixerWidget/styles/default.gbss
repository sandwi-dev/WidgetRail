:root {
  --audio-accent: #70d7ff;
  --audio-accent-strong: #3bbfed;
  --audio-focus: #b9ecff;
  --audio-surface: rgba(18, 22, 30, 0.98);
  --audio-card: rgba(38, 45, 58, 0.94);
  --audio-control: rgba(49, 58, 73, 0.96);
  --audio-control-focus: rgba(67, 81, 101, 0.98);
  --audio-error: #ff7c91;
}

.audio-mixer-widget {
  width: 100vw;
  min-width: 280px;
  max-width: 560px;
  gap: 12px;
  padding: 16px;
  background: var(--audio-surface);
  color: var(--text);
  overflow: clip;
}

.audio-header {
  gap: 3px;
}

.audio-eyebrow {
  color: var(--audio-accent);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.10em;
  max-lines: 1;
  text-transform: uppercase;
}

.audio-title {
  color: var(--text);
  font-size: 24px;
  font-weight: 700;
  max-lines: 1;
  text-overflow: ellipsis;
}

.audio-status,
.audio-help,
.audio-session-count,
.audio-session-state,
.audio-control-status {
  color: var(--text-muted);
  font-size: 13px;
  max-lines: 2;
}

.audio-status.is-error,
.audio-control-status.is-error {
  color: var(--audio-error);
}

.audio-status.is-live,
.audio-session-state.is-active {
  color: var(--success);
}

.audio-state-card,
.audio-master-card,
.audio-session-card {
  gap: 10px;
  padding: 12px;
  background: var(--audio-card);
  border-width: 0;
  corner-radius: 15px;
}

.audio-master-card {
  gap: 9px;
  background: rgba(31, 48, 61, 0.96);
}

.audio-master-heading {
  gap: 10px;
  align: center;
  justify: space-between;
}

.audio-master-label,
.audio-master-state {
  color: var(--audio-accent);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  max-lines: 1;
}

.audio-master-state.is-muted {
  color: var(--audio-error);
}

.audio-master-controls {
  min-height: 46px;
}

.audio-master-progress {
  color: var(--audio-accent);
}

.audio-state-title {
  color: var(--text);
  font-size: 19px;
  font-weight: 700;
  max-lines: 1;
}

.audio-sessions-heading,
.audio-session-heading {
  gap: 10px;
  align: center;
  justify: space-between;
}

.audio-sessions-label,
.audio-sessions-count {
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  max-lines: 1;
  text-transform: uppercase;
}

.audio-sessions-count {
  color: var(--audio-accent);
  letter-spacing: 0.02em;
}

.audio-session-list {
  min-height: 176px;
  max-height: 360px;
  flex-grow: 1;
  flex-shrink: 1;
  gap: 10px;
  padding: 0 2px 0 0;
  overflow: clip;
}

.audio-session-details {
  min-width: 80px;
  flex-grow: 1;
  gap: 2px;
}

.audio-session-name {
  color: var(--text);
  font-size: 17px;
  font-weight: 700;
  max-lines: 1;
  text-overflow: ellipsis;
}

.audio-volume-row {
  gap: 12px;
  align: center;
}

.audio-volume-progress {
  height: 6px;
  min-width: 120px;
  flex-grow: 1;
  color: var(--audio-accent-strong);
  background: rgba(103, 113, 133, 0.40);
}

.audio-volume-value {
  width: 48px;
  color: var(--text);
  font-size: 14px;
  font-weight: 700;
  text-align: end;
}

.audio-controls {
  min-height: 48px;
  gap: 8px;
  align: center;
  justify: center;
}

.audio-volume-action,
.audio-mute-action,
.audio-retry-action {
  color: var(--text);
  background: var(--audio-control);
  border-width: 0;
  transition-duration: 110ms;
  transition-easing: ease-out;
}

.audio-volume-action {
  width: 42px;
  height: 42px;
  padding: 9px;
  shape: circle;
}

.audio-mute-action {
  min-width: 88px;
  max-width: 156px;
  flex-grow: 1;
  height: 46px;
  padding: 10px 16px;
  corner-radius: 23px;
}

.audio-mute-action.is-muted {
  color: var(--audio-error);
}

.audio-retry-action {
  min-height: 44px;
  padding: 12px 18px;
  corner-radius: 12px;
}

.audio-volume-action:focused,
.audio-mute-action:focused,
.audio-retry-action:focused {
  background: var(--audio-control-focus);
  outline-color: var(--audio-focus);
  outline-width: 2px;
  outline-offset: -3px;
  scale: 1.04;
}

.audio-mute-action:focused {
  background: var(--audio-accent-strong);
  color: #08131a;
}

.audio-session-card.is-pending {
  background: rgba(43, 57, 72, 0.98);
}
