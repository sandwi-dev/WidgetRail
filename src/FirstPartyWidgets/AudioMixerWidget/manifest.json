{
  "manifestVersion": 1,
  "id": "widgetrail.firstparty.audio-mixer",
  "publisher": "widgetrail.firstparty",
  "name": "Audio Mixer",
  "version": "0.1.0",
  "hostApi": {
    "minimum": "1.0",
    "maximumMajor": 1
  },
  "entrypoint": {
    "runtime": "dotnet-worker",
    "assembly": "payload/AudioMixerWidget.dll",
    "type": "WidgetRail.FirstPartyWidgets.AudioMixer.AudioMixerWidget"
  },
  "presentation": { "icon": "volume" },
  "permissions": [
    "system.audio.sessions.read.v1",
    "system.audio.output.read.v1"
  ],
  "optionalPermissions": [
    "system.audio.sessions.control.v1",
    "system.audio.output.control.v1",
    "system.audio.devices.read.v1",
    "system.audio.input.read.v1",
    "system.audio.input.control.v1"
  ],
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "suspend-when-hidden"
  },
  "resourceRequest": {
    "memoryMb": 64,
    "updateHz": 10
  },
  "architectures": [
    "x64"
  ]
}
