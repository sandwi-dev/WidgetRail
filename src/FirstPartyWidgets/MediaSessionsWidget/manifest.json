{
  "manifestVersion": 1,
  "id": "widgetrail.firstparty.media-sessions",
  "publisher": "widgetrail.firstparty",
  "name": "Now Playing",
  "version": "0.1.2",
  "pinningSupported": true,
  "fullWidgetPinningSupported": true,
  "hostApi": {
    "minimum": "1.0",
    "maximumMajor": 1
  },
  "entrypoint": {
    "runtime": "dotnet-worker",
    "assembly": "payload/MediaSessionsWidget.dll",
    "type": "WidgetRail.FirstPartyWidgets.MediaSessions.MediaSessionsWidget"
  },
  "presentation": {
    "icon": "music",
    "packageIcon": { "assetId": "media-sessions.mark", "colorMode": "originalColor" }
  },
  "iconAssets": {
    "media-sessions.mark": { "path": "assets/icons/media-sessions.svg" }
  },
  "permissions": [
    "system.media.sessions.read.v1"
  ],
  "optionalPermissions": [
    "system.media.sessions.control.v1"
  ],
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "suspend-when-hidden"
  },
  "resourceRequest": {
    "memoryMb": 48,
    "updateHz": 4
  },
  "architectures": [
    "x64"
  ]
}
