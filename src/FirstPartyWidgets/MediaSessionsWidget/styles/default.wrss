.media-sessions-widget {
  width: 100vw;
  min-width: 0px;
  max-width: 580px;
  gap: 8px;
  padding: 14px 16px;
  background: var(--surface);
  color: var(--text);
  overflow: clip;
}

.media-header { gap: 1px; flex-shrink: 0; }
.media-heading { gap: 12px; align: end; justify: space-between; }
.media-eyebrow {
  color: var(--text-muted);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.03em;
  max-lines: 1;
  text-transform: none;
}
.media-title { color: var(--text); font-size: 23px; font-weight: 500; max-lines: 1; }
.media-status {
  color: var(--text-muted);
  font-size: 11px;
  font-weight: 400;
  max-lines: 1;
  text-align: end;
  text-overflow: ellipsis;
}
.media-status.is-live { color: var(--success); }
.media-status.is-error { color: var(--danger, #c98181); }

.media-session-list {
  width: 100%;
  min-width: 0px;
  min-height: 46px;
  max-height: 46px;
  gap: 4px;
  padding: 1px 2px;
  overflow: clip;
  flex-shrink: 0;
}
.media-session-pill {
  width: 148px;
  min-width: 148px;
  max-width: 148px;
  min-height: 44px;
  padding: 9px 11px;
  color: var(--text-muted);
  background: transparent;
  border-color: transparent;
  border-width: 1px;
  corner-radius: 8px;
  font-weight: 400;
  flex-grow: 0;
  flex-shrink: 0;
  max-lines: 1;
  text-overflow: ellipsis;
}
.media-session-pill.is-playing { color: var(--text); }
.media-session-pill:focused {
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.media-session-pill:selected { background: var(--surface-subtle, rgba(39, 39, 36, 0.92)); color: var(--text); }

.media-now-playing {
  gap: 14px;
  padding: 14px 16px;
  align: center;
  background: var(--surface-raised);
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  border-width: 1px;
  corner-radius: 10px;
  flex-shrink: 0;
}
.media-artwork {
  width: 76px;
  height: 76px;
  min-width: 76px;
  min-height: 76px;
  corner-radius: 8px;
  flex-shrink: 0;
}
.media-artwork-placeholder {
  padding: 21px;
  color: var(--text-muted);
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
}
.media-track-details { min-width: 0px; gap: 7px; flex-grow: 1; }
.media-track-title {
  color: var(--text);
  font-size: 22px;
  font-weight: 500;
  max-lines: 1;
  text-overflow: ellipsis;
}
.media-track-artist {
  color: var(--text-muted);
  font-size: 14px;
  font-weight: 400;
  max-lines: 1;
  text-overflow: ellipsis;
}
.media-timeline { gap: 9px; align: center; margin: 5px 0 0; }
.media-time { width: 42px; color: var(--text-muted); font-size: 11px; max-lines: 1; }
.media-time.is-duration { text-align: end; }
.media-progress {
  min-width: 210px;
  height: 4px;
  flex-grow: 1;
  color: var(--accent);
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
}

.media-controls { height: 52px; gap: 10px; align: center; justify: center; flex-shrink: 0; }
.media-transport,
.media-play {
  color: var(--text);
  background: var(--surface-raised);
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  border-width: 1px;
  shape: circle;
  transition-duration: 90ms;
  transition-easing: ease-out;
}
.media-transport { width: 44px; height: 44px; min-width: 44px; min-height: 44px; padding: 11px; }
.media-play {
  width: 52px;
  height: 52px;
  min-width: 52px;
  min-height: 52px;
  padding: 14px;
  background: var(--accent);
  color: var(--canvas, #090908);
  border-color: transparent;
}
.media-transport:focused,
.media-play:focused {
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
  color: var(--text);
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
.media-play:focused { background: var(--accent); color: var(--canvas, #090908); }
.media-transport:disabled,
.media-play:disabled { opacity: 0.48; }

.media-state-card {
  min-height: 220px;
  gap: 8px;
  padding: 22px;
  align: center;
  justify: center;
  background: var(--surface-raised);
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  border-width: 1px;
  corner-radius: 10px;
}
.media-state-icon { width: 32px; height: 32px; padding: 4px; color: var(--text-muted); }
.media-state-title { color: var(--text); font-size: 18px; font-weight: 500; max-lines: 1; }
.media-state-help { color: var(--text-muted); font-size: 12px; max-lines: 2; text-align: center; }
.media-retry {
  min-height: 44px;
  padding: 10px 14px;
  color: var(--text);
  background: var(--surface-raised);
  border-color: var(--border, rgba(246, 240, 226, 0.12));
  border-width: 1px;
  corner-radius: 10px;
  font-weight: 400;
}
.media-retry:focused {
  background: var(--surface-active, rgba(48, 47, 43, 0.98));
  outline-color: var(--focus);
  outline-width: 2px;
  outline-offset: -2px;
}
