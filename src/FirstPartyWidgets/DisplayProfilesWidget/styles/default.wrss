.display-widget { padding: 18px; gap: 14px; background: var(--surface); color: var(--text); }
.display-header { align: center; gap: 14px; flex-shrink: 0; }
.display-title { font-size: 26px; font-weight: 700; flex-grow: 1; min-width: 0; }
.display-save { min-height: 44px; padding: 6px 12px; background: var(--surface-raised); corner-radius: 10px; }
.display-current { padding: 12px 16px; gap: 8px; background: var(--surface-raised); corner-radius: 12px; flex-shrink: 0; }
.display-section-title { font-size: 16px; font-weight: 600; }
.display-summary { color: var(--text-muted); font-size: 13px; max-lines: 2; text-overflow: ellipsis; }
.display-list { flex-grow: 1; flex-shrink: 1; min-height: 80px; gap: 10px; }
.display-card { min-width: 0; gap: 14px; padding: 14px; corner-radius: 12px; background: var(--surface-raised); border-width: 1px; border-color: var(--border, #444444); }
.display-card:focused { border-color: var(--accent); background: var(--surface-selected, var(--surface-raised)); }
.display-card-copy { min-width: 0; flex-grow: 1; gap: 5px; }
.display-profile-name { font-size: 19px; font-weight: 600; max-lines: 1; text-overflow: ellipsis; }
.display-current-badge { color: var(--accent); font-size: 12px; font-weight: 600; }
.display-unavailable { color: var(--warning); font-size: 12px; max-lines: 2; }
.display-monitor-strip { gap: 8px; align: center; flex-shrink: 0; }
.display-monitor { gap: 3px; align: center; width: 62px; }
.display-monitor-icon { width: 44px; height: 32px; color: var(--text-muted); }
.display-monitor-primary { color: var(--accent); }
.display-monitor-label { font-size: 10px; color: var(--text-muted); }
.display-help { font-size: 12px; color: var(--text-muted); flex-shrink: 0; }
.display-warning { color: var(--warning); max-lines: 2; }
.display-dialog { padding: 18px; gap: 16px; background: var(--surface-raised); corner-radius: 12px; }
.display-dialog-title { font-size: 23px; font-weight: 600; }
.display-name { padding: 14px; min-height: 50px; background: var(--surface); corner-radius: 10px; }
.display-actions { gap: 12px; }
button { padding: 12px 22px; min-height: 48px; corner-radius: 10px; }
.display-countdown { color: var(--warning); font-size: 18px; }
.display-empty { padding: 22px; gap: 10px; }
