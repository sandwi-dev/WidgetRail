{
  "manifestVersion": 1,
  "id": "widgetrail.firstparty.recent-apps",
  "publisher": "widgetrail.firstparty",
  "name": "Recent Apps",
  "version": "0.1.0",
  "hostApi": {
    "minimum": "1.0",
    "maximumMajor": 1
  },
  "entrypoint": {
    "runtime": "dotnet-worker",
    "assembly": "payload/RecentAppsWidget.dll",
    "type": "WidgetRail.FirstPartyWidgets.RecentApps.RecentAppsWidget"
  },
  "presentation": { "icon": "play" },
  "permissions": [
    "system.activity.recent.read.v1"
  ],
  "residencyPolicy": {
    "schemaVersion": 1,
    "mode": "suspend-when-hidden"
  },
  "resourceRequest": {
    "memoryMb": 48,
    "updateHz": 10
  },
  "architectures": [
    "x64"
  ]
}
