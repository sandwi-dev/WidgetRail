<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\WidgetSdkRelease.props" />
  <PropertyGroup>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>$(WidgetSdkReleaseVersion)</Version>
    <PackageId>$(WidgetSdkPackageId)</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="WidgetSdkReleaseVersion" Value="$(WidgetSdkReleaseVersion)" />
    <AssemblyMetadata Include="WidgetSdkPackageId" Value="$(WidgetSdkPackageId)" />
    <AssemblyMetadata Include="ControllerWidgetTemplateVersion" Value="$(ControllerWidgetTemplateVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WidgetProtocol\WidgetProtocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\CommunityPlatformContractLimits.cs"
             Link="Internal\CommunityPlatformContractLimits.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="EmbeddedMediaAdapterRuntime.js"
          Pack="true"
          PackagePath="contentFiles/any/any/WidgetRail/EmbeddedMediaAdapterRuntime.js" />
  </ItemGroup>
</Project>
