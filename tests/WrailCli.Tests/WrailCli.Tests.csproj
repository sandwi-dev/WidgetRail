<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/OverlayFrontend.WinUI/DevelopmentJobEnrollment.cs" Link="DevelopmentJobEnrollment.cs" />
    <ProjectReference Include="..\\..\\tools\\WrailCli\\WrailCli.csproj" />
    <ProjectReference Include="..\\EmbeddedMediaAdapterConformance\\EmbeddedMediaAdapterConformance.csproj" />
  </ItemGroup>
  <Target Name="RemoveRetiredControllerWidgetTemplateOutput"
          AfterTargets="CopyFilesToOutputDirectory">
    <Delete Files="$(OutDir)templates\ControllerWidget\gbar.scenarios.json.template;
                   $(OutDir)templates\ControllerWidget\styles\default.gbss" />
  </Target>
</Project>
