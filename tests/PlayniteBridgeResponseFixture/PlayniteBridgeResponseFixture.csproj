<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PlayniteBridgeHttpSource)" Link="HttpApiServer.cs" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <Target Name="RequirePinnedBridgeSource" BeforeTargets="CoreCompile">
    <Error Condition="'$(PlayniteBridgeHttpSource)' == '' Or !Exists('$(PlayniteBridgeHttpSource)')"
           Text="Run scripts/Test-PlayniteBridgeResponse.ps1 with the prepared pinned Bridge source." />
  </Target>
</Project>
