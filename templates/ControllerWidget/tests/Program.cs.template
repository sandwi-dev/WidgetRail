using GameBarAlternative.WidgetProtocol;
using GameBarAlternative.WidgetSdk;
using {{Publisher}}.{{WidgetName}};

var output = Path.GetFullPath(args.Length == 0
    ? Path.Combine("fixtures", "ready.snapshot.json")
    : args[0]);
var widget = new {{WidgetName}}();
await WidgetTestHost.InitializeAsync(widget);
AssertText(widget.Render().CreateSnapshot("{{WidgetId}}.test", 1), "Paused · Level 2");

await WidgetTestHost.SetLifecycleStateAsync(widget, WidgetLifecycleState.Interactive);
AssertText(widget.Render().CreateSnapshot("{{WidgetId}}.test", 2), "Active · Level 2");
await widget.OnActionAsync(new WidgetActionEvent("raise", "raise"));
var ready = widget.Render().CreateSnapshot("{{WidgetId}}.test", 3);
AssertText(ready, "Active · Level 3");
if (ready.InitialFocusId != "apply")
    throw new InvalidOperationException("The generated focus contract changed.");

await WidgetTestHost.SetLifecycleStateAsync(widget, WidgetLifecycleState.Background);
AssertText(widget.Render().CreateSnapshot("{{WidgetId}}.test", 4), "Paused · Level 3");
await WidgetTestHost.SetLifecycleStateAsync(widget, WidgetLifecycleState.Interactive);
ready = widget.Render().CreateSnapshot("{{WidgetId}}.test", 5);
AssertText(ready, "Active · Level 3");

Directory.CreateDirectory(Path.GetDirectoryName(output)!);
await File.WriteAllBytesAsync(output, SnapshotJson.Serialize(ready));
Console.WriteLine($"PASS lifecycle, state, actions, and snapshot: {output}");
return 0;

static void AssertText(ViewSnapshot snapshot, string expected)
{
    if (!Nodes(snapshot.Root).Any(node => node.Text == expected))
        throw new InvalidOperationException($"Snapshot did not contain '{expected}'.");
}

static IEnumerable<ViewNode> Nodes(ViewNode node)
{
    yield return node;
    foreach (var child in node.Children)
    foreach (var descendant in Nodes(child))
        yield return descendant;
}
