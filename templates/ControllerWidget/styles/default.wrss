/* Inherit the selected theme; package tokens would override user colors. */

#title, .title {
  font-size: 28px;
  font-weight: 700;
}

#status, .status {
  color: var(--accent);
  font-size: 20px;
}

#actions {
  gap: 12px;
}

button:focused {
  outline-color: var(--accent);
  outline-width: 3px;
  scale: 1.04;
  transition-duration: 120ms;
}

.controller-help {
  color: var(--text-muted);
  font-size: 14px;
}
