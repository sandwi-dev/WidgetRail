:root {
  --surface: #1c1c24;
  --text-muted: #b7b7c4;
}

.title { font-size: 28px; font-weight: 700; }
.status { color: var(--accent); font-size: 20px; }
.media-pinned { gap: 12px; }
.media-pinned--compact { padding: 16px; }
.media-pinned--detailed { gap: 20px; padding: 20px; }
.media-queue { gap: 8px; }

button:focused {
  outline-color: var(--accent);
  outline-width: 3px;
  scale: 1.04;
  transition-duration: 120ms;
}

.controller-help { color: var(--text-muted); font-size: 14px; }
