<Project>
  <!--
    This is the canonical pre-release unit shared by WidgetSdk, wrail, and the
    ControllerWidget template. Change it intentionally with the public API
    baseline and compatibility evidence; it is not a post-1.0 promise.
  -->
  <PropertyGroup>
    <WidgetSdkReleaseVersion>0.3.0-dev</WidgetSdkReleaseVersion>
    <WidgetSdkPackageId>WidgetRail.WidgetSdk</WidgetSdkPackageId>
    <ControllerWidgetTemplateVersion>2</ControllerWidgetTemplateVersion>
  </PropertyGroup>
</Project>
