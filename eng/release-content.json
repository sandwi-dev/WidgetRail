{
  "schemaVersion": 2,
  "architecture": "x64",
  "rootFiles": [
    "OverlayFrontend.WinUI.exe",
    "OverlayFrontend.WinUI.dll",
    "OverlayFrontend.WinUI.runtimeconfig.json",
    "OverlayPlatformInterop.dll",
    "WinUiWindowPreviewNative.dll",
    "OverlayFrontend.WinUI.pri",
    "coreclr.dll",
    "Microsoft.ui.xaml.dll",
    "Microsoft.WindowsAppRuntime.dll"
  ],
  "hostRuntimeDirectories": [
    "Bridge",
    "WidgetWorkerHost",
    "Settings"
  ],
  "productionWidgets": [
    "media-sessions",
    "games-apps",
    "task-switcher",
    "audio-mixer",
    "network-controls",
    "power",
    "display-profiles",
    "browser",
    "game-help"
  ],
  "developerWidgets": [
    {
      "id": "browser",
      "project": "samples/BrowserWidget",
      "assembly": "BrowserWidget",
      "runtime": "Browser"
    },
    {
      "id": "game-help",
      "project": "samples/GameHelpWidget",
      "assembly": "GameHelpWidget",
      "runtime": "GameHelp"
    },
    {
      "id": "sdk-gallery",
      "project": "samples/SdkGalleryWidget",
      "assembly": "SdkGalleryWidget",
      "runtime": "SdkGallery"
    },
    {
      "id": "clock-sample",
      "project": "samples/ClockWidget",
      "assembly": "ClockWidget",
      "runtime": "Clock"
    },
    {
      "id": "full-application-reference",
      "project": "samples/FullApplicationWidget",
      "assembly": "FullApplicationWidget",
      "runtime": "FullApplication"
    }
  ],
  "developerExistingWidgets": [
    "embedded-media-sample"
  ],
  "runtimeRequirements": [
    {
      "name": ".NET",
      "version": "8.0.31",
      "scope": "managed hosts and framework-dependent widgets",
      "bundled": true
    },
    {
      "name": ".NET Desktop",
      "version": "8.0.31",
      "scope": "Windows Forms and WPF helpers, including Spotify local playback",
      "bundled": true
    },
    {
      "name": "Microsoft GameInput",
      "version": "3.5.262",
      "scope": "setup installs the signed redistributable if a compatible version is missing",
      "bundled": true
    },
    {
      "name": "Microsoft Edge WebView2",
      "version": "Evergreen runtime",
      "scope": "setup bootstrapper installs Evergreen per user if missing; download requires internet",
      "bundled": false,
      "bootstrapperBundled": true
    },
    {
      "scope": "self-contained application-local Windows App SDK runtime; no package registration",
      "name": "Microsoft Windows App SDK",
      "bundled": true,
      "version": "2.5.1"
    }
  ],
  "sharedRuntimeDirectories": [
    "dotnet",
    "prerequisites"
  ],
  "frontendDirectory": "frontend"
}
